- widget:
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,600"
    source: "list"
    transparent: "0"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (18, 0), size = (660, 60), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 0),
                            MultiContentEntryPixmapAlphaTest(pos = (1060, 10), size = (60, 60), png = 1),
                        ],
                        "fonts": [parseFont("md_body_large")],
                        "itemHeight": 60
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
