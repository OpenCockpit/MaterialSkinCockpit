screen:
  name: "tmdb2"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_large_width,$window_large_height"
        window_inset_x: "$window_large_body_x"
    - xmlinc:
        file: "screenpart_tmdb1Body.ymlinc"
        position: "54,107"
        width: "1660"
        height: "795"
    - xmlinc:
        file: "screenpart_tmdb2Body.ymlinc"
        position: "54,169"
        width: "1660"
        height: "733"
