screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoDiseqc"
  position: "fill"
  title: "Auto DiseqC"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/scan-s.png"
        position: "$window_large_margin,691"
        size: "96,96"
        zPosition: "2"
    - widget:
        font: "md_title_large"
        halign: "left"
        position: "159,691"
        render: "Label"
        shadowColor: "md_shadow"
        shadowOffset: "-1,-1"
        size: "1520,96"
        source: "statusbar"
        transparent: "1"
        valign: "center"
        zPosition: "10"
    - widget:
        font: "md_title_large"
        halign: "left"
        position: "159,776"
        render: "Label"
        shadowColor: "md_shadow"
        shadowOffset: "-1,-1"
        size: "1520,45"
        source: "tunerstatusbar"
        transparent: "1"
        valign: "center"
        zPosition: "10"
