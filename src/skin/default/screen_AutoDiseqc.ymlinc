screen:
  name: "AutoDiseqc"
  position: "fill"
  title: "Auto DiseqC"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_AutoDiseqcBody.ymlinc"
        position: "$window_large_body_x+20,$window_large_body_y+595"
        width: "$window_large_body_width-20"
        height: "$window_large_body_height-595"
