screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "InputBox"
  position: "fill"
  title: "Input"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_title_large"
        name: "text"
        position: "$window_medium_content_x,$window_medium_content_y"
        size: "1110,39"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/vkey_text.png"
        position: "173,197"
        size: "816,78"
        zPosition: "-1"
    - widget:
        font: "md_headline_medium"
        name: "input"
        position: "178,214"
        size: "806,45"
        valign: "center"
