- widget:
    iconMargin: "30"
    itemCornerRadius: "$radius_item"
    itemHeight: "90"
    name: "timerlist"
    position: "0,0"
    rowSplit: "45"
    satPosLeft: "250"
    scrollbarMode: "showNever"
    setEventNameFont: "md_title_large"
    setFont: "md_body_medium"
    setServiceNameFont: "md_body_medium"
    sidesMargin: "20"
    size: "$width,540"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "10,$height-25"
    size: "1630,25"
    connection: "timerlist"
- eLabel:
    backgroundColor: "md_surface_container_high"
    position: "0,560"
    size: "$width,2"
    zPosition: "-7"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    halign: "center"
    name: "text"
    position: "10,570"
    size: "1620,140"
    valign: "center"
