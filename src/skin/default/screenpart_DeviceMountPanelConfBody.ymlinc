- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,12*$list_item_height"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_small"
    foregroundColor: "md_on_surface"
    halign: "center"
    name: "Linconn"
    position: "4,$height-34"
    size: "1050,34"
    transparent: "1"
    valign: "center"
