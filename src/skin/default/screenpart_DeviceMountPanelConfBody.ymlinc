- widget:
    backgroundColor: "md_surface"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    size: "$width,eval(($height-72)/$list_item_height*$list_item_height)"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_small"
    foregroundColor: "md_on_surface"
    halign: "center"
    name: "Linconn"
    position: "0,$height-72"
    size: "$width,72"
    transparent: "1"
    valign: "center"
