screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AdapterSetupConfiguration"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menulist"
        position: "25,88"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,421"
        textOffset: "20,5"
        zPosition: "10"
    - widget:
        font: "md_body_large"
        halign: "center"
        position: "25,518"
        render: "Label"
        size: "$window_medium_content_width,140"
        source: "description"
        transparent: "1"
        valign: "center"
    - widget:
        font: "md_body_large"
        halign: "right"
        position: "521,694"
        render: "Label"
        size: "247,37"
        source: "IFtext"
        transparent: "1"
        valign: "center"
        zPosition: "10"
    - widget:
        font: "md_body_large"
        halign: "left"
        position: "779,694"
        render: "Label"
        size: "375,37"
        source: "IF"
        transparent: "1"
        valign: "center"
        zPosition: "10"
    - widget:
        font: "md_body_large"
        halign: "right"
        position: "25,694"
        render: "Label"
        size: "300,37"
        source: "Statustext"
        transparent: "1"
        valign: "center"
        zPosition: "10"
    - widget:
        alphatest: "blend"
        name: "statuspic"
        pixmaps: "icons/lock_on.png,icons/lock_off.png"
        position: "339,694"
        size: "52,37"
        transparent: "1"
        zPosition: "10"
