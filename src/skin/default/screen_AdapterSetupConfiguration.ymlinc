screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AdapterSetupConfiguration"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menulist"
        position: "395,206"
        scrollbarMode: "showNever"
        size: "1130,421"
        textOffset: "20,5"
        zPosition: "10"
    - widget:
        font: "md_body_large"
        halign: "center"
        position: "395,636"
        render: "Label"
        size: "1130,155"
        source: "description"
        transparent: "1"
        valign: "center"
    - widget:
        font: "md_body_large"
        halign: "right"
        position: "891,812"
        render: "Label"
        size: "247,37"
        source: "IFtext"
        transparent: "1"
        valign: "center"
        zPosition: "10"
    - widget:
        font: "md_body_large"
        halign: "left"
        position: "1149,812"
        render: "Label"
        size: "375,37"
        source: "IF"
        transparent: "1"
        valign: "center"
        zPosition: "10"
    - widget:
        font: "md_body_large"
        halign: "right"
        position: "395,812"
        render: "Label"
        size: "300,37"
        source: "Statustext"
        transparent: "1"
        valign: "center"
        zPosition: "10"
    - widget:
        alphatest: "blend"
        name: "statuspic"
        pixmaps: "icons/lock_on.png,icons/lock_off.png"
        position: "709,812"
        size: "52,37"
        transparent: "1"
        zPosition: "10"
