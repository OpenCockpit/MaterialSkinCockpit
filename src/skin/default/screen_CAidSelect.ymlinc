screen:
  backgroundColor: "md_transparent"
  name: "CAidSelect"
  position: "fill"
  title: "Select CAId's"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        font: "md_title_large"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "21,86"
        scrollbarMode: "showOnDemand"
        size: "$window_small_content_width,590"
    - widget:
        backgroundColor: "md_surface"
        font: "md_label_medium"
        halign: "center"
        position: "21,686"
        render: "Label"
        size: "$window_small_content_width,40"
        source: "introduction"
        valign: "center"
        zPosition: "10"
