screen:
  name: "ConfigScreenTemplate"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        conditional: "config"
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "config"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showNever"
        separatorLineColor: "md_outline_variant"
        size: "1670,13*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "config"
        connection: "config"
        position: "$window_large_margin,871"
        size: "$window_large_inner_width,25"
        transparent: "1"
    - widget:
        conditional: "list"
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showNever"
        size: "1670,13*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "list"
        connection: "list"
        position: "$window_large_margin,871"
        size: "$window_large_inner_width,25"
        transparent: "1"
    - widget:
        alphatest: "blend"
        conditional: "HelpWindow"
        name: "HelpWindow"
        pixmap: "icons/vkey_icon.png"
        position: "1824,96"
        size: "1,1"
        transparent: "1"
        zPosition: "1"
    - widget:
        font: "md_body_medium"
        halign: "center"
        name: "description"
        objectTypes: "description,Button,Label"
        position: "$window_large_margin,696"
        size: "$window_large_inner_width,132"
        valign: "center"
    - widget:
        font: "md_body_medium"
        halign: "center"
        objectTypes: "description,StaticText"
        position: "$window_large_margin,696"
        render: "Label"
        size: "$window_large_inner_width,132"
        source: "description"
        valign: "center"
    - widget:
        conditional: "introduction"
        name: "introduction"
        position: "0,0"
        size: "0,0"
    - widget:
        font: "md_body_medium"
        foregroundColor: "md_primary"
        halign: "center"
        name: "footnote"
        objectTypes: "footnote,Button,Label"
        position: "$window_large_margin,841"
        size: "$window_large_inner_width,30"
        valign: "center"
        zPosition: "5"
    - widget:
        font: "md_body_medium"
        foregroundColor: "md_primary"
        halign: "center"
        objectTypes: "footnote,StaticText"
        position: "$window_large_margin,841"
        render: "Label"
        size: "$window_large_inner_width,30"
        source: "footnote"
        valign: "center"
        zPosition: "1000"
