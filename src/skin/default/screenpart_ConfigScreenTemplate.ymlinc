screen:
  name: "ConfigScreenTemplate"
  children:
    - xmlinc:
        file: "screenpart_Screen_1_1.ymlinc"
        position: "96,54"
    - widget:
        conditional: "config"
        font: "$text_font"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "config"
        position: "125,150"
        scrollbarMode: "showNever"
        separatorLineColor: "md_outline_variant"
        size: "1670,13*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "config"
        connection: "config"
        position: "145,915"
        size: "1630,25"
        transparent: "1"
    - widget:
        conditional: "list"
        font: "$text_font"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "125,150"
        scrollbarMode: "showNever"
        size: "1670,13*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "list"
        connection: "list"
        position: "145,915"
        size: "1630,25"
        transparent: "1"
    - widget:
        alphatest: "blend"
        conditional: "HelpWindow"
        name: "HelpWindow"
        pixmap: "icons/vkey_icon.png"
        position: "e,150"
        size: "1,1"
        transparent: "1"
        zPosition: "1"
    - widget:
        font: "$text_font"
        halign: "center"
        name: "description"
        objectTypes: "description,Button,Label"
        position: "145,755"
        size: "1630,100"
        valign: "center"
    - widget:
        font: "$text_font"
        halign: "center"
        objectTypes: "description,StaticText"
        position: "145,755"
        render: "Label"
        size: "1630,100"
        source: "description"
        valign: "center"
    - widget:
        conditional: "introduction"
        name: "introduction"
        position: "0,0"
        size: "0,0"
    - widget:
        font: "$text_font"
        foregroundColor: "md_primary"
        halign: "center"
        name: "footnote"
        objectTypes: "footnote,Button,Label"
        position: "145,865"
        size: "1630,30"
        valign: "center"
        zPosition: "5"
    - widget:
        font: "$text_font"
        foregroundColor: "md_primary"
        halign: "center"
        objectTypes: "footnote,StaticText"
        position: "145,865"
        render: "Label"
        size: "1630,30"
        source: "footnote"
        valign: "center"
        zPosition: "1000"
