screen:
  name: "ConfigScreenTemplate"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_large_width,$window_large_height"
        window_inset_x: "$window_large_body_x"
    - xmlinc:
        file: "screenpart_ConfigScreenTemplateBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y"
        size: "$window_large_body_width,$window_large_body_height"
    - widget:
        alphatest: "blend"
        conditional: "HelpWindow"
        name: "HelpWindow"
        pixmap: "icons/vkey_icon.png"
        position: "1824,96"
        size: "1,1"
        transparent: "1"
        zPosition: "1"
