screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "BackupSelection"
  position: "fill"
  title: "Select files/folders to backup"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemHeight: "45"
        name: "checkList"
        position: "$window_medium_content_x,$window_medium_content_y"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,$window_medium_list_height"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "checkList"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
