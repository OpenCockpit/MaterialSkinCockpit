screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "LogManagerViewLog"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "console_font"
        name: "list"
        position: "$window_medium_content_x,$window_medium_content_y"
        size: "$window_medium_content_width,660"
