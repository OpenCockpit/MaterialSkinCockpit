screen:
  name: "VirtualKeyBoardTemplate"
  children:
    - widget:
        backgroundColor: "md_surface"
        font: "$list_font"
        name: "prompt"
        noWrap: "1"
        position: "4,0"
        size: "810,39"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "$heading_font"
        halign: "right"
        name: "text"
        noWrap: "1"
        position: "0,70"
        size: "968,48"
        valign: "center"
        widgetBorderColor: "md_outline_variant"
        widgetBorderWidth: "1"
    - eLabel:
        backgroundColor: "md_surface"
        position: "0,159"
        size: "968,342"
        widgetBorderColor: "md_outline_variant"
        widgetBorderWidth: "1"
        zPosition: "-5"
    - widget:
        name: "list"
        position: "1,160"
        selectionDisabled: "1"
        size: "968,340"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "$list_font"
        foregroundColor: "md_on_surface_variant"
        name: "locale"
        position: "4,540"
        size: "800,39"
    - widget:
        backgroundColor: "md_surface"
        font: "$list_font"
        halign: "right"
        name: "mode"
        position: "856,540"
        size: "100,39"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "$list_font"
        foregroundColor: "md_on_surface_variant"
        halign: "right"
        name: "language"
        position: "0,0"
        size: "0,0"
