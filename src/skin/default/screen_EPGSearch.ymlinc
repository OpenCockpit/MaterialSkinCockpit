screen:
  flags: "wfNoBorder"
  name: "EPGSearch"
  position: "fill"
  title: "EPG Search"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - xmlinc:
        file: "screenpart_Pig.ymlinc"
        position: "1531,95"
        size: "354,200"
    - widget:
        backgroundColor: "md_surface"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "24,91"
        scrollbarMode: "showNever"
        setColGap: "40"
        setColWidths: "120,220"
        setEventItemFont: "md_title_large"
        setEventTimeFont: "md_title_large"
        setIconDistance: "-5"
        setPboxDistance: "80"
        setPiconDistance: "0"
        setPiconSize: "50,30"
        sidesMargin: "10"
        size: "1120,890"
        transparent: "1"
    - widget:
        addon: "Pager"
        connection: "list"
        position: "24,960"
        size: "1120,25"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1170,100"
        size: "1,870"
        zPosition: "-5"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "left"
        position: "1195,351"
        render: "Label"
        size: "560,30"
        source: "Service"
        transparent: "1"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "TransponderInfo"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_small"
        foregroundColor: "md_secondary"
        halign: "right"
        position: "1725,350"
        render: "Label"
        size: "150,30"
        source: "Service"
        transparent: "1"
        zPosition: "1"
        children:
          - convert:
              type: "ServiceOrbitalPosition"
    - widget:
        font: "md_body_large"
        halign: "block"
        options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
        position: "1195,399"
        render: "COCRunningText"
        size: "680,560"
        source: "Event"
        transparent: "1"
        valign: "top"
        children:
          - convert:
              type: "EventName"
              text: "FullDescription"
    - widget:
        alphatest: "blend"
        position: "1215,140"
        render: "Picon"
        size: "220,132"
        source: "Service"
        zPosition: "12"
        children:
          - convert:
              type: "ServiceName"
              text: "Reference"
