screen:
  flags: "wfNoBorder"
  name: "EPGSearch"
  position: "fill"
  title: "EPG Search"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full_Pig.ymlinc"
        position: "5,5"
    - widget:
        backgroundColor: "md_surface"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "29,96"
        scrollbarMode: "showNever"
        setColGap: "40"
        setColWidths: "120,220"
        setEventItemFont: "$list_large_font"
        setEventTimeFont: "$list_large_font"
        setIconDistance: "-5"
        setPboxDistance: "80"
        setPiconDistance: "0"
        setPiconSize: "50,30"
        sidesMargin: "10"
        size: "1120,890"
        transparent: "1"
    - widget:
        addon: "Pager"
        connection: "list"
        position: "29,965"
        size: "1120,25"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1175,105"
        size: "1,870"
        zPosition: "-5"
    - widget:
        font: "$label_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        position: "1200,356"
        render: "Label"
        size: "560,30"
        source: "Service"
        transparent: "1"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "TransponderInfo"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "$label_font"
        foregroundColor: "md_secondary"
        halign: "right"
        position: "1730,355"
        render: "Label"
        size: "150,30"
        source: "Service"
        transparent: "1"
        zPosition: "1"
        children:
          - convert:
              type: "ServiceOrbitalPosition"
    - widget:
        font: "$list_font"
        halign: "block"
        options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
        position: "1200,404"
        render: "COCRunningText"
        size: "680,580"
        source: "Event"
        transparent: "1"
        valign: "top"
        children:
          - convert:
              type: "EventName"
              text: "FullDescription"
    - widget:
        alphatest: "blend"
        position: "1220,145"
        render: "Picon"
        size: "220,132"
        source: "Service"
        zPosition: "12"
        children:
          - convert:
              type: "ServiceName"
              text: "Reference"
