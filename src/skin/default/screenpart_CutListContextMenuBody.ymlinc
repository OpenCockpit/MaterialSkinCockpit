- widget:
    enableWrapAround: "1"
    font: "md_body_large"
    foregroundColor: "md_on_surface_variant"
    itemCornerRadius: "$radius_item"
    itemHeight: "60"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,600"
    source: "menu"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (60, 0), size = (809, 60), flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 0)
                        ],
                        "fonts": [parseFont("md_title_large")],
                        "itemHeight": 60
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "menu"
