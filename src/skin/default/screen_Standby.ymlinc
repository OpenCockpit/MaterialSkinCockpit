screen:
  flags: "wfNoBorder"
  name: "Standby"
  position: "fill"
  children:
    - eLabel:
        font: "md_display_small"
        position: "50,50"
        size: "400,100"
        text: "Tuners in Use:"
    - widget:
        font: "md_display_small"
        halign: "left"
        position: "450,50"
        render: "Label"
        size: "1000,100"
        source: "session.FrontendInfo"
        children:
          - convert:
              type: "FrontendInfo"
              text: "STRING,24,0"
    - eLabel:
        font: "md_display_small"
        position: "50,150"
        size: "400,100"
        text: "Current Time:"
    - widget:
        font: "md_display_small"
        halign: "left"
        position: "450,150"
        render: "Label"
        size: "512,100"
        source: "global.CurrentTime"
        children:
          - convert:
              type: "ClockToText"
              text: "Format:%F %H:%M"
    - eLabel:
        font: "md_display_small"
        position: "50,250"
        size: "400,100"
        text: "Streaming Info:"
    - widget:
        font: "md_display_small"
        halign: "left"
        noWrap: "1"
        position: "450,250"
        render: "Label"
        size: "1620,800"
        source: "session.CurrentService"
        valign: "top"
        children:
          - convert:
              type: "ClientsStreaming"
              text: "INFO_RESOLVE_SHORT"
