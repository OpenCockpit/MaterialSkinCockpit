- widget:
    enableWrapAround: "1"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "devicelist"
    position: "29,0"
    scrollbarMode: "showNever"
    size: "$width-29,11*$list_item_height"
    transparent: "1"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "29,516"
    size: "$width-29,25"
    connection: "devicelist"
- widget:
    alphatest: "blend"
    font: "md_label_medium"
    foregroundColor: "md_primary"
    halign: "center"
    name: "ConnStatus"
    position: "29,546"
    size: "$width-29,75"
    transparent: "1"
    valign: "center"
    zPosition: "1"
