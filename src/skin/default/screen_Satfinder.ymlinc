screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "Satfinder"
  position: "fill"
  title: "Satfinder"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - widget:
        borderColor: "md_outline"
        borderWidth: "1"
        pixmap: "infobar/bar_big.png"
        position: "25,130"
        render: "Progress"
        size: "1860,75"
        source: "Frontend"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNR"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        borderWidth: "1"
        font: "md_display_small"
        position: "32,130"
        size: "140,75"
        text: "SNR:"
        transparent: "1"
        valign: "center"
    - widget:
        borderWidth: "1"
        font: "md_display_small"
        halign: "right"
        position: "1547,130"
        render: "Label"
        size: "330,75"
        source: "Frontend"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNR"
    - widget:
        borderColor: "md_outline"
        borderWidth: "1"
        pixmap: "infobar/bar_big.png"
        position: "25,225"
        render: "Progress"
        size: "1860,75"
        source: "Frontend"
        children:
          - convert:
              type: "FrontendInfo"
              text: "AGC"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        borderWidth: "1"
        font: "md_display_small"
        position: "32,225"
        size: "150,75"
        text: "AGC:"
        transparent: "1"
        valign: "center"
    - widget:
        borderWidth: "1"
        font: "md_display_small"
        halign: "right"
        position: "1547,225"
        render: "Label"
        size: "330,75"
        source: "Frontend"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "FrontendInfo"
              text: "AGC"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        font: "md_body_small"
        position: "25,353"
        size: "180,34"
        text: "SNR:"
        transparent: "1"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_display_large"
        halign: "left"
        position: "25,385"
        render: "Label"
        size: "450,131"
        source: "Frontend"
        transparent: "1"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNRdB"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        font: "md_body_small"
        position: "25,533"
        size: "180,34"
        text: "AGC:"
        transparent: "1"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_display_large"
        halign: "left"
        position: "25,565"
        render: "Label"
        size: "450,131"
        source: "Frontend"
        transparent: "1"
        children:
          - convert:
              type: "FrontendInfo"
              text: "AGC"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        font: "md_body_small"
        position: "25,713"
        size: "180,34"
        text: "BER:"
        transparent: "1"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_display_large"
        halign: "left"
        position: "25,745"
        render: "Label"
        size: "450,131"
        source: "Frontend"
        transparent: "1"
        children:
          - convert:
              type: "FrontendInfo"
              text: "BER"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_display_large"
        foregroundColor: "md_success"
        halign: "left"
        position: "25,875"
        render: "FixedLabel"
        size: "465,135"
        source: "Frontend"
        text: "LOCK"
        transparent: "1"
        children:
          - convert:
              type: "FrontendInfo"
              text: "LOCK"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        enableWrapAround: "1"
        font: "md_headline_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "49"
        name: "config"
        position: "445,355"
        scrollbarMode: "showOnDemand"
        size: "1440,643"
        transparent: "1"
    - widget:
        name: "introduction"
        position: "0,0"
        size: "0,0"
        zPosition: "0"
    - widget:
        conditional: "pos"
        font: "md_headline_medium"
        halign: "right"
        position: "445,924"
        render: "FixedLabel"
        size: "180,50"
        source: "pos"
        text: "Orb Pos:"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface_container_highest"
        conditional: "pos"
        font: "md_headline_medium"
        foregroundColor: "md_primary"
        halign: "center"
        position: "635,924"
        render: "Label"
        size: "150,50"
        source: "pos"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        conditional: "onid"
        font: "md_headline_medium"
        halign: "right"
        position: "875,924"
        render: "FixedLabel"
        size: "180,50"
        source: "onid"
        text: "ONID:"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface_container_highest"
        conditional: "onid"
        font: "md_headline_medium"
        foregroundColor: "md_primary"
        halign: "center"
        position: "1060,924"
        render: "Label"
        size: "150,50"
        source: "onid"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        conditional: "tsid"
        font: "md_headline_medium"
        halign: "right"
        position: "1310,924"
        render: "FixedLabel"
        size: "180,50"
        source: "tsid"
        text: "TSID:"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface_container_highest"
        conditional: "tsid"
        font: "md_headline_medium"
        foregroundColor: "md_primary"
        halign: "center"
        position: "1515,924"
        render: "Label"
        size: "150,50"
        source: "tsid"
        children:
          - convert:
              type: "ConditionalShowHide"
