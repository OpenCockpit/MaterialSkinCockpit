screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "Satfinder"
  position: "fill"
  title: "Satfinder"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full.ymlinc"
        position: "5,5"
    - widget:
        borderColor: "md_outline"
        borderWidth: "1"
        pixmap: "infobar/bar_big.png"
        position: "30,135"
        render: "Progress"
        size: "1860,75"
        source: "Frontend"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNR"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        borderWidth: "1"
        font: "$xlarge_font"
        position: "37,135"
        size: "140,75"
        text: "SNR:"
        transparent: "1"
        valign: "center"
    - widget:
        borderWidth: "1"
        font: "$xlarge_font"
        halign: "right"
        position: "1552,135"
        render: "Label"
        size: "330,75"
        source: "Frontend"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNR"
    - widget:
        borderColor: "md_outline"
        borderWidth: "1"
        pixmap: "infobar/bar_big.png"
        position: "30,230"
        render: "Progress"
        size: "1860,75"
        source: "Frontend"
        children:
          - convert:
              type: "FrontendInfo"
              text: "AGC"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        borderWidth: "1"
        font: "$xlarge_font"
        position: "37,230"
        size: "150,75"
        text: "AGC:"
        transparent: "1"
        valign: "center"
    - widget:
        borderWidth: "1"
        font: "$xlarge_font"
        halign: "right"
        position: "1552,230"
        render: "Label"
        size: "330,75"
        source: "Frontend"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "FrontendInfo"
              text: "AGC"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        font: "$label_font"
        position: "30,360"
        size: "180,30"
        text: "SNR:"
        transparent: "1"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "$giant_font"
        halign: "left"
        position: "30,390"
        render: "Label"
        size: "450,112"
        source: "Frontend"
        transparent: "1"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNRdB"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        font: "$label_font"
        position: "30,540"
        size: "180,30"
        text: "AGC:"
        transparent: "1"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "$giant_font"
        halign: "left"
        position: "30,570"
        render: "Label"
        size: "450,112"
        source: "Frontend"
        transparent: "1"
        children:
          - convert:
              type: "FrontendInfo"
              text: "AGC"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        font: "$label_font"
        position: "30,720"
        size: "180,30"
        text: "BER:"
        transparent: "1"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "$giant_font"
        halign: "left"
        position: "30,750"
        render: "Label"
        size: "450,112"
        source: "Frontend"
        transparent: "1"
        children:
          - convert:
              type: "FrontendInfo"
              text: "BER"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "$giant_font"
        foregroundColor: "md_success"
        halign: "left"
        position: "30,880"
        render: "FixedLabel"
        size: "465,135"
        source: "Frontend"
        text: "LOCK"
        transparent: "1"
        children:
          - convert:
              type: "FrontendInfo"
              text: "LOCK"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        enableWrapAround: "1"
        font: "$heading_font"
        itemCornerRadius: "$radius_item"
        itemHeight: "49"
        name: "config"
        position: "450,360"
        scrollbarMode: "showOnDemand"
        size: "1440,643"
        transparent: "1"
    - widget:
        name: "introduction"
        position: "0,0"
        size: "0,0"
        zPosition: "0"
    - widget:
        conditional: "pos"
        font: "$heading_font"
        halign: "right"
        position: "450,930"
        render: "FixedLabel"
        size: "180,45"
        source: "pos"
        text: "Orb Pos:"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface_container_highest"
        conditional: "pos"
        font: "$heading_font"
        foregroundColor: "md_primary"
        halign: "center"
        position: "640,930"
        render: "Label"
        size: "150,45"
        source: "pos"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        conditional: "onid"
        font: "$heading_font"
        halign: "right"
        position: "880,930"
        render: "FixedLabel"
        size: "180,45"
        source: "onid"
        text: "ONID:"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface_container_highest"
        conditional: "onid"
        font: "$heading_font"
        foregroundColor: "md_primary"
        halign: "center"
        position: "1065,930"
        render: "Label"
        size: "150,45"
        source: "onid"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        conditional: "tsid"
        font: "$heading_font"
        halign: "right"
        position: "1315,930"
        render: "FixedLabel"
        size: "180,45"
        source: "tsid"
        text: "TSID:"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface_container_highest"
        conditional: "tsid"
        font: "$heading_font"
        foregroundColor: "md_primary"
        halign: "center"
        position: "1520,930"
        render: "Label"
        size: "150,45"
        source: "tsid"
        children:
          - convert:
              type: "ConditionalShowHide"
