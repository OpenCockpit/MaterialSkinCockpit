- widget:
    conditional: "config"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    separatorLineColor: "md_outline_variant"
    size: "$width,13*$list_item_height"
    valign: "center"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "20,$height-25"
    size: "1630,25"
    connection: "config"
- widget:
    conditional: "list"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "list"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,13*$list_item_height"
    valign: "center"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "20,$height-25"
    size: "1630,25"
    connection: "list"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    name: "description"
    objectTypes: "description,Button,Label"
    position: "20,600"
    size: "1630,132"
    valign: "center"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    objectTypes: "description,StaticText"
    position: "20,600"
    render: "Label"
    size: "1630,132"
    source: "description"
    valign: "center"
- widget:
    conditional: "introduction"
    name: "introduction"
    position: "0,0"
    size: "0,0"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    name: "footnote"
    objectTypes: "footnote,Button,Label"
    position: "20,740"
    size: "1630,34"
    valign: "center"
    zPosition: "5"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    objectTypes: "footnote,StaticText"
    position: "20,740"
    render: "Label"
    size: "1630,34"
    source: "footnote"
    valign: "center"
    zPosition: "1000"
