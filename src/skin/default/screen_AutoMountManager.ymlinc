screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoMountManager"
  position: "fill"
  title: "MountManager"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        itemCornerRadius: "$radius_item"
        position: "35,87"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1110,6*90"
        source: "config"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (90, 7), size = (870, 42), font=0, flags = RT_HALIGN_LEFT, text = 0), # index 2 is the Menu Titel
                                                                                                            MultiContentEntryText(pos = (90, 52), size = (870, 30), font=1, flags = RT_HALIGN_LEFT, text = 2), # index 3 is the Description
                                                                                                            MultiContentEntryPixmapAlphaBlend(pos = (15, 15), size = (72, 72), png = 3), # index 4 is the pixmap
                            ],
                            "fonts": [parseFont("md_title_large"), parseFont("md_body_small")],
                            "itemHeight": 90
                        }
    - widget:
        font: "md_body_large"
        halign: "center"
        position: "35,660"
        render: "Label"
        size: "1110,38"
        source: "introduction"
        transparent: "1"
        valign: "center"
        zPosition: "10"
