screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CronTimers"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "key"
        position: "$window_medium_content_x,$window_medium_content_y"
        size: "$window_medium_content_width,38"
        transparent: "1"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_medium"
        halign: "center"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        position: "26,137"
        render: "Listbox"
        scrollbarMode: "showNever"
        selectionDisabled: "0"
        size: "1130,9*45"
        source: "list"
        children:
          - convert:
              type: "StringList"
    - widget:
        font: "md_body_medium"
        name: "lab1"
        position: "26,582"
        size: "275,42"
        valign: "center"
    - widget:
        backgroundColor: "md_key_red"
        font: "md_body_medium"
        halign: "center"
        name: "labdisabled"
        position: "305,582"
        size: "150,42"
        valign: "center"
    - widget:
        backgroundColor: "md_key_green"
        font: "md_body_medium"
        halign: "center"
        name: "labactive"
        position: "305,582"
        size: "150,42"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "md_body_medium"
        name: "lab2"
        position: "26,632"
        size: "275,42"
        valign: "center"
    - widget:
        backgroundColor: "md_key_red"
        font: "md_body_medium"
        halign: "center"
        name: "labstop"
        position: "305,632"
        size: "150,42"
        valign: "center"
    - widget:
        backgroundColor: "md_key_green"
        font: "md_body_medium"
        halign: "center"
        name: "labrun"
        position: "305,632"
        size: "150,42"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "md_body_medium"
        foregroundColor: "md_on_surface_variant"
        name: "footnote"
        position: "26,733"
        size: "$window_medium_content_width,36"
        valign: "center"
