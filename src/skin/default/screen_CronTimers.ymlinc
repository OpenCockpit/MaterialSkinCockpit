screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CronTimers"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        font: "$list_font"
        halign: "center"
        name: "key"
        position: "396,210"
        size: "1130,35"
        transparent: "1"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "$text_font"
        halign: "center"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        position: "396,255"
        render: "Listbox"
        scrollbarMode: "showNever"
        selectionDisabled: "0"
        size: "1130,9*45"
        source: "list"
        children:
          - convert:
              type: "StringList"
    - widget:
        font: "$text_font"
        name: "lab1"
        position: "396,700"
        size: "275,42"
        valign: "center"
    - widget:
        backgroundColor: "md_key_red"
        font: "$text_font"
        halign: "center"
        name: "labdisabled"
        position: "675,700"
        size: "150,42"
        valign: "center"
    - widget:
        backgroundColor: "md_key_green"
        font: "$text_font"
        halign: "center"
        name: "labactive"
        position: "675,700"
        size: "150,42"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$text_font"
        name: "lab2"
        position: "396,750"
        size: "275,42"
        valign: "center"
    - widget:
        backgroundColor: "md_key_red"
        font: "$text_font"
        halign: "center"
        name: "labstop"
        position: "675,750"
        size: "150,42"
        valign: "center"
    - widget:
        backgroundColor: "md_key_green"
        font: "$text_font"
        halign: "center"
        name: "labrun"
        position: "675,750"
        size: "150,42"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$text_font"
        foregroundColor: "md_on_surface_variant"
        name: "footnote"
        position: "396,853"
        size: "1130,32"
        valign: "center"
