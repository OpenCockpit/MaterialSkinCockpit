        source: "HDDHeader"
        transparent: "0"
        zPosition: "1"
    - widget:
        font: "$text_font"
        noWrap: "1"
        position: "125,537"
        render: "Label"
        size: "1696,300"
        source: "hdd"
        transparent: "0"
        zPosition: "1"
    - widget:
        font: "$event_font"
        position: "125,723"
        render: "Label"
        size: "1696,38"
        source: "MountsHeader"
        transparent: "0"
