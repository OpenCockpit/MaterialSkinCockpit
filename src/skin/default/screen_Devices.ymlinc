screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "Devices"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        font: "md_title_medium_emphasized"
        position: "$window_large_content_x,$window_large_content_y"
        render: "Label"
        size: "1696,38"
        source: "TunerHeader"
        transparent: "0"
        zPosition: "1"
    - widget:
        font: "md_body_medium"
        noWrap: "1"
        position: "29,136"
        render: "Label"
        size: "1696,300"
        source: "nims"
        transparent: "0"
        zPosition: "1"
    - widget:
        font: "md_title_medium_emphasized"
        position: "29,444"
        render: "Label"
        size: "1696,38"
        source: "HDDHeader"
        transparent: "0"
        zPosition: "1"
    - widget:
        font: "md_body_medium"
        noWrap: "1"
        position: "29,483"
        render: "Label"
        size: "1696,300"
        source: "hdd"
        transparent: "0"
        zPosition: "1"
    - widget:
        font: "md_title_medium_emphasized"
        position: "29,669"
        render: "Label"
        size: "1696,38"
        source: "MountsHeader"
        transparent: "0"
        zPosition: "1"
    - widget:
        font: "md_body_medium"
        noWrap: "1"
        position: "29,708"
        render: "Label"
        size: "1696,195"
        source: "mounts"
        transparent: "0"
        zPosition: "1"
