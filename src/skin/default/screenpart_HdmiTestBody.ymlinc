- widget:
    font: "md_title_large"
    foregroundColor: "md_on_surface"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,7*$list_item_height"
    zPosition: "1"
- widget:
    font: "md_body_large"
    foregroundColor: "md_tertiary"
    name: "address"
    position: "0,535"
    size: "465,38"
    zPosition: "1"
- widget:
    font: "md_body_large"
    foregroundColor: "md_tertiary"
    name: "sendto"
    position: "420,535"
    size: "465,38"
    zPosition: "1"
- eLabel:
    backgroundColor: "md_surface_container_high"
    position: "0,577"
    size: "1050,3"
- widget:
    font: "md_body_small"
    foregroundColor: "md_success"
    halign: "left"
    name: "ltx"
    position: "0,583"
    size: "60,34"
    zPosition: "1"
- widget:
    font: "md_body_small"
    halign: "left"
    name: "txtext"
    position: "60,585"
    size: "330,180"
    zPosition: "1"
- widget:
    font: "md_body_small"
    foregroundColor: "md_error"
    halign: "left"
    name: "lrx"
    position: "420,583"
    size: "60,34"
    zPosition: "1"
- widget:
    font: "md_body_small"
    halign: "left"
    name: "rxtext"
    position: "480,585"
    size: "480,180"
    zPosition: "1"
