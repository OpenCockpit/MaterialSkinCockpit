- widget:
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,eval(($height-25)/$list_item_height*$list_item_height)"
    source: "languages"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (120, 0), size = (300, $list_item_height), flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 1), # index 1 is the language name,
                            MultiContentEntryPixmap(pos = (20, 2), size = (60, 40), png = 2), # index 2 is the pixmap
                        ],
                        "fonts": [parseFont("md_body_medium")],
                        "itemHeight": $list_item_height
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "languages"
