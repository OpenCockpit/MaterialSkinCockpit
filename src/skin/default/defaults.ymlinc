# What the widgets of the skin have in common without every screen saying it. A widget that sets an attribute itself keeps its own value.
#
# A list (a widget with an itemCornerRadius): no scrollbar (the pager shows where the list is), the text of a row at the indent of
# the skin and in the middle of the row. textOffset and valign are only read by the lists of strings: a list drawn by a template
# ignores both.

# A screen: no border, and transparent. Its surface is the window frame it includes (rounded, so what is under the corners and around a
# smaller window shows). A screen that draws its own surface, or has to hide what is under it, says backgroundColor itself. Only a screen
# that has a name: the screen entries of screens.ymlinc (key and image, the icon of a screen) are no screens, enigma2 reads nothing else of them.
- default:
    tag: "screen[name]"
    flags: "wfNoBorder"
    resolution: "1920,1080"
    backgroundColor: "md_transparent"

- default:
    tag: "widget[itemCornerRadius]"
    scrollbarMode: "showNever"
    textOffset: "$list_indent,0"
    valign: "center"

# The font of every line of a list of timers (the timers, the power timers, the AutoTimers): one size, so no line is smaller than another.
- global:
    name: "timer_list_font"
    value: "md_body_large"

# A list of timers (TimerList, PowerTimerList: the widgets with a satPosLeft): two lines a row, all in the one font of timer_list_font. The screens set only what is theirs (the size, satPosLeft).
- default:
    tag: "widget[satPosLeft]"
    iconMargin: "30"
    itemHeight: "$list_item_height_double"
    rowSplit: "45"
    setEventNameFont: "$timer_list_font"
    setFont: "$timer_list_font"
    setServiceNameFont: "$timer_list_font"
    sidesMargin: "$list_indent"

# A picon is drawn with its transparency.
- default:
    tag: "widget[render=Picon]"
    alphatest: "blend"
