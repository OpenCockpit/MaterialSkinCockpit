- widget:
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,eval(($height-97)/$list_item_height*$list_item_height)"
    source: "list"
    transparent: "1"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (20, 0), size = (eval($width-40), $list_item_height), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 1), # index 1 is the interfacename
                        ],
                        "fonts": [parseFont("md_body_medium")],
                        "itemHeight": $list_item_height
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    position: "0,$height-97"
    render: "Label"
    size: "$width,72"
    source: "introduction"
    valign: "center"
    zPosition: "10"
