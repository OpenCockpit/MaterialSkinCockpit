screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "DVDPlayer"
  position: "150,67"
  size: "1620,352"
  title: "InfoBar"
  children:
    - xmlinc:
        file: "screenpart_PlayerTemplate.ymlinc"
        position: "38,860"
    - widget:
        backgroundColor: "md_transparent"
        borderColor: "md_shadow"
        borderWidth: "2"
        font: "$list_font"
        halign: "left"
        name: "chapterLabel"
        noWrap: "1"
        position: "270,150"
        size: "570,52"
        valign: "center"
        zPosition: "3"
    - eLabel:
        backgroundColor: "md_surface_overlay_soft"
        borderColor: "md_shadow"
        borderWidth: "2"
        font: "$list_font"
        halign: "left"
        position: "270,202"
        size: "135,52"
        text: "Audio: "
        transparent: "1"
        valign: "center"
    - widget:
        backgroundColor: "md_transparent"
        borderColor: "md_shadow"
        borderWidth: "2"
        font: "$list_font"
        halign: "left"
        name: "audioLabel"
        noWrap: "1"
        position: "405,202"
        size: "435,52"
        valign: "center"
        zPosition: "3"
    - eLabel:
        backgroundColor: "md_surface_overlay_soft"
        borderColor: "md_shadow"
        borderWidth: "2"
        font: "$list_font"
        halign: "left"
        position: "270,255"
        size: "135,52"
        text: "Subtitle: "
        transparent: "1"
        valign: "center"
    - widget:
        backgroundColor: "md_transparent"
        borderColor: "md_shadow"
        borderWidth: "2"
        font: "$list_font"
        halign: "left"
        name: "subtitleLabel"
        noWrap: "1"
        position: "405,255"
        size: "435,52"
        valign: "center"
        zPosition: "3"
    - widget:
        alphatest: "on"
        name: "anglePix"
        position: "960,192"
        size: "39,24"
        zPosition: "3"
    - widget:
        backgroundColor: "md_shadow"
        font: "$list_font"
        name: "angleLabel"
        position: "1020,183"
        size: "300,33"
        transparent: "1"
        zPosition: "3"
