- widget:
    font: "md_title_large"
    foregroundColor: "md_primary"
    name: "searchinfo"
    position: "0,1"
    size: "830,42"
    transparent: "1"
- widget:
    conditional: "list"
    itemCornerRadius: "$radius_item"
    itemHeight: "45"
    name: "list"
    position: "0,62"
    scrollbarMode: "showNever"
    size: "830,315"
    transparent: "1"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "list"
    position: "0,392"
    size: "830,25"
- widget:
    conditional: "data"
    font: "md_title_large"
    name: "data"
    position: "0,479"
    scrollbarMode: "showNever"
    size: "830,246"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "data"
    position: "0,749"
    size: "830,25"
- eLabel:
    backgroundColor: "md_surface"
    cornerRadius: "$radius_panel"
    position: "$width-342,0"
    size: "324,484"
    widgetBorderColor: "md_outline_variant"
    widgetBorderWidth: "1"
- widget:
    alphatest: "blend"
    cornerRadius: "$radius_panel"
    name: "cover"
    position: "$width-340,2"
    size: "320,480"
    zPosition: "100"
