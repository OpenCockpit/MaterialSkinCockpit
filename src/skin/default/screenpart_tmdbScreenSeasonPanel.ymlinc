- widget:
    font: "$list_large_font"
    foregroundColor: "md_primary"
    name: "searchinfo"
    position: "30,123"
    size: "830,40"
    transparent: "1"
- widget:
    conditional: "list"
    itemCornerRadius: "$radius_item"
    itemHeight: "45"
    name: "list"
    position: "30,183"
    scrollbarMode: "showNever"
    size: "830,315"
    transparent: "1"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "list"
    position: "30,513"
    size: "830,25"
- widget:
    conditional: "data"
    font: "$list_large_font"
    name: "data"
    position: "30,600"
    scrollbarMode: "showNever"
    size: "830,255"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "data"
    position: "30,870"
    size: "830,25"
- eLabel:
    backgroundColor: "md_surface"
    cornerRadius: "$radius_panel"
    position: "$width-342,121"
    size: "324,484"
    widgetBorderColor: "md_outline_variant"
    widgetBorderWidth: "1"
- widget:
    alphatest: "blend"
    cornerRadius: "$radius_panel"
    name: "cover"
    position: "$width-340,123"
    size: "320,480"
    zPosition: "100"
