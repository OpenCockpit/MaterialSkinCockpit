screen:
  flags: "wfNoBorder"
  name: "MovieSelection"
  position: "fill"
  title: "Movie Selection"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full_Big_Pig.ymlinc"
        position: "5,5"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_panel"
        position: "25,378"
        size: "1866,607"
        widgetBorderColor: "md_outline_variant"
        widgetBorderWidth: "1"
        zPosition: "-2"
    - widget:
        conditional: "waitingtext"
        font: "$subtitle_font"
        halign: "center"
        name: "waitingtext"
        position: "35,429"
        size: "1845,508"
        valign: "center"
        zPosition: "1"
    - widget:
        columnsCompactDescription: "280,240,200"
        columnsOriginal: "270,300"
        compactColumn: "400"
        dateWidth: "260"
        dirShift: "10"
        font: "$list_font"
        fontSizesCompact: "36,28"
        fontSizesMinimal: "34,30"
        fontSizesOriginal: "36,26,24"
        iconsWidth: "33"
        itemCornerRadius: "$radius_item"
        itemHeight: "55"
        itemHeights: "107,78,50"
        name: "list"
        partIconeShiftCompact: "8"
        partIconeShiftMinimal: "12"
        partIconeShiftOriginal: "12"
        pbarHeight: "20"
        pbarLargeWidth: "72"
        pbarShift: "17"
        position: "35,429"
        scrollbarMode: "showNever"
        size: "1845,508"
        spaceIconeText: "6"
        spaceLeft: "10"
        spaceRight: "25"
        transparent: "1"
        trashShift: "10"
        treeDescription: "250"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        maxPages: "15"
        position: "30,950"
        size: "1855,25"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "$list_font"
        halign: "left"
        options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
        position: "30,167"
        render: "COCRunningText"
        size: "1385,175"
        source: "Service"
        transparent: "1"
        valign: "top"
        children:
          - convert:
              type: "EventName"
              text: "FullDescription"
    - widget:
        alphatest: "blend"
        name: "movie_sort"
        pixmaps: "icons/az.png,icons/newtop.png,icons/shuffle.png,icons/za.png,icons/oldtop.png,icons/faz.png,icons/fza.png,icons/default.png,icons/azold.png,icons/za.png,icons/longest.png,icons/shortest.png,icons/dtsrt.png,icons/dtsdt.png"
        position: "40,387"
        size: "42,30"
        zPosition: "1"
    - widget:
        alphatest: "blend"
        name: "movie_off"
        pixmaps: "icons/ask.png,icons/movielist.png,icons/quit.png,icons/pause.png,icons/playlist.png,icons/playlistquit.png,icons/loop.png,icons/rep.png"
        position: "85,387"
        size: "52,30"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "$text_font"
        foregroundColor: "md_primary"
        halign: "left"
        position: "142,379"
        render: "Label"
        size: "1200,40"
        source: "Service"
        valign: "center"
        children:
          - convert:
              nostrip: "1"
              type: "MovieInfo"
              text: "  •  ,RECSERVICE,TIMECREATED,DURATION,FILESIZE"
    - widget:
        backgroundColor: "md_surface"
        font: "$subtitle_font"
        foregroundColor: "md_primary"
        halign: "left"
        position: "30,97"
        render: "Label"
        size: "1385,40"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "25,940"
        size: "1866,1"
        text: ""
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "25,420"
        size: "1866,1"
        text: ""
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/hddfree.png"
        position: "1846,387"
        scale: "1"
        size: "24,24"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "$label_font"
        halign: "right"
        name: "freeDiskSpace"
        position: "1311,383"
        size: "525,30"
        valign: "center"
        zPosition: "1"
