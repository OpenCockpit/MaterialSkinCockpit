screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MSNWeatherPluginSearch"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        conditional: "entrylist"
        font: "md_body_medium"
        itemHeight: "45"
        name: "entrylist"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showNever"
        size: "1670,13*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "entrylist"
        connection: "entrylist"
        position: "$window_large_margin,861"
        size: "$window_large_inner_width,25"
        transparent: "1"
