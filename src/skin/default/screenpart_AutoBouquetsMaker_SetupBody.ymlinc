- widget:
    font: "md_body_medium"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,10*$list_item_height"
    valign: "center"
- widget:
    font: "md_body_medium"
    halign: "center"
    name: "pleasewait"
    position: "0,0"
    size: "$width,450"
    transparent: "0"
    valign: "center"
    zPosition: "5"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "config"
- widget:
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "center"
    name: "description"
    position: "0,490"
    size: "$width,140"
    valign: "top"
