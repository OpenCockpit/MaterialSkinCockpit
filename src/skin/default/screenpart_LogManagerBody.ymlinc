- widget:
    enableWrapAround: "1"
    font: "md_body_large"
    itemCornerRadius: "$radius_item"
    name: "list"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,$height-56"
    transparent: "0"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
