screen:
  name: "SortbyChoiceBox"
  position: "fill"
  title: ""
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_small_width,$window_small_height"
        window_inset_x: "$window_small_body_x"
    - xmlinc:
        file: "screenpart_ChoiceBoxBody.ymlinc"
        position: "$window_small_body_x,$window_small_body_y"
        size: "$window_small_body_width,$window_small_body_height"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/default.png"
        position: "1838,108"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/newtop.png"
        position: "1838,146"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
