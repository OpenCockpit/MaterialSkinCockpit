screen:
  name: "RcPanel"
  children:
    - widget:
        alphatest: "blend"
        backgroundColor: "md_shadow"
        name: "rc"
        pixmap: "rc.png"
        position: "0,0"
        size: "154,500"
        transparent: "1"
        zPosition: "10"
    - widget:
        alphatest: "blend"
        conditional: "arrowdown"
        name: "arrowdown"
        pixmap: "arrowdown.png"
        position: "-100,-100"
        size: "37,70"
        zPosition: "11"
