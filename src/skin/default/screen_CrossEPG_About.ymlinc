screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CrossEPG_About"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_medium"
        name: "about"
        position: "$window_medium_content_x,$window_medium_content_y"
        size: "$window_medium_content_width,660"
