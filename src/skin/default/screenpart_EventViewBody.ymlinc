- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "left"
    name: "epg_eventname"
    position: "0,0"
    size: "$width-200,70"
    valign: "top"
- widget:
    alphatest: "blend"
    borderColor: "md_shadow"
    borderWidth: "1"
    cornerRadius: "$radius_rating_large"
    extendDirection: "left"
    font: "md_display_medium_emphasized"
    halign: "center"
    position: "$width-96,0"
    render: "RatingIconLabel"
    size: "96,96"
    source: "Event"
    valign: "center"
    widgetBorderColor: "md_outline_variant"
    widgetBorderWidth: "2"
    zPosition: "1"
    children:
      - convert:
          type: "EventName"
          text: "RatingTextAndColor"
- widget:
    backgroundColor: "md_surface"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_on_surface"
    halign: "left"
    name: "channel"
    position: "0,47"
    size: "$width-590,50"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_small_emphasized"
    halign: "left"
    name: "datetime"
    position: "0,$height-40"
    size: "340,40"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_small_emphasized"
    foregroundColor: "md_secondary"
    halign: "left"
    name: "duration"
    position: "340,$height-40"
    size: "340,40"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    foregroundColor: "md_tertiary"
    halign: "left"
    position: "685,$height-45"
    render: "Label"
    size: "670,45"
    source: "Event"
    zPosition: "1"
    children:
      - convert:
          type: "EventName"
          text: "Genre"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    halign: "block"
    name: "FullDescription"
    position: "0,116"
    scrollbarMode: "showNever"
    size: "$width,$height-339"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-198"
    size: "$width,25"
    connection: "FullDescription"
- widget:
    alphatest: "blend"
    backgroundColor: "md_surface"
    position: "$width-275,$height-170"
    render: "Picon"
    size: "220,132"
    source: "Service"
    transparent: "1"
    zPosition: "1"
    children:
      - convert:
          type: "ServiceName"
          text: "Reference"
