- eLabel:
    backgroundColor: "md_outline_variant"
    position: "1090,0"
    size: "1,876"
    zPosition: "-5"
- widget:
    font: "md_title_large"
    foregroundColor: "md_secondary"
    name: "headertext"
    position: "0,19"
    size: "1070,43"
    transparent: "1"
    zPosition: "1"
- widget:
    font: "md_body_large"
    halign: "center"
    name: "statustext"
    position: "0,400"
    size: "1070,135"
    transparent: "0"
    valign: "center"
    zPosition: "1"
- widget:
    enableWrapAround: "1"
    foregroundColor: "md_on_surface_variant"
    itemCornerRadius: "$radius_item"
    name: "list"
    position: "0,100"
    scrollbarMode: "showOnDemand"
    scrollbarSliderBorderColor: "md_primary"
    scrollbarSliderBorderWidth: "1"
    scrollbarSliderForegroundColor: "md_primary"
    scrollbarWidth: "5"
    size: "1070,726"
    zPosition: "2"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "list"
    maxPages: "15"
    position: "0,$height-25"
    size: "1070,25"
    zPosition: "3"
- widget:
    alphatest: "on"
    halign: "left"
    name: "cover"
    position: "$width-750,0"
    size: "750,580"
    valign: "center"
    zPosition: "2"
- widget:
    font: "md_body_small"
    foregroundColor: "md_primary"
    halign: "center"
    name: "titel"
    position: "1110,615"
    size: "720,93"
    transparent: "1"
    zPosition: "1"
- widget:
    font: "md_body_small"
    foregroundColor: "md_secondary"
    halign: "center"
    name: "station"
    position: "1110,715"
    size: "720,62"
    transparent: "1"
    zPosition: "1"
- widget:
    font: "md_body_small"
    foregroundColor: "md_error"
    name: "console"
    position: "1110,783"
    size: "720,62"
    transparent: "1"
    zPosition: "1"
