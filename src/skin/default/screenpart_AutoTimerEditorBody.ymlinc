- widget:
    conditional: "config"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,13*$list_item_height"
    valign: "center"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "20,$height-25"
    size: "$width-40,25"
    connection: "config"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    position: "20,$height-185"
    render: "Label"
    size: "$width-40,100"
    source: "help"
    valign: "center"
