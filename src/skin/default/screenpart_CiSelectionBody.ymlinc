- widget:
    font: "md_title_large"
    name: "text"
    position: "0,0"
    size: "1100,43"
- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "entries"
    position: "1,44"
    scrollbarMode: "showOnDemand"
    size: "$width-1,12*$list_item_height"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "1,$height-25"
    size: "$width-1,25"
    connection: "entries"
