screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "M3UIPTVManagerConfig"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        itemCornerRadius: "$radius_item"
        position: "$window_large_content_x,$window_large_content_y"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1670,13*45"
        source: "list"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (10, 5), size = (950, 35), flags = RT_HALIGN_LEFT, text = 1), # index 0 is the MenuText,
                                MultiContentEntryText(pos = (970, 10), size = (500, 35), font=1, flags = RT_HALIGN_RIGHT, text = 4),
                                MultiContentEntryPixmapAlphaBlend(pos = (1520, 1), size = (42, 42), flags = BT_SCALE|BT_KEEP_ASPECT_RATIO, png = 3),
                                MultiContentEntryPixmapAlphaBlend(pos = (1572, 12), size = (88, 20), flags = BT_SCALE|BT_KEEP_ASPECT_RATIO, png = 2),
                            ],
                            "fonts": [parseFont("md_body_large"), parseFont("md_label_medium")],
                            "itemHeight": 45
                        }
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "list"
        connection: "list"
        position: "$window_large_margin,861"
        size: "$window_large_inner_width,25"
        transparent: "1"
    - widget:
        font: "md_body_medium"
        halign: "center"
        objectTypes: "description,StaticText"
        position: "$window_large_margin,747"
        render: "Label"
        size: "$window_large_inner_width,66"
        source: "description"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        borderColor: "md_outline"
        borderWidth: "0"
        cornerRadius: "$radius_bar"
        foregroundColor: "md_on_surface_variant"
        position: "$window_large_margin,701"
        render: "Progress"
        size: "$window_large_inner_width,6"
        source: "progress"
        zPosition: "1"
