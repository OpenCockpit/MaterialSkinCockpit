screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoBouquetsMaker_Log"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemHeight: "38"
        name: "list"
        position: "$window_medium_content_x,$window_medium_content_y"
        size: "$window_medium_content_width,630"
        valign: "top"
