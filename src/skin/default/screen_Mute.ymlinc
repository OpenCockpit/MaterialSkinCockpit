screen:
  backgroundColor: "md_transparent"
  cornerRadius: "$radius_popup"
  flags: "wfNoBorder"
  name: "Mute"
  position: "$screen_center-45,30"
  size: "90,90"
  title: "Mute"
  zPosition: "10"
  children:
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_panel"
        position: "0,0"
        size: "90,90"
        widgetBorderColor: "md_surface_container_high"
        widgetBorderWidth: "2"
        zPosition: "-11"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/mute.svg"
        position: "20,20"
        size: "50,50"
        zPosition: "12"
