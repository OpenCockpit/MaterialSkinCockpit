screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "tmdbTemplate"
  position: "fill"
  title: "TMDb - The Movie Database"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_large_width,$window_large_height"
        window_inset_x: "$window_large_body_x"
    - xmlinc:
        file: "screenpart_tmdbPanel.ymlinc"
        position: "$window_large_body_x+25,$window_large_body_y+101"
        size: "$window_large_body_width-25,$window_large_body_height-101"
