# The frame of a screen of the small size and its body: a screenfamily of screen_* files hands the body in as content=, the name
# of the part (without extension) that is placed in the body rectangle of the frame. A screen of its own, like
# screenpart_ConfigScreen: what the body places is relative to the frame it follows.
screen:
  name: "ScreenSmall"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_small_width,$window_small_height"
        window_inset_x: "$window_small_body_x"
    - xmlinc:
        file: "$content"
        position: "$window_small_body_x,$window_small_body_y"
        size: "$window_small_body_width,$window_small_body_height"
