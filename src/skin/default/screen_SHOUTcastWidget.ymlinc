screen:
  flags: "wfNoBorder"
  name: "SHOUTcastWidget"
  position: "fill"
  title: "SHOUTcast"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1115,95"
        size: "1,876"
        zPosition: "-5"
    - widget:
        font: "md_title_large"
        foregroundColor: "md_secondary"
        name: "headertext"
        position: "25,115"
        size: "1070,40"
        transparent: "1"
        zPosition: "1"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "statustext"
        position: "25,495"
        size: "1070,135"
        transparent: "0"
        valign: "center"
        zPosition: "1"
    - widget:
        enableWrapAround: "1"
        foregroundColor: "md_on_surface_variant"
        itemCornerRadius: "$radius_item"
        name: "list"
        position: "25,195"
        scrollbarMode: "showOnDemand"
        scrollbarSliderBorderColor: "md_primary"
        scrollbarSliderBorderWidth: "1"
        scrollbarSliderForegroundColor: "md_primary"
        scrollbarWidth: "6"
        size: "1070,726"
        zPosition: "2"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        maxPages: "15"
        position: "25,953"
        size: "1070,25"
        zPosition: "3"
    - widget:
        alphatest: "on"
        halign: "left"
        name: "cover"
        position: "1135,95"
        size: "750,580"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_primary"
        halign: "center"
        name: "titel"
        position: "1135,710"
        size: "720,93"
        transparent: "1"
        zPosition: "1"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_secondary"
        halign: "center"
        name: "station"
        position: "1135,810"
        size: "720,62"
        transparent: "1"
        zPosition: "1"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_error"
        name: "console"
        position: "1135,878"
        size: "720,62"
        transparent: "1"
        zPosition: "1"
