screen:
  flags: "wfNoBorder"
  name: "SHOUTcastWidget"
  position: "fill"
  title: "SHOUTcast"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full.ymlinc"
        position: "5,5"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1120,100"
        size: "1,876"
        zPosition: "-5"
    - widget:
        font: "md_title_large"
        foregroundColor: "md_secondary"
        name: "headertext"
        position: "30,120"
        size: "1070,40"
        transparent: "1"
        zPosition: "1"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "statustext"
        position: "30,500"
        size: "1070,135"
        transparent: "0"
        valign: "center"
        zPosition: "1"
    - widget:
        enableWrapAround: "1"
        foregroundColor: "md_on_surface_variant"
        itemCornerRadius: "$radius_item"
        name: "list"
        position: "30,200"
        scrollbarMode: "showOnDemand"
        scrollbarSliderBorderColor: "md_primary"
        scrollbarSliderBorderWidth: "1"
        scrollbarSliderForegroundColor: "md_primary"
        scrollbarWidth: "6"
        size: "1070,726"
        zPosition: "2"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        maxPages: "15"
        position: "30,958"
        size: "1070,25"
        zPosition: "3"
    - widget:
        alphatest: "on"
        halign: "left"
        name: "cover"
        position: "1140,100"
        size: "750,580"
        valign: "center"
        zPosition: "2"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_primary"
        halign: "center"
        name: "titel"
        position: "1140,715"
        size: "720,93"
        transparent: "1"
        zPosition: "1"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_secondary"
        halign: "center"
        name: "station"
        position: "1140,815"
        size: "720,62"
        transparent: "1"
        zPosition: "1"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_error"
        name: "console"
        position: "1140,883"
        size: "720,62"
        transparent: "1"
        zPosition: "1"
