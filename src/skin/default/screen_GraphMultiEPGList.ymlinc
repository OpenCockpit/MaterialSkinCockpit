screen:
  flags: "wfNoBorder"
  name: "GraphMultiEPGList"
  position: "fill"
  title: "Electronic Program Guide"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - widget:
        alphatest: "blend"
        name: "timeline_now"
        pixmap: "window/timeline-now.png"
        position: "0,126"
        scale: "1"
        size: "28,792"
        zPosition: "2"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_panel"
        position: "20,90"
        size: "1866,885"
        widgetBorderColor: "md_outline_variant"
        widgetBorderWidth: "1"
        zPosition: "-2"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "20,96"
        size: "1,873"
        zPosition: "3"
    - widget:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_panel;top"
        foregroundColor: "md_on_surface"
        itemCornerRadius: "$radius_item;top"
        name: "timeline_text"
        position: "22,93"
        size: "1862,29"
        zPosition: "2"
    - widget:
        EntryActiveBackgroundColor: "md_error_container"
        EntryActiveBackgroundColorSelected: "md_primary_container"
        EntryBackgroundColor: "md_surface"
        EntryBackgroundColorSelected: "md_surface_container"
        EntryBorderColor: "md_outline_variant"
        EntryFont: "md_body_medium"
        EntryForegroundColor: "md_on_surface"
        EventBorderWidth: "1"
        EventNamePadding: "6"
        EventTextSidesMargin: "10"
        IconXPadding: "6"
        IconYPadding: "4"
        RecIconSize: "32"
        ServiceBorderWidth: "1"
        ServiceFont: "md_body_medium"
        ServiceForegroundColorNow: "md_primary"
        ServiceNameBackgroundColor: "md_surface_container_high"
        ServiceNameBackgroundColorSelected: "md_primary"
        ServiceNameForegroundColor: "md_on_surface"
        ServiceNamePadding: "6"
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        itemHeight: "72"
        name: "list"
        position: "20,125"
        scrollbarMode: "showNever"
        scrollbarSliderBorderColor: "md_surface_container_lowest"
        scrollbarSliderBorderWidth: "0"
        scrollbarSliderForegroundColor: "md_on_surface_variant"
        scrollbarWidth: "5"
        size: "1865,796"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "20,920"
        size: "1866,1"
        zPosition: "10"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "list"
        connection: "list"
        maxPages: "20"
        position: "20,935"
        size: "1865,25"
        transparent: "1"
    - widget:
        alphatest: "blend"
        borderColor: "md_shadow"
        borderWidth: "1"
        cornerRadius: "$radius_rating"
        font: "md_title_small_emphasized"
        halign: "center"
        position: "33,931"
        render: "RatingIconLabel"
        size: "32,32"
        source: "Event"
        valign: "center"
        widgetBorderColor: "md_outline_variant"
        widgetBorderWidth: "1"
        zPosition: "1"
        children:
          - convert:
              type: "EventName"
              text: "RatingTextAndColor"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_small_emphasized"
        foregroundColor: "md_tertiary"
        halign: "right"
        position: "1365,930"
        render: "Label"
        size: "500,34"
        source: "Event"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "EventName"
              text: "Genre"
