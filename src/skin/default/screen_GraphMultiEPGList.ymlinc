screen:
  name: "GraphMultiEPGList"
  position: "fill"
  title: "Electronic Program Guide"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - xmlinc:
        file: "screenpart_GraphMultiEPGListBody.ymlinc"
        position: "$window_full_body_x,$window_full_body_y"
        width: "$window_full_body_width"
        height: "$window_full_body_height"
