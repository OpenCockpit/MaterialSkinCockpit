screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "DreamExplorerII"
  position: "fill"
  title: "Dream-Explorer"
  children:
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        itemHeight: "45"
        name: "filelist"
        position: "26,82"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,675"
        transparent: "1"
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_menu.png"
        position: "1018,793"
        size: "36,26"
        zPosition: "2"
