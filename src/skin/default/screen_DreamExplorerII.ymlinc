screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "DreamExplorerII"
  position: "fill"
  title: "Dream-Explorer"
  children:
    - xmlinc:
        file: "screenpart_DreamExplorerIIBody.ymlinc"
        position: "$window_medium_body_x,$window_medium_body_y"
        size: "$window_medium_body_width,$window_medium_body_height"
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_medium_width,$window_medium_height"
        window_inset_x: "$window_medium_body_x"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_menu.png"
        position: "1018,793"
        size: "36,26"
        zPosition: "2"
