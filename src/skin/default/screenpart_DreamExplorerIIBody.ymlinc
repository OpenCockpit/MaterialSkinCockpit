- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_on_surface"
    itemHeight: "$list_item_height"
    name: "filelist"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,eval($height/$list_item_height*$list_item_height)"
    transparent: "1"
