screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PlutoTV"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - ePixmap:
        pixmap: "extensions/plutotv-backdrop.jpg"
        position: "5,75"
        size: "$screen_width-20,$screen_height-160"
        zPosition: "-1"
    - ePixmap:
        alphatest: "blend"
        pixmap: "extensions/transblack.png"
        position: "65,135"
        size: "615,750"
        transparent: "1"
        zPosition: "1"
    - widget:
        enableWrapAround: "1"
        name: "feedlist"
        position: "65,135"
        scrollbarMode: "showOnDemand"
        size: "615,728"
        transparent: "1"
        zPosition: "5"
    - widget:
        alphatest: "blend"
        pixmap: "extensions/transblack.png"
        position: "65,915"
        render: "Pixmap"
        size: "615,50"
        source: "updated"
        transparent: "1"
        zPosition: "1"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        font: "md_body_small"
        halign: "center"
        position: "65,915"
        render: "Label"
        size: "615,50"
        source: "updated"
        transparent: "1"
        valign: "center"
        zPosition: "5"
    - widget:
        backgroundColor: "md_shadow"
        font: "md_display_small"
        halign: "center"
        name: "loading"
        position: "556,504"
        size: "800,64"
        transparent: "0"
        valign: "center"
        zPosition: "10"
    - widget:
        alphatest: "blend"
        pixmap: "extensions/transblack.png"
        position: "650,135"
        render: "Pixmap"
        size: "1165,750"
        source: "vtitle"
        transparent: "1"
        zPosition: "0"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        font: "md_title_large"
        foregroundColor: "md_warning"
        position: "773,145"
        render: "Label"
        size: "1065,48"
        source: "vtitle"
        transparent: "1"
        zPosition: "5"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_shadow"
        cornerRadius: "$radius_poster_large_frame"
        font: "Regular;0"
        foregroundColor: "md_shadow"
        name: "posterBG"
        position: "728,198"
        size: "472,679"
        widgetBorderColor: "md_primary"
        widgetBorderWidth: "2"
        zPosition: "3"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_shadow"
        cornerRadius: "$radius_poster_large"
        name: "poster"
        position: "730,200"
        size: "468,675"
        transparent: "1"
        zPosition: "5"
    - widget:
        font: "md_body_small"
        name: "info"
        position: "1218,200"
        size: "619,651"
        transparent: "1"
        zPosition: "5"
