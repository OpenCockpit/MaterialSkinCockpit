screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PlutoTV"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full.ymlinc"
        position: "5,5"
    - ePixmap:
        pixmap: "extensions/plutotv-backdrop.jpg"
        position: "10,80"
        size: "e-20,e-160"
        zPosition: "-1"
    - ePixmap:
        alphatest: "blend"
        pixmap: "extensions/transblack.png"
        position: "70,140"
        size: "615,750"
        transparent: "1"
        zPosition: "1"
    - widget:
        enableWrapAround: "1"
        name: "feedlist"
        position: "70,140"
        scrollbarMode: "showOnDemand"
        size: "615,728"
        transparent: "1"
        zPosition: "5"
    - widget:
        alphatest: "blend"
        pixmap: "extensions/transblack.png"
        position: "70,920"
        render: "Pixmap"
        size: "615,50"
        source: "updated"
        transparent: "1"
        zPosition: "1"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        font: "md_body_small"
        halign: "center"
        position: "70,920"
        render: "Label"
        size: "615,50"
        source: "updated"
        transparent: "1"
        valign: "center"
        zPosition: "5"
    - widget:
        backgroundColor: "md_shadow"
        font: "md_display_small"
        halign: "center"
        name: "loading"
        position: "center,center"
        size: "800,60"
        transparent: "0"
        valign: "center"
        zPosition: "10"
    - widget:
        alphatest: "blend"
        pixmap: "extensions/transblack.png"
        position: "655,140"
        render: "Pixmap"
        size: "1165,750"
        source: "vtitle"
        transparent: "1"
        zPosition: "0"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        font: "md_title_large"
        foregroundColor: "md_warning"
        position: "778,150"
        render: "Label"
        size: "1065,48"
        source: "vtitle"
        transparent: "1"
        zPosition: "5"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_shadow"
        cornerRadius: "$radius_poster_large_frame"
        font: "Regular;0"
        foregroundColor: "md_shadow"
        name: "posterBG"
        position: "733,203"
        size: "472,679"
        widgetBorderColor: "md_primary"
        widgetBorderWidth: "2"
        zPosition: "3"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_shadow"
        cornerRadius: "$radius_poster_large"
        name: "poster"
        position: "735,205"
        size: "468,675"
        transparent: "1"
        zPosition: "5"
    - widget:
        font: "md_body_small"
        name: "info"
        position: "1223,205"
        size: "619,675"
        transparent: "1"
        zPosition: "5"
