screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PlutoTV"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - ePixmap:
        pixmap: "extensions/plutotv-backdrop.jpg"
        position: "5,$window_header_height+3"
        size: "$screen_width-20,$screen_height-$window_header_height-78"
        zPosition: "-1"
    - xmlinc:
        file: "screenpart_PlutoTVBody.ymlinc"
        position: "$window_full_body_x,$window_full_body_y"
        size: "$window_full_body_width,$window_full_body_height"
