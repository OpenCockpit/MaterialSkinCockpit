screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "LanguageSelection"
  position: "fill"
  title: "Language selection"
  children:
    - xmlinc:
        file: "screenpart_Screen_menu2.ymlinc"
        position: "495,136"
    - widget:
        position: "512,214"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "889,653"
        source: "languages"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (120, 10), size = (300, 40), flags = RT_HALIGN_LEFT, text = 1), # index 1 is the language name,
                                MultiContentEntryPixmap(pos = (20, 6), size = (60, 40), png = 2), # index 2 is the pixmap
                            ],
                            "fonts": [parseFont("md_body_medium")],
                            "itemHeight": 51
                        }
