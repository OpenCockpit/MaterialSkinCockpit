screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "TimerLog"
  position: "fill"
  title: "Timer log"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_title_large"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        name: "loglist"
        position: "21,92"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,535"
        textOffset: "20,0"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "21,642"
        size: "$window_medium_content_width,2"
        zPosition: "-5"
    - widget:
        font: "md_title_large"
        halign: "center"
        name: "logentry"
        position: "50,671"
        size: "1090,43"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "loglist"
        position: "26,732"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
