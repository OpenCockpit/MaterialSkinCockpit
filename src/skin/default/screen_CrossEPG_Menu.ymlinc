screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CrossEPG_Menu"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        position: "$window_medium_content_x,$window_medium_content_y"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1130,11*60"
        source: "list"
        transparent: "0"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryPixmapAlphaTest(pos = (18, 12), size = (48, 48), png = 0),
                                MultiContentEntryText(pos = (87, 11), size = (1060, 49), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_TOP, text = 1),
                            ],
                            "fonts": [parseFont("md_body_large")],
                            "itemHeight": 60
                        }
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
