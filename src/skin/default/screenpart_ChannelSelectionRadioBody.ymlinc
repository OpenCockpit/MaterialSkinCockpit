- eLabel:
    backgroundColor: "md_outline_variant"
    position: "1183,5"
    size: "1,870"
    zPosition: "-5"
- widget:
    backgroundColor: "md_surface"
    backgroundColorMarked: "md_surface_container_low"
    backgroundColorMarkedSelected: "md_success"
    colorEventProgressbar: "md_on_surface_variant"
    colorEventProgressbarBorder: "md_outline"
    colorEventProgressbarBorderSelected: "md_inverse_primary"
    colorEventProgressbarSelected: "md_inverse_primary"
    colorServiceDescription: "md_on_surface"
    colorServiceDescriptionSelected: "md_inverse_on_surface"
    enableWrapAround: "1"
    foregroundColorEventRemaining: "md_secondary"
    foregroundColorEventRemainingSelected: "md_inverse_primary"
    foregroundColorMarkedSelected: "md_inverse_on_surface"
    foregroundColorServiceNotAvail: "md_outline"
    itemCornerRadius: "$radius_item"
    itemHeight: "52"
    itemHeightTwoLine: "84"
    markerLine: "1"
    markerLineColor: "md_outline_variant"
    markerTextAlignment: "center"
    name: "list"
    nonplayableMargins: "0"
    piconMargin: "2"
    position: "8,0"
    progressBarWidth: "60"
    progressPercentWidth: "80"
    progressbarHeight: "10"
    scrollbarSliderBorderColor: "md_on_surface"
    scrollbarSliderBorderWidth: "1"
    scrollbarSliderForegroundColor: "md_on_surface_variant"
    scrollbarWidth: "5"
    serviceEventSeparator: " • "
    serviceInfoFont: "md_body_small"
    serviceNameFont: "md_body_large"
    serviceNumberFont: "md_body_large"
    serviceRemainingInfoFont: "md_body_small"
    sidesMargin: "10"
    size: "1152,832"
    textSeparator: "  •  "
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "list"
    maxPages: "15"
    position: "0,$height-25"
    size: "1160,25"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_body_medium"
    halign: "left"
    options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
    position: "1215,385"
    render: "COCRunningText"
    size: "645,297"
    source: "ServiceEvent"
    transparent: "1"
    valign: "top"
    children:
      - convert:
          type: "EventName"
          text: "FullDescription"
- widget:
    backgroundColor: "md_outline_variant"
    position: "1211,725"
    render: "FixedLabel"
    size: "645,1"
    source: "ServiceEvent"
    text: ""
    children:
      - convert:
          type: "EventName"
          text: "Name"
      - convert:
          type: "ConditionalShowHide"
- widget:
    NumberOfItems: "4"
    backgroundColor: "md_surface"
    font: "md_body_medium"
    foregroundColor: "md_on_surface"
    noLabel: "1"
    noWrap: "1"
    position: "1215,745"
    render: "NextEpgInfo"
    size: "645,132"
    source: "ServiceEvent"
    timeColor: "md_on_surface"
    transparent: "1"
    valign: "top"
- widget:
    alphatest: "blend"
    position: "1215,45"
    render: "Picon"
    size: "200,120"
    source: "ServiceEvent"
    zPosition: "12"
    children:
      - convert:
          type: "ServiceName"
          text: "Reference"
- widget:
    backgroundColor: "md_surface"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_primary"
    halign: "center"
    noWrap: "1"
    position: "1215,150"
    render: "Label"
    size: "200,58"
    source: "ServiceEvent"
    transparent: "1"
    valign: "bottom"
    zPosition: "14"
    children:
      - convert:
          nostrip: "1"
          type: "ServiceName"
          text: "  •  ,ORBPOS,TUNERSYSTEM"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_title_large"
    foregroundColor: "md_primary"
    halign: "left"
    noWrap: "1"
    position: "1215,329"
    render: "Label"
    size: "645,43"
    source: "ServiceEvent"
    transparent: "1"
    children:
      - convert:
          type: "EventName"
          text: "Name"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_title_small_emphasized"
    position: "1220,285"
    render: "Label"
    size: "160,30"
    source: "ServiceEvent"
    transparent: "1"
    children:
      - convert:
          nostrip: "1"
          type: "EventName"
          text: "  •  ,TIMERANGE"
- widget:
    backgroundColor: "md_surface"
    borderColor: "md_outline"
    borderWidth: "1"
    cornerRadius: "$radius_bar"
    foregroundColor: "md_on_surface_variant"
    position: "1358,299"
    render: "Progress"
    size: "400,6"
    source: "ServiceEvent"
    zPosition: "6"
    children:
      - convert:
          type: "EventTime"
          text: "Progress"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_small_emphasized"
    halign: "right"
    position: "$width-85,285"
    render: "Label"
    size: "85,30"
    source: "ServiceEvent"
    transparent: "1"
    zPosition: "2"
    children:
      - convert:
          type: "EventTime"
          text: "Remaining"
      - convert:
          type: "RemainingToText"
          text: "InMinutes"
