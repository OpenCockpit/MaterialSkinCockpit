- xmlinc:
    file: "screenpart_Pig.ymlinc"
    position: "$width-435,4"
    size: "435,248"
- eLabel:
    backgroundColor: "md_surface"
    cornerRadius: "$radius_panel"
    position: "0,$height-607"
    size: "$width,607"
    widgetBorderColor: "md_outline_variant"
    widgetBorderWidth: "1"
    zPosition: "-2"
- widget:
    conditional: "waitingtext"
    font: "md_title_large"
    halign: "center"
    name: "waitingtext"
    position: "10,333"
    size: "1845,492"
    valign: "center"
    zPosition: "1"
- widget:
    columnsCompactDescription: "280,240,200"
    columnsOriginal: "270,300"
    compactColumn: "400"
    dateWidth: "260"
    dirShift: "10"
    font: "md_body_large"
    fontSizesCompact: "36,28"
    fontSizesMinimal: "34,30"
    fontSizesOriginal: "36,26,24"
    iconsWidth: "33"
    itemCornerRadius: "$radius_item"
    itemHeight: "55"
    itemHeights: "107,78,50"
    name: "list"
    partIconeShiftCompact: "8"
    partIconeShiftMinimal: "12"
    partIconeShiftOriginal: "12"
    pbarHeight: "20"
    pbarLargeWidth: "72"
    pbarShift: "17"
    position: "10,333"
    scrollbarMode: "showNever"
    size: "1845,495"
    spaceIconeText: "6"
    spaceLeft: "10"
    spaceRight: "25"
    transparent: "1"
    trashShift: "10"
    treeDescription: "250"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "list"
    maxPages: "15"
    position: "5,854"
    size: "1855,25"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_body_large"
    halign: "left"
    options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
    position: "5,71"
    render: "COCRunningText"
    size: "1385,175"
    source: "Service"
    transparent: "1"
    valign: "top"
    children:
      - convert:
          type: "EventName"
          text: "FullDescription"
- widget:
    alphatest: "blend"
    name: "movie_sort"
    pixmaps: "icons/az.png,icons/newtop.png,icons/shuffle.png,icons/za.png,icons/oldtop.png,icons/faz.png,icons/fza.png,icons/default.png,icons/azold.png,icons/za.png,icons/longest.png,icons/shortest.png,icons/dtsrt.png,icons/dtsdt.png"
    position: "15,291"
    size: "42,30"
    zPosition: "1"
- widget:
    alphatest: "blend"
    name: "movie_off"
    pixmaps: "icons/ask.png,icons/movielist.png,icons/quit.png,icons/pause.png,icons/playlist.png,icons/playlistquit.png,icons/loop.png,icons/rep.png"
    position: "60,291"
    size: "52,30"
    zPosition: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "left"
    position: "117,283"
    render: "Label"
    size: "1200,40"
    source: "Service"
    valign: "center"
    children:
      - convert:
          nostrip: "1"
          type: "MovieInfo"
          text: "  •  ,RECSERVICE,TIMECREATED,DURATION,FILESIZE"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    foregroundColor: "md_primary"
    halign: "left"
    position: "5,0"
    render: "Label"
    size: "1385,43"
    source: "Service"
    transparent: "1"
    valign: "center"
    children:
      - convert:
          type: "EventName"
          text: "Name"
- eLabel:
    backgroundColor: "md_outline_variant"
    position: "0,844"
    size: "$width,1"
    text: ""
- eLabel:
    backgroundColor: "md_outline_variant"
    position: "0,324"
    size: "$width,1"
    text: ""
- ePixmap:
    alphatest: "blend"
    pixmap: "icons/hddfree.png"
    position: "1821,291"
    scale: "1"
    size: "24,24"
    zPosition: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_small"
    halign: "right"
    name: "freeDiskSpace"
    position: "1286,285"
    size: "525,34"
    valign: "center"
    zPosition: "1"
