- eLabel:
    backgroundColor: "md_outline_variant"
    position: "1120,0"
    size: "1,$height"
    zPosition: "-5"
- widget:
    iconMargin: "30"
    itemCornerRadius: "$radius_item"
    itemHeight: "90"
    name: "timerlist"
    position: "0,5"
    rowSplit: "45"
    satPosLeft: "250"
    scrollbarMode: "showNever"
    setEventNameFont: "md_title_large"
    setFont: "md_body_medium"
    setServiceNameFont: "md_body_medium"
    sidesMargin: "20"
    size: "1100,8*90"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "15,$height-25"
    size: "1100,25"
    connection: "timerlist"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_body_large"
    halign: "block"
    name: "description"
    position: "$width-530,20"
    size: "530,770"
    transparent: "1"
    valign: "center"
