- widget:
    itemCornerRadius: "$radius_item"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,5*105"
    source: "list"
    zPosition: "10"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (125, 9), size = (660, 48), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_TOP, text = 1), # index 1 is the interfacename
                                                                                                MultiContentEntryText(pos = (125, 60), size = (660, 36), font=1, flags = RT_HALIGN_LEFT|RT_VALIGN_BOTTOM, text = 2), # index 2 is the description
                                                                                                MultiContentEntryPixmapAlphaBlend(pos = (12, 12), size = (81, 81), png = 3), # index 3 is the interface pixmap
                                                                                                MultiContentEntryPixmapAlphaBlend(pos = (105, 63), size = (22, 24), png = 4), # index 4 is the default pixmap
                        ],
                        "fonts": [parseFont("md_headline_medium"), parseFont("md_body_large")],
                        "itemHeight": 105
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,610"
    size: "$width,25"
    connection: "list"
- widget:
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "center"
    position: "1,$height-38"
    render: "Label"
    size: "$width-1,38"
    source: "introduction"
    transparent: "1"
    valign: "center"
    zPosition: "10"
