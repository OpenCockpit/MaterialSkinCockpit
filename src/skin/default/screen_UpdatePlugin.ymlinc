screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "UpdatePlugin"
  position: "fill"
  title: "Software Update"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        position: "26,102"
        render: "Label"
        size: "1050,45"
        source: "package"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        position: "26,177"
        render: "Label"
        size: "1050,45"
        source: "status"
    - widget:
        backgroundColor: "md_surface"
        name: "slider"
        position: "26,552"
        size: "1128,20"
        zPosition: "100"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_surface"
        foregroundColor: "md_on_surface_variant"
        name: "activityslider"
        position: "26,572"
        size: "1128,6"
        zPosition: "100"
