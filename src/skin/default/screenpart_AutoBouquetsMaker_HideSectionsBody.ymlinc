- widget:
    itemCornerRadius: "$radius_item"
    position: "0,0"
    render: "Listbox"
    size: "$width,630"
    source: "list"
    transparent: "0"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryPixmapAlphaBlend(pos = ($list_indent, 2), size = (38, 36), png = 0),
                            MultiContentEntryText(pos = (eval($list_indent+47), 0), size = (700, $list_item_height), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 1),
                            MultiContentEntryText(pos = (eval($list_indent+760), 0), size = (330, $list_item_height), font=0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2),
                        ],
                        "fonts": [parseFont("md_body_medium")],
                        "itemHeight": $list_item_height
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
