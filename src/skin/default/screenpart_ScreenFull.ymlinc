# The frame of a screen of the full size and its body: a screenfamily of screen_* files hands the body in as content=, the name
# of the part (without extension) that is placed in the body rectangle of the frame (content_dx / content_dy: how far the body starts inside it, 0 by default). A screen of its own, like
# screenpart_ConfigScreen: what the body places is relative to the frame it follows.
screen:
  name: "ScreenFull"
  children:
    - param: {name: "content"}
    - param: {name: "content_dx", default: "0"}
    - param: {name: "content_dy", default: "0"}
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - xmlinc:
        file: "$content"
        position: "$window_full_body_x+$content_dx,$window_full_body_y+$content_dy"
        width: "$window_full_body_width-$content_dx"
        height: "$window_full_body_height-$content_dy"
