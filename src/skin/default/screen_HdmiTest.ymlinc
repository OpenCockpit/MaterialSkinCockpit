screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "HdmiTest"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        font: "$list_large_font"
        foregroundColor: "md_on_surface"
        itemHeight: "45"
        name: "config"
        position: "105,158"
        scrollbarMode: "showNever"
        size: "1670,315"
        zPosition: "1"
    - widget:
        font: "$list_font"
        foregroundColor: "md_tertiary"
        name: "address"
        position: "105,693"
        size: "465,38"
        zPosition: "1"
    - widget:
        font: "$list_font"
        foregroundColor: "md_tertiary"
        name: "sendto"
        position: "525,693"
        size: "465,38"
        zPosition: "1"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "105,735"
        size: "1050,3"
    - widget:
        font: "$label_font"
        foregroundColor: "md_success"
        halign: "left"
        name: "ltx"
        position: "105,743"
        size: "60,30"
        zPosition: "1"
    - widget:
        font: "$label_font"
        halign: "left"
        name: "txtext"
        position: "165,743"
        size: "330,180"
        zPosition: "1"
    - widget:
        font: "$label_font"
        foregroundColor: "md_error"
        halign: "left"
        name: "lrx"
        position: "525,743"
        size: "60,30"
        zPosition: "1"
    - widget:
        font: "$label_font"
        halign: "left"
        name: "rxtext"
        position: "585,743"
        size: "480,180"
        zPosition: "1"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_menu.png"
        position: "1600,980"
        size: "45,45"
        transparent: "1"
        zPosition: "10"
