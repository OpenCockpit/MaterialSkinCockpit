screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "HdmiTest"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_HdmiTestBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y"
        size: "$window_large_body_width,$window_large_body_height"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_menu.png"
        position: "1504,926"
        size: "45,45"
        transparent: "1"
        zPosition: "10"
