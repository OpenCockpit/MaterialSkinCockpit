screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "HdmiTest"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        font: "md_title_large"
        foregroundColor: "md_on_surface"
        itemHeight: "45"
        name: "config"
        position: "9,104"
        scrollbarMode: "showNever"
        size: "1670,315"
        zPosition: "1"
    - widget:
        font: "md_body_large"
        foregroundColor: "md_tertiary"
        name: "address"
        position: "9,639"
        size: "465,38"
        zPosition: "1"
    - widget:
        font: "md_body_large"
        foregroundColor: "md_tertiary"
        name: "sendto"
        position: "429,639"
        size: "465,38"
        zPosition: "1"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "9,681"
        size: "1050,3"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_success"
        halign: "left"
        name: "ltx"
        position: "9,689"
        size: "60,30"
        zPosition: "1"
    - widget:
        font: "md_body_small"
        halign: "left"
        name: "txtext"
        position: "69,689"
        size: "330,180"
        zPosition: "1"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_error"
        halign: "left"
        name: "lrx"
        position: "429,689"
        size: "60,30"
        zPosition: "1"
    - widget:
        font: "md_body_small"
        halign: "left"
        name: "rxtext"
        position: "489,689"
        size: "480,180"
        zPosition: "1"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_menu.png"
        position: "1504,926"
        size: "45,45"
        transparent: "1"
        zPosition: "10"
