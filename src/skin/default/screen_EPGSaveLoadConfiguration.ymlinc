screen:
  name: "EPGSaveLoadConfiguration"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_EPGSaveLoadConfigurationBody.ymlinc"
        position: "$window_large_body_x+20,$window_large_body_y+605"
        width: "$window_large_body_width-20"
        height: "$window_large_body_height-605"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_medium"
        foregroundColor: "md_primary"
        halign: "left"
        position: "1824,701"
        render: "Label"
        size: "1,1"
        source: "help"
        transparent: "1"
        zPosition: "1"
