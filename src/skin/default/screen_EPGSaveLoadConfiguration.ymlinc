screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "EPGSaveLoadConfiguration"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_medium"
        halign: "left"
        position: "$window_large_margin,701"
        render: "Label"
        size: "$window_large_inner_width,100"
        source: "epgcachelocation"
        transparent: "1"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_medium"
        halign: "left"
        itemHeight: "45"
        position: "1824,701"
        render: "Label"
        size: "$window_large_inner_width,100"
        source: "help"
        transparent: "1"
        zPosition: "1"
