screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "DeviceMountSetup"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "lab1"
        position: "$window_large_margin,808"
        size: "$window_large_inner_width,38"
        valign: "center"
        zPosition: "10"
