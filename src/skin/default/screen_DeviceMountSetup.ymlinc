screen:
  name: "DeviceMountSetup"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_DeviceMountSetupBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y+712"
        width: "$window_large_body_width"
        height: "$window_large_body_height-712"
