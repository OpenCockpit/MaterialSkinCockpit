screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CrossEPG_Setup"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        font: "$text_font"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "config"
        position: "396,210"
        scrollbarMode: "showNever"
        size: "1130,10*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "config"
        position: "396,849"
        size: "1130,25"
        transparent: "1"
    - widget:
        font: "$list_font"
        halign: "center"
        name: "information"
        position: "396,700"
        size: "1130,150"
        valign: "top"
