- widget:
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "990,eval($height/128*128)"
    source: "list"
    transparent: "1"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (135, 0), size = (900, 45), font=0, text = 0),
                            MultiContentEntryText(pos = (165, 45), size = (900, 75), font=1, flags = RT_VALIGN_TOP, text = 1),
                            MultiContentEntryPixmapAlphaBlend(pos = (0, 0), size = (120, 120), png = 2),
                        ],
                        "fonts": [parseFont("md_title_large"), parseFont("md_body_large")],
                        "itemHeight": 128
                    }
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_on_surface"
    halign: "left"
    name: "key_menu"
    position: "$width-278,$height-57"
    size: "278,57"
    valign: "center"
    zPosition: "1"
