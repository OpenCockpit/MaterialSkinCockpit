- widget:
    itemCornerRadius: "$radius_item"
    position: "0,0"
    render: "Listbox"
    size: "990,eval(($height-25)/128*128)"
    source: "list"
    transparent: "1"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (eval($list_indent+135), 0), size = (900, $list_item_height), font=0, text = 0),
                            MultiContentEntryText(pos = (eval($list_indent+165), 45), size = (900, 75), font=1, flags = RT_VALIGN_TOP, text = 1),
                            MultiContentEntryPixmapAlphaBlend(pos = ($list_indent, 0), size = (120, 120), png = 2),
                        ],
                        "fonts": [parseFont("md_title_large"), parseFont("md_body_large")],
                        "itemHeight": 128
                    }
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_on_surface"
    halign: "left"
    name: "key_menu"
    position: "$width-278,$height-57"
    size: "278,57"
    valign: "center"
    zPosition: "1"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "990,25"
    connection: "list"
