screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "RemoteTimerChannelList"
  position: "fill"
  children:
    - widget:
        font: "md_title_large"
        halign: "center"
        name: "text"
        origin: "screen"
        position: "779,101"
        size: "1110,902"
        valign: "center"
        zPosition: "1"
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        itemCornerRadius: "$radius_item"
        name: "channellist"
        position: "21,86"
        scrollbarMode: "showOnDemand"
        size: "$window_small_content_width,630"
