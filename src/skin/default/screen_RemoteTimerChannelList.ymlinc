screen:
  name: "RemoteTimerChannelList"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_small_width,$window_small_height"
        window_inset_x: "$window_small_body_x"
    - xmlinc:
        file: "screenpart_RemoteTimerChannelListBody.ymlinc"
        position: "$window_small_body_x,$window_small_body_y"
        width: "$window_small_body_width"
        height: "$window_small_body_height"
    - widget:
        font: "md_title_large"
        halign: "center"
        name: "text"
        position: "$window_small_body_x,$window_small_body_y"
        size: "$window_small_body_width,$window_small_body_height"
        valign: "center"
        zPosition: "1"
