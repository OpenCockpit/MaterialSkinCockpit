screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "LCDdisplayFile"
  position: "fill"
  title: "Select File/Dir..."
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        enableWrapAround: "1"
        font: "md_body_small"
        foregroundColor: "md_on_surface_variant"
        itemCornerRadius: "$radius_item"
        itemHeight: "35"
        name: "LCDfile"
        position: "40,112"
        scrollbarMode: "showOnDemand"
        scrollbarSliderBorderColor: "md_primary"
        scrollbarSliderBorderWidth: "1"
        scrollbarSliderForegroundColor: "md_primary"
        scrollbarWidth: "6"
        size: "1126,560"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_secondary"
        halign: "center"
        position: "40,702"
        render: "Label"
        size: "1126,45"
        source: "File"
        valign: "center"
