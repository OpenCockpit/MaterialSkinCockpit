screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "About"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        backgroundColor: "md_surface"
        colposition: "0"
        dividechar: ":"
        font: "md_body_medium"
        name: "AboutScrollLabel"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showNever"
        size: "1696,726"
        split: "1"
        zPosition: "2"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "AboutScrollLabel"
        position: "29,850"
        size: "1696,25"
        transparent: "1"
