- xmlinc:
    file: "screenpart_WindowBase.ymlinc"
    position: "0,0"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "left"
    name: "epg_eventname"
    position: "30,93"
    size: "$width-260,70"
    valign: "top"
- widget:
    alphatest: "blend"
    borderColor: "md_shadow"
    borderWidth: "1"
    cornerRadius: "$radius_rating_large"
    extendDirection: "left"
    font: "md_display_medium_emphasized"
    halign: "center"
    position: "$width-122,92"
    render: "RatingIconLabel"
    size: "96,96"
    source: "Event"
    valign: "center"
    widgetBorderColor: "md_outline_variant"
    widgetBorderWidth: "2"
    zPosition: "1"
    children:
      - convert:
          type: "EventName"
          text: "RatingTextAndColor"
- widget:
    backgroundColor: "md_surface"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_on_surface"
    halign: "left"
    name: "channel"
    position: "30,140"
    size: "$width-620,50"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_small_emphasized"
    halign: "left"
    name: "datetime"
    position: "30,$height-140"
    size: "340,40"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_small_emphasized"
    foregroundColor: "md_secondary"
    halign: "left"
    name: "duration"
    position: "370,$height-140"
    size: "340,40"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    foregroundColor: "md_tertiary"
    halign: "left"
    position: "714,$height-145"
    render: "Label"
    size: "670,45"
    source: "Event"
    zPosition: "1"
    children:
      - convert:
          type: "EventName"
          text: "Genre"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    halign: "block"
    name: "FullDescription"
    position: "30,212"
    scrollbarMode: "showNever"
    size: "$width-50,$height-536"
- widget:
    addon: "Pager"
    connection: "FullDescription"
    position: "30,212+$height-511"
    size: "$width-50,25"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_on_surface"
    halign: "right"
    position: "$width-438,2"
    render: "Label"
    size: "420,64"
    source: "global.CurrentTime"
    transparent: "1"
    valign: "center"
    zPosition: "20"
    children:
      - convert:
          type: "ClockToText"
          text: "Default"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_primary"
    halign: "left"
    position: "22,2"
    render: "Label"
    size: "$width-420,64"
    source: "Title"
    transparent: "1"
    valign: "center"
- widget:
    alphatest: "blend"
    backgroundColor: "md_surface"
    position: "$width-304,$height-270"
    render: "Picon"
    size: "220,132"
    source: "Service"
    transparent: "1"
    zPosition: "1"
    children:
      - convert:
          type: "ServiceName"
          text: "Reference"
