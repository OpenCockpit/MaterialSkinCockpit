screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoTimerImporter"
  position: "fill"
  title: "Import AutoTimer"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "21,86"
        scrollbarMode: "showNever"
        size: "$window_small_content_width,630"
