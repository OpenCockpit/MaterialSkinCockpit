- widget:
    alphatest: "blend"
    backgroundColor: "md_transparent"
    name: "poster"
    position: "0,0"
    size: "350,470"
    transparent: "1"
- widget:
    font: "$list_font"
    foregroundColor: "md_secondary"
    halign: "left"
    name: "titellabel"
    position: "380,0"
    size: "765,50"
- widget:
    font: "$list_font"
    halign: "left"
    name: "detailslabel"
    position: "380,130"
    size: "945,270"
- widget:
    alphatest: "blend"
    name: "starsbg"
    pixmap: "/usr/lib/enigma2/python/Plugins/Extensions/IMDb/starsbar_empty.png"
    position: "380,70"
    size: "315,31"
    zPosition: "2"
- widget:
    name: "stars"
    pixmap: "/usr/lib/enigma2/python/Plugins/Extensions/IMDb/starsbar_filled.png"
    position: "380,70"
    size: "315,31"
    transparent: "1"
    zPosition: "3"
- widget:
    font: "$list_font"
    foregroundColor: "md_on_surface_variant"
    halign: "center"
    name: "ratinglabel"
    position: "415,60"
    size: "765,50"
- widget:
    font: "$label_font"
    halign: "center"
    name: "statusbar"
    position: "0,490"
    size: "350,300"
    valign: "top"
- widget:
    font: "$list_large_font"
    foregroundColor: "md_on_surface_variant"
    name: "extralabel"
    position: "380,240"
    scrollbarMode: "showNever"
    size: "1282,555"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    conditional: "extralabel"
    connection: "extralabel"
    position: "380,775"
    size: "1282,25"
- widget:
    font: "$list_large_font"
    foregroundColor: "md_on_surface_variant"
    itemCornerRadius: "$radius_item"
    itemHeight: "45"
    name: "menu"
    position: "380,180"
    scrollbarMode: "showNever"
    size: "1282,13*45"
    zPosition: "3"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "menu"
    position: "380,775"
    size: "1282,25"
- widget:
    font: "$list_large_font"
    foregroundColor: "md_on_surface_variant"
    name: "castlabel"
    position: "380,370"
    scrollbarMode: "showNever"
    size: "1282,400"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    conditional: "castlabel"
    connection: "castlabel"
    position: "380,780"
    size: "1282,25"
