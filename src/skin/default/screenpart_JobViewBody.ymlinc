- widget:
    font: "md_title_large"
    position: "0,36"
    render: "Label"
    size: "1110,52"
    source: "job_name"
- widget:
    font: "md_title_large"
    position: "0,145"
    render: "Label"
    size: "$width,45"
    source: "job_task"
- widget:
    cornerRadius: $radius_bar_thick*3
    backgroundColor: "md_surface_container"
    borderWidth: "2"
    foregroundColor: "md_primary"
    position: "0,248"
    render: "Progress"
    size: "$width,54"
    transparent: "0"
    source: "job_progress"
- widget:
    font: "md_headline_medium"
    halign: "center"
    position: "0,251"
    render: "Label"
    size: "1110,50"
    source: "job_progress"
    transparent: "1"
    zPosition: "2"
    children:
      - convert:
          type: "ProgressToText"
- widget:
    font: "md_title_large"
    position: "0,360"
    render: "Label"
    size: "$width,43"
    source: "job_status"
- widget:
    font: "md_body_medium"
    backgroundColorSelected: "$backgroundColorSelected"
    itemCornerRadius: "$radius_item"
    itemCornerRadiusSelected: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,465"
    size: "$width,1*$list_item_height"
