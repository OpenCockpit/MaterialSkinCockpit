- widget:
    font: "md_body_large"
    halign: "center"
    name: "key"
    position: "0,0"
    size: "$width,38"
    transparent: "1"
    valign: "center"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_medium"
    halign: "center"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    position: "0,45"
    render: "Listbox"
    scrollbarMode: "showNever"
    selectionDisabled: "0"
    size: "$width,9*$list_item_height"
    source: "list"
    children:
      - convert:
          type: "StringList"
- widget:
    font: "md_body_medium"
    name: "lab1"
    position: "0,490"
    size: "275,42"
    valign: "center"
- widget:
    backgroundColor: "md_key_red"
    font: "md_body_medium"
    halign: "center"
    name: "labdisabled"
    position: "279,490"
    size: "150,42"
    valign: "center"
- widget:
    backgroundColor: "md_key_green"
    font: "md_body_medium"
    halign: "center"
    name: "labactive"
    position: "279,490"
    size: "150,42"
    valign: "center"
    zPosition: "1"
- widget:
    font: "md_body_medium"
    name: "lab2"
    position: "0,540"
    size: "275,42"
    valign: "center"
- widget:
    backgroundColor: "md_key_red"
    font: "md_body_medium"
    halign: "center"
    name: "labstop"
    position: "279,540"
    size: "150,42"
    valign: "center"
- widget:
    backgroundColor: "md_key_green"
    font: "md_body_medium"
    halign: "center"
    name: "labrun"
    position: "279,540"
    size: "150,42"
    valign: "center"
    zPosition: "1"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_on_surface_variant"
    name: "footnote"
    position: "0,$height-36"
    size: "$width,36"
    valign: "center"
