screen:
  name: "SoftcamSpinner"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_medium_width,$window_medium_height"
        window_inset_x: "$window_medium_body_x"
    - xmlinc:
        file: "screenpart_SoftcamSpinnerBody.ymlinc"
        position: "$window_medium_body_x+187,$window_medium_body_y+177"
        width: "$window_medium_body_width-187"
        height: "$window_medium_body_height-177"
