screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "SecondInfoBarTemplate"
  position: "fill"
  title: "Second InfoBar"
  children:
    - xmlinc:
        file: "screenpart_SecondInfoBarTemplatePanel.ymlinc"
        position: "0,0"
        size: "1728,990"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "8,670"
        size: "1712,2"
        zPosition: "-5"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "863,10"
        size: "2,48"
        zPosition: "-5"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "863,76"
        size: "2,580"
        zPosition: "-5"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        foregroundColor: "md_primary"
        noWrap: "1"
        position: "18,11"
        render: "Label"
        size: "730,45"
        source: "session.Event_Now"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        halign: "left"
        noWrap: "1"
        position: "18,76"
        render: "Label"
        size: "75,40"
        source: "session.Event_Now"
        children:
          - convert:
              type: "EventTime"
              text: "StartTime"
          - convert:
              type: "ClockToText"
              text: "Default"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        halign: "left"
        noWrap: "1"
        position: "93,76"
        render: "Label"
        size: "95,40"
        source: "session.Event_Now"
        children:
          - convert:
              type: "EventTime"
              text: "EndTime"
          - convert:
              type: "ClockToText"
              text: "Format:- %H:%M"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_tertiary"
        halign: "center"
        position: "192,76"
        render: "Label"
        size: "518,40"
        source: "session.Event_Now"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "EventName"
              text: "Genre"
    - widget:
        alphatest: "blend"
        borderColor: "md_shadow"
        borderWidth: "1"
        cornerRadius: "$radius_rating"
        extendDirection: "left"
        font: "md_title_small_emphasized"
        halign: "center"
        position: "817,16"
        render: "RatingIconLabel"
        size: "32,32"
        source: "session.Event_Now"
        valign: "center"
        widgetBorderColor: "md_outline_variant"
        widgetBorderWidth: "1"
        zPosition: "1"
        children:
          - convert:
              type: "EventName"
              text: "RatingTextAndColor"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_secondary"
        halign: "right"
        noWrap: "1"
        position: "714,76"
        render: "Label"
        size: "130,40"
        source: "session.Event_Now"
        children:
          - convert:
              type: "EventTime"
              text: "Remaining"
          - convert:
              type: "RemainingToText"
              text: "InMinutes"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
        position: "18,131"
        render: "COCRunningText"
        size: "842,505"
        source: "session.Event_Now"
        valign: "top"
        children:
          - convert:
              type: "EventName"
              text: "FullDescription"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        halign: "left"
        noWrap: "1"
        position: "879,76"
        render: "Label"
        size: "75,40"
        source: "session.Event_Next"
        children:
          - convert:
              type: "EventTime"
              text: "StartTime"
          - convert:
              type: "ClockToText"
              text: "Default"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        halign: "left"
        noWrap: "1"
        position: "954,76"
        render: "Label"
        size: "95,40"
        source: "session.Event_Next"
        children:
          - convert:
              type: "EventTime"
              text: "EndTime"
          - convert:
              type: "ClockToText"
              text: "Format:- %H:%M"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_tertiary"
        halign: "center"
        position: "1053,76"
        render: "Label"
        size: "517,40"
        source: "session.Event_Next"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "EventName"
              text: "Genre"
    - widget:
        alphatest: "blend"
        borderColor: "md_shadow"
        borderWidth: "1"
        cornerRadius: "$radius_rating"
        extendDirection: "left"
        font: "md_title_small_emphasized"
        halign: "center"
        position: "1679,16"
        render: "RatingIconLabel"
        size: "32,32"
        source: "session.Event_Next"
        valign: "center"
        widgetBorderColor: "md_outline_variant"
        widgetBorderWidth: "1"
        zPosition: "1"
        children:
          - convert:
              type: "EventName"
              text: "RatingTextAndColor"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_secondary"
        halign: "right"
        noWrap: "1"
        position: "1574,76"
        render: "Label"
        size: "130,40"
        source: "session.Event_Next"
        children:
          - convert:
              type: "EventTime"
              text: "Remaining"
          - convert:
              type: "RemainingToText"
              text: "InMinutes"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        noWrap: "1"
        position: "879,11"
        render: "Label"
        size: "730,45"
        source: "session.Event_Next"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
        position: "879,131"
        render: "COCRunningText"
        size: "842,505"
        source: "session.Event_Next"
        valign: "top"
        children:
          - convert:
              type: "EventName"
              text: "FullDescription"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_surface"
        position: "42,728"
        render: "Picon"
        size: "227,130"
        source: "session.CurrentService"
        zPosition: "1"
        children:
          - convert:
              type: "ServiceName"
              text: "Reference"
    - widget:
        backgroundColor: "md_surface_container_high"
        font: "md_title_large"
        foregroundColor: "md_on_surface"
        halign: "left"
        noWrap: "1"
        position: "26,910"
        render: "Label"
        size: "1200,60"
        source: "session.CurrentService"
        valign: "center"
        zPosition: "100"
        children:
          - convert:
              nostrip: "1"
              type: "ServiceName"
              text: "  •  ,NUMBER,NAME,ORBPOS,PROVIDER"
    - widget:
        addon: "ServiceInfoBar"
        alignment: "right"
        autoresizeMode: "condensed"
        backgroundColor: "md_surface_container_high"
        connection: "session"
        elements: "gamma,videoRes,txt,dolby,audiotrack,subtitletrack,subservices,stream,hbbtv,separator,catchup,separator,servicetype,separator,record,separator,tuners"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_success"
        pixmaps: "IS_HDR:icons/hdr_on.png,IS_HDR10:icons/hdr10_on.png,IS_HLG:icons/hlg_on.png,IS_HD:icons/HD_s_n.png,IS_4K:icons/4K_s_n.png,IS_SD:icons/SD_s_n.png,txt:icons/ico_txt_on.png,dolby:icons/dd_s.png,crypt:icons/crypt_s.png,cryptscsa:icons/cryptscsa.png,audiotrack:icons/ml_s_alt2.png,subtitletrack:icons/subs_s.png,hbbtv:icons/hbbtv_s.png,subservices:icons/ico_subs_on.png,stream:icons/streaming.png,record:icons/rec2.png,catchup:icons/ico_catchup.png,sat:icons/satdish.png,cable:icons/ico_dvb-c.png,terestrial:icons/ico_dvb-t.png,iptv:icons/ico_stream.png"
        position: "1004,925"
        separatorLineColor: "md_outline_variant"
        separatorLineThickness: "1"
        size: "700,30"
        spacing: "20"
        textBackColor: "md_surface_container_high"
        transparent: "1"
        zPosition: "110"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "md_display_medium_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1425,708"
        render: "Label"
        size: "320,70"
        source: "global.CurrentTime"
        transparent: "1"
        valign: "top"
        zPosition: "20"
        children:
          - convert:
              type: "ClockToText"
              text: "Default"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1425,778"
        render: "Label"
        size: "320,45"
        source: "global.CurrentTime"
        transparent: "1"
        valign: "top"
        zPosition: "20"
        children:
          - convert:
              type: "ClockToText"
              text: "Format: %d %B %Y"
    - widget:
        backgroundColor: "md_surface"
        font: "caid_font"
        foregroundColor: "md_on_surface"
        halign: "right"
        position: "1357,841"
        render: "Label"
        size: "325,40"
        source: "session.CurrentService"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "PliExtraInfo"
              text: "CryptoBar"
