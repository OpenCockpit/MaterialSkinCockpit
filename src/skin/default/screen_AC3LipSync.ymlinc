screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AC3LipSync"
  position: "20,15"
  size: "600,460"
  title: "Audio Sync"
  zPosition: "1"
  children:
    - ePixmap:
        alphatest: "on"
        pixmap: "~/img/AudioSyncBG.png"
        position: "0,0"
        size: "600,460"
        transparent: "1"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface_container"
        font: "$caption_font"
        foregroundColor: "md_on_surface"
        name: "ServiceInfoLabel"
        position: "20,15"
        size: "110,22"
        transparent: "1"
        zPosition: "4"
    - widget:
        backgroundColor: "md_surface_container"
        font: "$hint_font"
        foregroundColor: "md_on_surface"
        name: "ServiceInfo"
        position: "140,15"
        size: "190,25"
        transparent: "1"
        zPosition: "4"
    - widget:
        alphatest: "on"
        name: "ChannelImg"
        pixmaps: "~/img/OptionButtonOff.png,~/img/OptionButtonOn.png"
        position: "20,43"
        size: "11,11"
        transparent: "1"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface_container"
        font: "$caption_font"
        foregroundColors: "md_on_surface,md_warning"
        halign: "left"
        name: "ChannelLabel"
        position: "36,40"
        size: "160,22"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - widget:
        alphatest: "on"
        name: "GlobalImg"
        pixmaps: "~/img/OptionButtonOff.png,~/img/OptionButtonOn.png"
        position: "220,43"
        size: "11,11"
        transparent: "1"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface_container"
        font: "$caption_font"
        foregroundColors: "md_on_surface,md_warning"
        halign: "left"
        name: "GlobalLabel"
        position: "236,40"
        size: "199,22"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - ePixmap:
        alphatest: "on"
        pixmap: "~/img/AudioSyncBarBGVert.png"
        position: "30,70"
        size: "21,370"
        transparent: "1"
        zPosition: "2"
    - widget:
        name: "AudioSliderBar"
        orientation: "orBottomToTop"
        pixmap: "~/img/AudioSyncBarVert.png"
        position: "30,70"
        size: "21,370"
        transparent: "1"
        zPosition: "3"
    - widget:
        backgroundColor: "md_surface_container"
        font: "$caption_font"
        foregroundColor: "md_on_surface"
        halign: "center"
        name: "AudioSlider"
        position: "5,245"
        size: "70,22"
        transparent: "1"
        valign: "center"
        zPosition: "4"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_red.png"
        position: "307,20"
        scale: "1"
        size: "24,12"
        transparent: "1"
        zPosition: "5"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_green.png"
        position: "412,20"
        scale: "1"
        size: "24,12"
        transparent: "1"
        zPosition: "5"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_blue.png"
        position: "412,45"
        scale: "1"
        size: "24,12"
        transparent: "1"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface_container"
        font: "$caption_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "key_red"
        position: "335,15"
        size: "85,22"
        transparent: "1"
        valign: "center"
        zPosition: "4"
    - widget:
        backgroundColor: "md_surface_container"
        font: "$caption_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "key_green"
        position: "440,15"
        size: "85,22"
        transparent: "1"
        valign: "center"
        zPosition: "4"
    - widget:
        backgroundColor: "md_surface_container"
        font: "$caption_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "key_blue"
        position: "440,40"
        size: "160,22"
        transparent: "1"
        valign: "center"
        zPosition: "4"
