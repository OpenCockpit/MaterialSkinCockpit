screen:
  name: "HdmiTestInfoScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_medium_width,$window_medium_height"
        window_inset_x: "$window_medium_body_x"
    - widget:
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        font: "md_title_large"
        foregroundColor: "md_on_surface"
        itemHeight: "$list_item_height"
        name: "rxtext"
        position: "$window_medium_body_x,$window_medium_body_y"
        scrollbarMode: "showNever"
        size: "$window_medium_body_width,10*$list_item_height"
        transparent: "1"
