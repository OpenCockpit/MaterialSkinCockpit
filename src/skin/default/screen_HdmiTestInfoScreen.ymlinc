screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "HdmiTestInfoScreen"
  position: "fill"
  children:
    - widget:
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        font: "md_title_large"
        foregroundColor: "md_on_surface"
        itemHeight: "$list_item_height"
        name: "rxtext"
        origin: "screen"
        position: "105,153"
        scrollbarMode: "showNever"
        size: "1050,10*$list_item_height"
        transparent: "1"
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_medium_width,$window_medium_height"
        window_inset_x: "$window_medium_body_x"
