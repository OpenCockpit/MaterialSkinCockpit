screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "BluetoothDiscoveryScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_BluetoothDiscoveryScreenBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y"
        size: "$window_large_body_width,$window_large_body_height"
