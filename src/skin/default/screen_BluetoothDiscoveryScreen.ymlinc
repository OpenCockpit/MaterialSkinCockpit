screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "BluetoothDiscoveryScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        itemHeight: "45"
        position: "125,150"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1670,13*45"
        source: "deviceList"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                		{
                			"template": [
                				MultiContentEntryText(pos = (80, 0), size = (1000, 40), font=1, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 0), # index 0 is Name
                																					MultiContentEntryPixmapAlphaTest(pos = (10, 10), size = (50, 50), png = 1), # index 1 is bt_icon
                			],
                			"fonts": [gFont("Regular", $heading_font_size), gFont("Regular", $text_font_size) , gFont("Regular", $hint_font_size), gFont("Regular", $micro_font_size)],
                			"itemHeight": 70
                		}
