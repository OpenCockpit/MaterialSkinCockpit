screen:
  name: "WizardPictureLangTemplate"
  children:
    - eLabel:
        alphatest: "blend"
        font: "md_title_large"
        position: "0,0"
        size: "75,50"
        text: "<<<"
        transparent: "1"
        zPosition: "0"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_red.png"
        position: "75,15"
        size: "40,20"
        transparent: "1"
        zPosition: "0"
    - widget:
        font: "md_title_large"
        name: "backtext"
        position: "125,0"
        size: "350,50"
    - widget:
        font: "md_title_large"
        name: "languagetext"
        position: "475,0"
        size: "350,50"
    - eLabel:
        alphatest: "blend"
        font: "md_title_large"
        halign: "right"
        position: "$width-75,0"
        size: "75,50"
        text: ">>>"
        transparent: "1"
        zPosition: "0"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_blue.png"
        position: "$width-120,15"
        size: "40,20"
        transparent: "1"
        zPosition: "0"
    - widget:
        font: "md_title_large"
        halign: "right"
        name: "nexttext"
        position: "$width-475,0"
        size: "350,50"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_yellow.png"
        position: "0,$height-85"
        size: "40,20"
        transparent: "1"
        zPosition: "0"
    - widget:
        font: "md_title_large"
        name: "languagetext"
        position: "50,$height-100"
        size: "350,50"
