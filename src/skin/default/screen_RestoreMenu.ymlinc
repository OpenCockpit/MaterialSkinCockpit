screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "RestoreMenu"
  position: "fill"
  title: "Restore Backups"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_body_medium"
        itemHeight: "45"
        name: "filelist"
        position: "18,80"
        scrollbarMode: "showNever"
        size: "$window_small_content_width,580"
        transparent: "1"
        zPosition: "3"
