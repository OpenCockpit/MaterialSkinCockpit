- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "checkList"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,eval(($height-25)/$list_item_height*$list_item_height)"
    valign: "center"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "checkList"
