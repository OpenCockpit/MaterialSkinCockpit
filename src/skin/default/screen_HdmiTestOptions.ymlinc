screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "HdmiTestOptions"
  position: "fill"
  children:
    - widget:
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        itemHeight: "45"
        name: "config"
        position: "26,82"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,450"
        transparent: "1"
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
