screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "VlcMediaListScreen"
  position: "fill"
  title: ""
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        alphatest: "blend"
        name: "filelist_button_sel"
        pixmap: "epg_now.png"
        position: "24,153"
        size: "225,8"
        zPosition: "3"
    - widget:
        alphatest: "blend"
        name: "playlist_button_sel"
        pixmap: "epg_next.png"
        position: "249,153"
        size: "225,8"
        zPosition: "3"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "center"
        name: "filelist_text"
        position: "24,114"
        size: "225,35"
        transparent: "1"
        zPosition: "4"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "center"
        name: "playlist_text"
        position: "249,114"
        size: "225,35"
        transparent: "1"
        zPosition: "4"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "9,161"
        size: "1080,696"
        zPosition: "1"
    - eLabel:
        backgroundColor: "md_surface"
        position: "12,164"
        size: "1074,690"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        name: "filelist"
        position: "24,179"
        scrollbarMode: "showNever"
        size: "1050,656"
        transparent: "1"
        zPosition: "3"
    - widget:
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        name: "playlist"
        position: "24,179"
        scrollbarMode: "showNever"
        size: "1050,656"
        transparent: "1"
        zPosition: "3"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_ok.png"
        position: "1504,926"
        size: "45,45"
        transparent: "1"
        zPosition: "10"
