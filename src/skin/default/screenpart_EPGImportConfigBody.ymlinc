- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,11*$list_item_height"
    valign: "center"
- widget:
    backgroundColor: "md_surface"
    connection: "config"
    pagerBackground: "md_surface"
    pagerForeground: "md_on_surface"
    position: "0,520"
    render: "Pager"
    size: "$width,25"
    transparent: "1"
- widget:
    font: "md_body_large"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "description"
    position: "0,443"
    size: "0,0*$list_item_height"
    valign: "top"
- widget:
    font: "md_body_large"
    foregroundColor: "md_warning"
    name: "statusbar"
    position: "0,$height-38"
    size: "1110,38"
- widget:
    font: "md_body_large"
    foregroundColor: "md_warning"
    name: "status"
    position: "0,560"
    size: "1110,90"
