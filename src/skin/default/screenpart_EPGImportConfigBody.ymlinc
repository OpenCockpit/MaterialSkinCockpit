- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,eval(($height-142)/$list_item_height*$list_item_height)"
    valign: "center"
- widget:
    backgroundColor: "md_surface"
    connection: "config"
    pagerBackground: "md_surface"
    pagerForeground: "md_on_surface"
    position: "0,$height-25"
    render: "Pager"
    size: "$width,25"
    transparent: "1"
- widget:
    font: "md_body_large"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "description"
    position: "0,443"
    size: "0,0*$list_item_height"
    valign: "top"
- widget:
    font: "md_body_large"
    foregroundColor: "md_warning"
    halign: "center"
    name: "statusbar"
    position: "0,$height-70"
    size: "$width,38"
- widget:
    font: "md_body_large"
    foregroundColor: "md_warning"
    halign: "center"
    name: "status"
    position: "0,$height-142"
    size: "$width,72"
