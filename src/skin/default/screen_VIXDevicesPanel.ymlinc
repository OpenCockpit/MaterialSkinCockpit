screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "VIXDevicesPanel"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        itemCornerRadius: "$radius_item"
        position: "$window_medium_content_x,$window_medium_content_y"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,637"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (135, 7), size = (975, 39), font=0, flags = RT_HALIGN_LEFT, text = 0), # index 0 is the name
                                                                                                        MultiContentEntryText(pos = (135, 49), size = (975, 57), font=1, flags = RT_HALIGN_LEFT, text = 1), # index 1 is the state
                                                                                                        MultiContentEntryPixmapAlphaBlend(pos = (22, 7), size = (72, 72), png = 2), # index 2 is the status pixmap
                            ],
                            "fonts": [parseFont("md_title_large"), parseFont("md_body_small")],
                            "itemHeight": 112
                        }
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "list"
        connection: "list"
        position: "26,739"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "lab1"
        position: "36,570"
        size: "1110,38"
        transparent: "1"
        valign: "top"
        zPosition: "1"
