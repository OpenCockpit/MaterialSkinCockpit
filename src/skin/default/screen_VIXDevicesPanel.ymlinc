screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "VIXDevicesPanel"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        itemCornerRadius: "$radius_item"
        position: "396,210"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1130,637"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                		{
                			"template": [
                				MultiContentEntryText(pos = (135, 7), size = (975, 39), font=0, flags = RT_HALIGN_LEFT, text = 0), # index 0 is the name
                																						MultiContentEntryText(pos = (135, 49), size = (975, 57), font=1, flags = RT_HALIGN_LEFT, text = 1), # index 1 is the state
                																						MultiContentEntryPixmapAlphaBlend(pos = (22, 7), size = (72, 72), png = 2), # index 2 is the status pixmap
                			],
                			"fonts": [gFont("Regular", $list_large_font_size), gFont("Regular", $hint_font_size)],
                			"itemHeight": 112
                		}
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "list"
        connection: "list"
        position: "396,857"
        size: "1130,25"
        transparent: "1"
    - widget:
        font: "$list_font"
        halign: "center"
        name: "lab1"
        position: "406,690"
        size: "1110,34"
        transparent: "1"
        valign: "top"
        zPosition: "1"
