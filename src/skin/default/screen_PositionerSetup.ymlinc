screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PositionerSetup"
  position: "fill"
  title: "Positioner setup"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_large_width,$window_large_height"
        window_inset_x: "$window_large_body_x"
    - widget:
        font: "md_body_large"
        foregroundColor: "md_primary"
        halign: "center"
        name: "status_bar"
        position: "eval(($window_large_width-330)/2),22"
        size: "330,37"
    - xmlinc:
        file: "screenpart_PositionerSetupBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y"
        size: "$window_large_body_width,$window_large_body_height"
