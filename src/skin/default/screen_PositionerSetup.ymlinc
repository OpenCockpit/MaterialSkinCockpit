        size: "330,37"
    - xmlinc:
        file: "screenpart_PositionerSetupPanel.ymlinc"
        position: "35,87"
    - widget:
        font: "md_body_large"
        foregroundColor: "md_primary"
        halign: "center"
        name: "status_bar"
        position: "750,729"
