- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "menulist"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,9*$list_item_height"
    textOffset: "20,5"
    zPosition: "10"
- widget:
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "center"
    position: "0,430"
    render: "Label"
    size: "$width,140"
    source: "description"
    transparent: "1"
    valign: "center"
- widget:
    font: "md_body_large"
    halign: "right"
    position: "496,$height-37"
    render: "Label"
    size: "247,37"
    source: "IFtext"
    transparent: "1"
    valign: "center"
    zPosition: "10"
- widget:
    font: "md_body_large"
    halign: "left"
    position: "$width-375,$height-37"
    render: "Label"
    size: "375,37"
    source: "IF"
    transparent: "1"
    valign: "center"
    zPosition: "10"
- widget:
    font: "md_body_large"
    foregroundColor: "md_warning"
    halign: "right"
    position: "0,$height-37"
    render: "Label"
    size: "300,37"
    source: "Statustext"
    transparent: "1"
    valign: "center"
    zPosition: "10"
- widget:
    alphatest: "blend"
    name: "statuspic"
    pixmaps: "icons/lock_on.png,icons/lock_off.png"
    position: "314,$height-37"
    size: "52,37"
    transparent: "1"
    zPosition: "10"
