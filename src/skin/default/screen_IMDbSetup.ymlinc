screen:
  flags: "wfNoBorder"
  name: "IMDbSetup"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_IMDbSetupBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y"
        size: "$window_large_body_width,$window_large_body_height"
