screen:
  flags: "wfNoBorder"
  name: "IMDbSetup"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        font: "md_body_medium"
        foregroundColor: "md_secondary"
        position: "$window_large_margin,701"
        render: "Label"
        size: "$window_large_inner_width,100"
        source: "help"
