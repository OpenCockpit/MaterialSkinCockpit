screen:
  name: "IMDbSetup"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_IMDbSetupBody.ymlinc"
        position: "$window_large_body_x+20,$window_large_body_y+605"
        width: "$window_large_body_width-20"
        height: "$window_large_body_height-605"
