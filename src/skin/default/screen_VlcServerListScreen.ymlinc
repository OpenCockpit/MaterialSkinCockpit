screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "VlcServerListScreen"
  position: "fill"
  title: ""
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - eLabel:
        backgroundColor: "md_surface"
        position: "108,218"
        size: "1074,690"
        zPosition: "2"
    - eLabel:
        backgroundColor: "md_surface"
        font: "$heading_font"
        halign: "center"
        position: "1245,180"
        size: "615,44"
        text: "Select a VLC-Server Profile"
        transparent: "1"
    - widget:
        font: "$list_font"
        name: "serverlabel"
        position: "105,150"
        size: "1080,38"
        transparent: "1"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "105,215"
        size: "1080,696"
        zPosition: "1"
    - widget:
        enableWrapAround: "1"
        name: "serverlist"
        position: "120,233"
        scrollbarMode: "showNever"
        size: "1050,656"
        transparent: "1"
        zPosition: "3"
    - ePixmap:
        alphatest: "blend"
        pixmap: "MaterialSkinCockpit/icons/db.png"
        position: "1245,840"
        size: "600,99"
        transparent: "1"
        zPosition: "2"
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_ok.png"
        position: "1600,980"
        size: "45,45"
        transparent: "1"
        zPosition: "10"
