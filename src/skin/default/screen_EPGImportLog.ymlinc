screen:
  flags: "wfNoBorder"
  name: "EPGImportLog"
  position: "fill"
  title: "EPG Import Log"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "39,106"
        scrollbarMode: "showNever"
        size: "1650,12*45"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        connection: "list"
        pagerBackground: "md_surface"
        pagerForeground: "md_on_surface"
        position: "$window_large_margin,861"
        render: "Pager"
        size: "$window_large_inner_width,25"
        transparent: "1"
