- ePixmap:
    alphatest: "blend"
    pixmap: "extensions/transblack.png"
    position: "0,0"
    size: "615,750"
    transparent: "1"
    zPosition: "1"
- widget:
    enableWrapAround: "1"
    name: "feedlist"
    position: "0,0"
    scrollbarMode: "showOnDemand"
    size: "615,728"
    transparent: "1"
    zPosition: "5"
- widget:
    alphatest: "blend"
    pixmap: "extensions/transblack.png"
    position: "0,780"
    render: "Pixmap"
    size: "615,50"
    source: "updated"
    transparent: "1"
    zPosition: "1"
    children:
      - convert:
          type: "ConditionalShowHide"
- widget:
    font: "md_body_small"
    halign: "center"
    position: "0,780"
    render: "Label"
    size: "615,50"
    source: "updated"
    transparent: "1"
    valign: "center"
    zPosition: "5"
- widget:
