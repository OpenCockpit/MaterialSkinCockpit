screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CommitInfo"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        font: "mono_font"
        halign: "left"
        name: "AboutScrollLabel"
        position: "25,84"
        scrollbarMode: "showNever"
        size: "1674,754"
        zPosition: "2"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "AboutScrollLabel"
        position: "25,850"
        size: "1696,25"
        transparent: "1"
