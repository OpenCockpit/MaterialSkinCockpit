screen:
  flags: "wfNoBorder"
  name: "MovieSelectionSlim"
  position: "fill"
  title: "Movie Selection"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full_Big_Pig.ymlinc"
        position: "5,5"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1200,105"
        size: "1,870"
        zPosition: "-5"
    - widget:
        conditional: "waitingtext"
        font: "$subtitle_font"
        halign: "center"
        name: "waitingtext"
        position: "20,100"
        size: "1160,860"
        valign: "center"
        zPosition: "1"
    - widget:
        columnsCompactDescription: "280,240,200"
        columnsOriginal: "270,300"
        compactColumn: "400"
        dateWidth: "260"
        dirShift: "10"
        font: "$list_font"
        fontSizesCompact: "36,28"
        fontSizesMinimal: "34,30"
        fontSizesOriginal: "36,26,24"
        iconsWidth: "33"
        itemCornerRadius: "$radius_item"
        itemHeight: "55"
        itemHeights: "107,78,50"
        name: "list"
        partIconeShiftCompact: "8"
        partIconeShiftMinimal: "12"
        partIconeShiftOriginal: "12"
        pbarHeight: "20"
        pbarLargeWidth: "72"
        pbarShift: "17"
        position: "20,95"
        scrollbarMode: "showNever"
        size: "1160,860"
        spaceIconeText: "6"
        spaceLeft: "25"
        spaceRight: "25"
        transparent: "1"
        trashShift: "10"
        treeDescription: "250"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        maxPages: "15"
        position: "20,960"
        size: "1160,25"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "$list_font"
        halign: "left"
        options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
        position: "1235,570"
        render: "COCRunningText"
        size: "645,300"
        source: "Service"
        transparent: "1"
        valign: "top"
        children:
          - convert:
              type: "EventName"
              text: "ExtendedDescription"
    - widget:
        backgroundColor: "md_surface"
        font: "$text_font"
        foregroundColor: "md_primary"
        halign: "left"
        position: "1235,500"
        render: "Label"
        size: "645,40"
        source: "Service"
        valign: "center"
        children:
          - convert:
              nostrip: "1"
              type: "MovieInfo"
              text: "  •  ,TIMECREATED,DURATION,FILESIZE"
    - widget:
        backgroundColor: "md_surface"
        font: "$header_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        position: "1235,400"
        render: "Label"
        size: "610,40"
        source: "Service"
        valign: "center"
        children:
          - convert:
              type: "MovieInfo"
              text: "RecordServiceName"
    - widget:
        backgroundColor: "md_surface"
        font: "$subtitle_font"
        foregroundColor: "md_primary"
        halign: "left"
        position: "1235,450"
        render: "Label"
        size: "610,40"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - widget:
        alphatest: "blend"
        position: "1230,165"
        render: "Picon"
        size: "200,120"
        source: "Service"
        zPosition: "12"
        children:
          - convert:
              type: "ServiceName"
              text: "Reference"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1235,905"
        size: "645,2"
        text: ""
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/hddfree.png"
        position: "1235,935"
        scale: "1"
        size: "32,32"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "$list_font"
        halign: "left"
        name: "freeDiskSpace"
        position: "1290,935"
        size: "555,34"
