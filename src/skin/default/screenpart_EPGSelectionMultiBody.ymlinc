- xmlinc:
    file: "screenpart_Pig.ymlinc"
    position: "$width-354,7"
    size: "354,200"
- widget:
    font: "md_title_large"
    halign: "center"
    name: "date"
    position: "0,0"
    size: "1110,43"
    transparent: "1"
    valign: "center"
- widget:
    backgroundColor: "md_surface"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "list"
    position: "0,132"
    scrollbarMode: "showNever"
    setColGap: "20"
    setColWidths: "350,150"
    setEventItemFont: "md_body_medium"
    setEventTimeFont: "md_body_small"
    setIconDistance: "10"
    setTimeWidth: "135"
    sidesMargin: "25"
    size: "1110,eval(($height-132)/45*45)"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    backgroundColorSelected: "md_inverse_surface"
    borderColor: "md_surface"
    font: "md_title_large"
    foregroundColorSelected: "md_inverse_on_surface"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "bouquetlist"
    position: "0,132"
    scrollbarMode: "showNever"
    sidesMargin: "25"
    size: "1110,eval(($height-132)/45*45)"
    transparent: "0"
    zPosition: "4"
- eLabel:
    backgroundColor: "md_outline_variant"
    position: "1168,12"
    size: "1,870"
    zPosition: "-5"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_body_large"
    halign: "left"
    options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
    position: "1200,362"
    render: "COCRunningText"
    size: "645,490"
    source: "Event"
    transparent: "1"
    valign: "top"
    children:
      - convert:
          type: "EventName"
          text: "FullDescription"
- widget:
    alphatest: "blend"
    position: "1225,32"
    render: "Picon"
    size: "220,132"
    source: "Service"
    zPosition: "12"
    children:
      - convert:
          type: "ServiceName"
          text: "Reference"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_title_large"
    foregroundColor: "md_primary"
    halign: "left"
    noWrap: "1"
    position: "1200,301"
    render: "Label"
    size: "645,43"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          type: "EventName"
          text: "Name"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_title_small_emphasized"
    position: "1205,252"
    render: "Label"
    size: "160,30"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          nostrip: "1"
          type: "EventName"
          text: "  •  ,TIMERANGE"
- widget:
    alphatest: "blend"
    name: "now_button"
    pixmap: "border/epg_off.png"
    position: "120,52"
    size: "225,50"
    zPosition: "2"
- widget:
    alphatest: "blend"
    name: "now_button_sel"
    pixmap: "border/epg_now_on.png"
    position: "120,52"
    size: "225,50"
    zPosition: "3"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_small"
    halign: "center"
    name: "now_text"
    position: "120,57"
    size: "225,50"
    text: "NOW"
    transparent: "1"
    valign: "center"
    zPosition: "4"
- widget:
    alphatest: "blend"
    name: "next_button"
    pixmap: "border/epg_off.png"
    position: "435,52"
    size: "225,50"
    zPosition: "2"
- widget:
    alphatest: "blend"
    name: "next_button_sel"
    pixmap: "border/epg_next_on.png"
    position: "435,52"
    size: "225,50"
    zPosition: "3"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_small"
    halign: "center"
    name: "next_text"
    position: "435,57"
    size: "225,50"
    text: "NEXT"
    transparent: "1"
    valign: "center"
    zPosition: "4"
- widget:
    alphatest: "blend"
    name: "more_button"
    pixmap: "border/epg_off.png"
    position: "750,52"
    size: "225,50"
    zPosition: "2"
- widget:
    alphatest: "blend"
    name: "more_button_sel"
    pixmap: "border/epg_next_on.png"
    position: "750,52"
    size: "225,50"
    zPosition: "3"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_small"
    halign: "center"
    name: "more_text"
    position: "750,57"
    size: "225,50"
    text: "MORE"
    transparent: "1"
    valign: "center"
    zPosition: "4"
