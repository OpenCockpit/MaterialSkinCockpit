# The channel selection as a carousel: the screen of the setting "Channel selection" = "Carousel" (see PyServiceList.py, installCarousel). The
# classic one is "ChannelSelection".
screen:
  name: "ChannelSelectionCarousel"
  position: "fill"
  title: "Channel Selection"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - xmlinc:
        file: "screenpart_ChannelSelectionCarouselBody.ymlinc"
        position: "$window_full_body_x,$window_full_body_y"
        size: "$window_full_body_width,$window_full_body_height"
