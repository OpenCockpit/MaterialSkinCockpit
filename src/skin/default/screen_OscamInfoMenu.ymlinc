screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "OscamInfoMenu"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_1_1.ymlinc"
        position: "96,54"
    - widget:
        enableWrapAround: "1"
        font: "md_title_large"
        itemHeight: "45"
        name: "mainmenu"
        position: "125,150"
        scrollbarMode: "showNever"
        size: "1670,775"
        zPosition: "10"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "mainmenu"
        connection: "mainmenu"
        position: "125,935"
        size: "1670,25"
        transparent: "1"
