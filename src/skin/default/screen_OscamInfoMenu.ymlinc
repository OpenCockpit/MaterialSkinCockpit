screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "OscamInfoMenu"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        enableWrapAround: "1"
        font: "md_title_large"
        itemHeight: "45"
        name: "mainmenu"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showNever"
        size: "1670,775"
        zPosition: "10"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "mainmenu"
        connection: "mainmenu"
        position: "29,881"
        size: "1670,25"
        transparent: "1"
