screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PluginBrowser"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "252,111"
        size: "$window_wide_width,$window_wide_height"
        window_inset_x: "$window_wide_body_x"
    - xmlinc:
        file: "screenpart_PluginBrowserBody.ymlinc"
        position: "$window_wide_body_x,$window_wide_body_y"
        size: "$window_wide_body_width,$window_wide_body_height"
