- widget:
    backgroundColor: "md_surface"
    font: "md_headline_small_emphasized"
    halign: "left"
    position: "20,0"
    render: "Label"
    size: "400,50"
    source: "city"
- widget:
    backgroundColor: "md_surface"
    font: "md_headline_small_emphasized"
    halign: "left"
    position: "775,0"
    render: "Label"
    size: "130,50"
    source: "degreetype"
- widget:
    conditional: "entrylist"
    font: "md_body_medium"
    itemHeight: "$list_item_height"
    name: "entrylist"
    position: "0,50"
    scrollbarMode: "showNever"
    size: "$width,12*$list_item_height"
    valign: "center"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "20,765"
    size: "1630,25"
    connection: "entrylist"
