- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "list"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,eval(($height-235)/$list_item_height*$list_item_height)"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
- widget:
    conditional: "feedStatusMSG"
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    name: "feedStatusMSG"
    position: "0,eval(($height-235)/$list_item_height*$list_item_height)"
    size: "$width,$list_item_height"
    valign: "center"
    zPosition: "1000"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    name: "text"
    position: "0,$height-200"
    size: "$width,175"
    valign: "center"
    zPosition: "2"
