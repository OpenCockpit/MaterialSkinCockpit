- eLabel:
    backgroundColor: "md_outline_variant"
    position: "$width-685,5"
    size: "1,$height-5"
    zPosition: "-5"
- widget:
    font: "md_body_large"
    itemCornerRadius: "$radius_item"
    itemHeight: "50"
    name: "list"
    position: "0,0"
    scrollbarMode: "showOnDemand"
    size: "eval($width-750),eval(($height-175-15)/50*50)"
- widget:
    font: "md_body_large"
    foregroundColor: "md_primary"
    name: "text"
    position: "0,$height-175"
    size: "eval($width-750),175"
    valign: "bottom"
    zPosition: "2"
- xmlinc:
    file: "screenpart_FeedsStatus.ymlinc"
    position: "$width-690,65"
