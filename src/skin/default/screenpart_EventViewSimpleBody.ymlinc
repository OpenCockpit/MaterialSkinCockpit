- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "left"
    position: "0,0"
    render: "Label"
    size: "$width-200,70"
    source: "Service"
    valign: "top"
    children:
      - convert:
          type: "MovieInfo"
          text: "Name"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    foregroundColor: "md_tertiary"
    halign: "right"
    position: "$width-211,0"
    render: "Label"
    size: "200,80"
    source: "Event"
    valign: "top"
    zPosition: "1"
    children:
      - convert:
          type: "EventName"
          text: "Rating"
- widget:
    backgroundColor: "md_surface"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_on_surface"
    halign: "left"
    position: "0,47"
    render: "Label"
    size: "$width-590,50"
    source: "Service"
    transparent: "1"
    children:
      - convert:
          type: "MovieInfo"
          text: "RecordServiceName"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_small_emphasized"
    halign: "left"
    position: "0,$height-40"
    render: "Label"
    size: "340,40"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          type: "EventTime"
          text: "Times"
      - convert:
          type: "ClockToText"
          text: "LongFullDate,Default"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_small_emphasized"
    foregroundColor: "md_secondary"
    halign: "left"
    name: "duration"
    position: "340,$height-40"
    size: "340,40"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    foregroundColor: "md_tertiary"
    halign: "left"
    position: "685,$height-45"
    render: "Label"
    size: "670,45"
    source: "Event"
    zPosition: "1"
    children:
      - convert:
          type: "EventName"
          text: "Genre"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    halign: "block"
    name: "FullDescription"
    position: "0,116"
    scrollbarMode: "showNever"
    size: "$width,$height-339"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-198"
    size: "$width,25"
    connection: "FullDescription"
- widget:
    alphatest: "blend"
    backgroundColor: "md_surface"
    position: "$width-275,$height-170"
    render: "Picon"
    size: "227,130"
    source: "Service"
    transparent: "1"
    zPosition: "1"
    children:
      - convert:
          type: "MovieInfo"
          text: "RecordServiceRef"
