screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "SoftwareUpdateChoices"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - xmlinc:
        file: "screenpart_Pig.ymlinc"
        position: "1531,95"
        size: "354,200"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1195,100"
        size: "1,870"
        zPosition: "-5"
    - widget:
        font: "md_body_large"
        itemCornerRadius: "$radius_item"
        itemHeight: "50"
        name: "list"
        position: "20,95"
        scrollbarMode: "showOnDemand"
        size: "1110,550"
    - widget:
        font: "md_body_large"
        foregroundColor: "md_primary"
        name: "text"
        position: "20,695"
        size: "1110,175"
        valign: "bottom"
        zPosition: "2"
    - xmlinc:
        file: "screenpart_FeedsStatusTemplate.ymlinc"
        position: "1197,160"
