screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "SkinSelector"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_transparent"
        name: "preview"
        position: "397,436"
        size: "420,315"
    - widget:
        font: "md_body_small"
        position: "24,80"
        render: "Label"
        size: "0,0"
        source: "description"
        valign: "center"
    - widget:
        enableWrapAround: "1"
        itemCornerRadius: "$radius_item"
        position: "24,80"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,350"
        source: "skins"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (15, 0), size = (815, 45), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 1),
                                MultiContentEntryText(pos = (830, 0), size = (285, 45), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2)
                            ],
                            "fonts": [parseFont("md_body_medium")],
                            "itemHeight": 45
                        }
