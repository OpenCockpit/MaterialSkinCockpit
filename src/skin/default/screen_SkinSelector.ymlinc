screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "SkinSelector"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_transparent"
        name: "preview"
        position: "767,554"
        size: "420,315"
    - widget:
        font: "$hint_font"
        position: "394,198"
        render: "Label"
        size: "0,0"
        source: "description"
        valign: "center"
    - widget:
        enableWrapAround: "1"
        itemCornerRadius: "$radius_item"
        position: "394,198"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1130,350"
        source: "skins"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                		{
                			"template": [
                				MultiContentEntryText(pos = (15, 0), size = (815, 45), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 1),
                				MultiContentEntryText(pos = (830, 0), size = (285, 45), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2)
                			],
                			"fonts": [gFont("Regular", $text_font_size)],
                			"itemHeight": 45
                		}
