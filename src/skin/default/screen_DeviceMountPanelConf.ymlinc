screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "DeviceMountPanelConf"
  position: "fill"
  title: "UserManager"
  children:
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        itemHeight: "45"
        name: "config"
        position: "26,82"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,540"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "center"
        name: "Linconn"
        position: "30,707"
        size: "1050,30"
        transparent: "1"
        valign: "center"
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
