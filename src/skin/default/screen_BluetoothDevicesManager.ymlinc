screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "BluetoothDevicesManager"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_menu2.ymlinc"
        position: "495,136"
    - widget:
        enableWrapAround: "1"
        font: "$text_font"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "devicelist"
        position: "545,234"
        scrollbarMode: "showNever"
        size: "860,11*45"
        transparent: "1"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "devicelist"
        position: "545,750"
        size: "860,25"
        transparent: "1"
    - widget:
        alphatest: "blend"
        font: "$caption_font"
        foregroundColor: "md_primary"
        halign: "center"
        name: "ConnStatus"
        position: "545,780"
        size: "860,75"
        transparent: "1"
        valign: "center"
        zPosition: "1"
