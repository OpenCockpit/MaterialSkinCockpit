screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "BluetoothDevicesManager"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        enableWrapAround: "1"
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "devicelist"
        position: "50,98"
        scrollbarMode: "showNever"
        size: "860,11*45"
        transparent: "1"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "devicelist"
        position: "50,614"
        size: "860,25"
        transparent: "1"
    - widget:
        alphatest: "blend"
        font: "md_label_medium"
        foregroundColor: "md_primary"
        halign: "center"
        name: "ConnStatus"
        position: "50,644"
        size: "860,75"
        transparent: "1"
        valign: "center"
        zPosition: "1"
