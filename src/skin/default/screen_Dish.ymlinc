screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "Dish"
  position: "1500,75"
  size: "198,383"
  title: "Dish"
  zPosition: "-1"
  children:
    - widget:
        alphatest: "blend"
        name: "Dishpixmap"
        pixmap: "icons/dish.png"
        position: "0,60"
        size: "130,160"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "right"
        name: "turnTime"
        position: "45,75"
        size: "150,38"
        transparent: "1"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "right"
        name: "From"
        position: "0,240"
        size: "83,38"
        transparent: "1"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "posFrom"
        position: "93,240"
        size: "105,38"
        transparent: "1"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "right"
        name: "Goto"
        position: "0,273"
        size: "83,38"
        transparent: "1"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "posGoto"
        position: "93,273"
        size: "105,38"
        transparent: "1"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "Tuner"
        position: "0,306"
        size: "83,38"
        transparent: "1"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "tunerName"
        position: "93,306"
        size: "105,38"
        transparent: "1"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "turnSpeed"
        position: "0,330"
        size: "180,38"
        transparent: "1"
        zPosition: "2"
    - widget:
        backgroundColor: "md_on_surface"
        borderWidth: "2"
        position: "0,366"
        render: "Progress"
        size: "180,15"
        source: "session.FrontendStatus"
        zPosition: "2"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNR"
