screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MovieContextMenu"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        conditional: "config"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "config"
        position: "17,79"
        scrollbarMode: "showNever"
        size: "$window_small_content_width,635"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "config"
        connection: "config"
        position: "17,713"
        size: "$window_small_content_width,25"
        transparent: "1"
    - widget:
        conditional: "menu"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menu"
        position: "17,79"
        scrollbarMode: "showNever"
        size: "$window_small_content_width,635"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "menu"
        connection: "menu"
        position: "17,713"
        size: "$window_small_content_width,25"
        transparent: "1"
