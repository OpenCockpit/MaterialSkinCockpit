screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MovieContextMenu"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_menu2.ymlinc"
        position: "495,136"
    - widget:
        conditional: "config"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "config"
        position: "512,215"
        scrollbarMode: "showNever"
        size: "889,635"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "config"
        connection: "config"
        position: "512,849"
        size: "889,25"
        transparent: "1"
    - widget:
        conditional: "menu"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menu"
        position: "512,215"
        scrollbarMode: "showNever"
        size: "889,635"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "menu"
        connection: "menu"
        position: "512,849"
        size: "889,25"
        transparent: "1"
