- widget:
    backgroundColor: "md_surface_container_highest"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "filelist"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,eval($height/$list_item_height*$list_item_height)"
    transparent: "1"
    zPosition: "3"
