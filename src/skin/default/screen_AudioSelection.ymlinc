screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AudioSelection"
  position: "fill"
  title: "Audio"
  children:
    - xmlinc:
        file: "screenpart_Screen_menu2.ymlinc"
        position: "495,136"
    - widget:
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "config"
        position: "545,234"
        scrollbarMode: "showNever"
        scrollbarSliderBorderColor: "md_surface_container_lowest"
        scrollbarSliderBorderWidth: "0"
        scrollbarSliderForegroundColor: "md_on_surface_variant"
        scrollbarWidth: "3"
        size: "860,180"
        transparent: "1"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "config"
        position: "545,424"
        size: "860,25"
        transparent: "1"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "515,460"
        size: "889,2"
        zPosition: "-5"
    - widget:
        enableWrapAround: "1"
        itemCornerRadius: "$radius_item"
        position: "515,495"
        render: "Listbox"
        scrollbarMode: "showNever"
        scrollbarSliderBorderColor: "md_surface_container_lowest"
        scrollbarSliderBorderWidth: "0"
        scrollbarSliderForegroundColor: "md_on_surface_variant"
        scrollbarWidth: "3"
        size: "889,320"
        source: "streams"
        transparent: "1"
        zPosition: "3"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {"templates":
                                                                                                            {"default": ( 45, [
                                                                                                                MultiContentEntryText(pos = (25, 2), size = (60, 40), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2), # key,
                                MultiContentEntryText(pos = (90, 2), size = (310, 40), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = 3), # description,
                                MultiContentEntryText(pos = (420, 2), size = (400, 40), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 4), # language,
                                MultiContentEntryPixmapAlphaBlend(pos = (840, 6), size = (32, 32), png = 6), # selection,
                            ], True, "showNever"),
                                                                                                            "notselected": (45, [
                                                                                                                MultiContentEntryText(pos = (25, 2), size = (60, 40), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2), # key,
                                MultiContentEntryText(pos = (90, 2), size = (310, 40), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = 3), # description,
                                MultiContentEntryText(pos = (420, 2), size = (400, 40), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 4), # language,
                                MultiContentEntryPixmapAlphaBlend(pos = (840, 6), size = (32, 32), png = 6), # selection,
                                                                                                            ], False, "showNever"),
                                                                                                            "subs": (45, [
                                                                                                                MultiContentEntryText(pos = (25, 2), size = (60, 40), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2), # key,
                                MultiContentEntryText(pos = (90, 2), size = (310, 40), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = 3), # description,
                                MultiContentEntryText(pos = (420, 2), size = (400, 40), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 4), # language,
                                MultiContentEntryPixmapAlphaBlend(pos = (840, 6), size = (32, 32), png = 6), # selection,
                                                                                                            ], True, "showNever"),
                                                                                                            "subs_notselected": (45, [
                                                                                                                MultiContentEntryText(pos = (25, 2), size = (60, 40), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2), # key,
                                MultiContentEntryText(pos = (90, 2), size = (310, 40), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = 3), # description,
                                MultiContentEntryText(pos = (420, 2), size = (400, 40), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 4), # language,
                                MultiContentEntryPixmapAlphaBlend(pos = (840, 6), size = (32, 32), png = 6), # selection,
                                                                                                            ], False, "showNever")
                                                                                                            },
                            "fonts": [parseFont("md_body_medium"), parseFont("md_body_medium")],
                            "itemHeight": 45
                        }
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "streams"
        position: "545,835"
        size: "860,25"
        transparent: "1"
    - widget:
        alphatest: "on"
        backgroundColor: "md_key_red"
        position: "535,239"
        render: "FixedLabel"
        size: "4,35"
        source: "key_red"
        zPosition: "2"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "on"
        backgroundColor: "md_key_green"
        position: "535,285"
        render: "FixedLabel"
        size: "4,35"
        source: "key_green"
        zPosition: "2"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "on"
        backgroundColor: "md_key_yellow"
        position: "535,330"
        render: "FixedLabel"
        size: "4,35"
        source: "key_yellow"
        zPosition: "2"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "on"
        backgroundColor: "md_key_blue"
        position: "535,375"
        render: "FixedLabel"
        size: "4,35"
        source: "key_blue"
        zPosition: "2"
        children:
          - convert:
              type: "ConditionalShowHide"
