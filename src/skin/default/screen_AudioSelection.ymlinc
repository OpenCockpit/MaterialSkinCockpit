screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AudioSelection"
  position: "fill"
  title: "Audio"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_small_width,$window_small_height"
        window_inset_x: "$window_small_body_x"
    - xmlinc:
        file: "screenpart_AudioSelectionBody.ymlinc"
        position: "$window_small_body_x,$window_small_body_y"
        size: "$window_small_body_width,$window_small_body_height"
