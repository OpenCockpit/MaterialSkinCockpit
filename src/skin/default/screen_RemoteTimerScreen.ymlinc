screen:
  flags: "wfNoBorder"
  name: "RemoteTimerScreen"
  position: "fill"
  title: "Timer Overview"
  children:
    - xmlinc:
        file: "screenpart_Screen_1_1.ymlinc"
        position: "96,54"
    - widget:
        iconMargin: "30"
        itemHeight: "90"
        name: "timerlist"
        position: "135,160"
        rowSplit: "45"
        satPosLeft: "250"
        scrollbarMode: "showNever"
        setEventNameFont: "md_title_large"
        setFont: "md_body_medium"
        setServiceNameFont: "md_body_medium"
        sidesMargin: "20"
        size: "1650,6*90"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "timerlist"
        position: "145,915"
        size: "1630,25"
        transparent: "1"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "135,720"
        size: "1650,2"
        zPosition: "-7"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "center"
        name: "text"
        position: "145,730"
        size: "1620,150"
        valign: "center"
