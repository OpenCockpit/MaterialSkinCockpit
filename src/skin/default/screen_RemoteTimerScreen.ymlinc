screen:
  flags: "wfNoBorder"
  name: "RemoteTimerScreen"
  position: "fill"
  title: "Timer Overview"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        iconMargin: "30"
        itemHeight: "90"
        name: "timerlist"
        position: "39,106"
        rowSplit: "45"
        satPosLeft: "250"
        scrollbarMode: "showNever"
        setEventNameFont: "md_title_large"
        setFont: "md_body_medium"
        setServiceNameFont: "md_body_medium"
        sidesMargin: "20"
        size: "1650,6*90"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "timerlist"
        position: "$window_large_margin,861"
        size: "$window_large_inner_width,25"
        transparent: "1"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "39,666"
        size: "1650,2"
        zPosition: "-7"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "center"
        name: "text"
        position: "$window_large_margin,676"
        size: "1620,140"
        valign: "center"
