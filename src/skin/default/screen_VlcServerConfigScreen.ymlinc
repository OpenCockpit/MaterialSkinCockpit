screen:
  name: "VlcServerConfigScreen"
  position: "fill"
  title: ""
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - eLabel:
        backgroundColor: "md_surface"
        font: "md_display_small"
        foregroundColor: "md_on_surface"
        halign: "left"
        origin: "screen"
        position: "87,54"
        size: "1200,75"
        text: "VLC Video Player"
        transparent: "1"
    - xmlinc:
        file: "screenpart_VlcServerConfigScreenBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y"
        size: "$window_large_body_width,$window_large_body_height"
