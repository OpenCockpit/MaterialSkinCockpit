screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "JobView"
  position: "fill"
  title: "Job View"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_title_large"
        position: "35,128"
        render: "Label"
        size: "1110,52"
        source: "job_name"
    - widget:
        font: "md_title_large"
        position: "38,237"
        render: "Label"
        size: "1110,45"
        source: "job_task"
    - widget:
        backgroundColor: "md_primary_container_translucent"
        borderWidth: "2"
        position: "38,340"
        render: "Progress"
        size: "1110,54"
        source: "job_progress"
    - widget:
        font: "md_headline_medium"
        foregroundColor: "md_shadow"
        halign: "center"
        position: "35,343"
        render: "Label"
        size: "1110,50"
        source: "job_progress"
        transparent: "1"
        zPosition: "2"
        children:
          - convert:
              type: "ProgressToText"
    - widget:
        font: "md_title_large"
        position: "38,452"
        render: "Label"
        size: "1110,43"
        source: "job_status"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        name: "config"
        position: "38,557"
        size: "1110,36"
