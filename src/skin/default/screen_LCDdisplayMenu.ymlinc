screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "LCDdisplayMenu"
  position: "fill"
  title: "LCD4linux - Config"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        enableWrapAround: "1"
        font: "md_body_large"
        foregroundColor: "md_on_surface_variant"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menu"
        position: "20,94"
        scrollbarMode: "showOnDemand"
        scrollbarSliderBorderColor: "md_primary"
        scrollbarSliderBorderWidth: "1"
        scrollbarSliderForegroundColor: "md_primary"
        scrollbarWidth: "5"
        size: "$window_small_content_width,592"
