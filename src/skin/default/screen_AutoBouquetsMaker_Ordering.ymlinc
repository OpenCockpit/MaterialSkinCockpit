screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoBouquetsMaker_Ordering"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        position: "$window_medium_content_x,$window_medium_content_y"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1130,14*45"
        source: "list"
        transparent: "0"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (18, 0), size = (1060, 45), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 0),
                            ],
                            "fonts": [parseFont("md_body_medium")],
                            "itemHeight": 45
                        }
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
