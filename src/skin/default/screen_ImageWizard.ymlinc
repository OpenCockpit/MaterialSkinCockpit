screen:
  flags: "wfNoBorder"
  name: "ImageWizard"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - eLabel:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_title_large"
        halign: "left"
        position: "25,2"
        size: "1830,60"
        text: "Welcome..."
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - xmlinc:
        file: "screenpart_ImageWizardBody.ymlinc"
        position: "$window_full_body_x,$window_full_body_y"
        size: "$window_full_body_width,$window_full_body_height"
