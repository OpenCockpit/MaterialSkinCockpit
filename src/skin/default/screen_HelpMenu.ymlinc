screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "HelpMenu"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_1_1.ymlinc"
        position: "96,54"
    - widget:
        conditional: "arrowdown"
        font: "md_body_medium"
        itemHeight: "38"
        name: "list"
        position: "125,150"
        scrollbarMode: "showNever"
        size: "1200,20*38"
    - widget:
        conditional: "long_key"
        font: "md_label_large"
        foregroundColor: "md_primary"
        halign: "center"
        name: "long_key"
        position: "1430,800"
        size: "375,30"
    - widget:
        conditional: "longshift_key1"
        font: "md_label_large"
        foregroundColor: "md_primary"
        halign: "center"
        name: "longshift_key0"
        position: "1430,800"
        size: "375,30"
    - widget:
        conditional: "longshift_key1"
        font: "md_label_large"
        foregroundColor: "md_primary"
        halign: "center"
        name: "longshift_key1"
        position: "1430,830"
        size: "375,30"
    - xmlinc:
        file: "screenpart_HelpMenuPanel.ymlinc"
        position: "1550,275"
        size: "154,500"
    - widget:
        conditional: "indicatorU0"
        position: "125,150"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1300,743"
        source: "list"
        transparent: "0"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                		{
                																					"templates": {
                																						# Simple help with no headings ("flat")
                																						# data[1:] = [helpText]
                																						"default": [
                																						57,  # itemHeight
                																						[
                																						MultiContentEntryText(pos=(0,6), size=(1100,57), font=1, text=1),
                																						]
                			],
                																						# Simple help with headings
                																						# data[1:] = [heading, None]  # For heading entries
                																						# data[1:] = [None, helpText]  # For help entries
                																						"default+headings": [  # data[1:] = [helpText]
                																						57,  # itemHeight
                																						[
                																						MultiContentEntryText(pos=(0,6), size=(1100,57), font=0, text=1),
                				MultiContentEntryText(pos=(30,6), size=(1070,57), font=1, text=2),
                																						]
                																						],
                																						# Extended help with no headings
                																						# data[1:] = [helpText, extendedHelpText]
                																						"extended": [
                																						86,  # itemHeight
                																						[
                																						MultiContentEntryText(pos=(0,0), size=(1100,45), font=2, text=1),
                				MultiContentEntryText(pos=(0,60), size=(1100,40), color="md_on_surface_variant", font=3, text=2),
                																						],
                																						],
                																						# Extended help with headings
                																						# data[1:] = [heading, None, None]  # For heading entries
                																						# data[1:] = [None, helpText, extendedHelpText]  # For help entries
                																						"extended+headings": [
                																						86,  # itemHeight
                																						[
                																						MultiContentEntryText(pos=(0,14), size=(1100,48), font=0, text=1),
                				MultiContentEntryText(pos=(30,0), size=(1070,45), font=2, text=2),
                				MultiContentEntryText(pos=(30,45), size=(1070,40), color="md_on_surface_variant", font=3, text=3),
                																						],
                																						],
                																					},
                			"fonts": [parseFont("md_headline_medium"), parseFont("md_headline_small"), parseFont("md_headline_medium"), parseFont("md_headline_medium")],
                			"itemHeight": 57
                		}
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        position: "396,915"
        size: "1130,25"
        transparent: "1"
