screen:
  name: "AutoMountView"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_AutoMountViewBody.ymlinc"
        position: "$window_large_body_x+221,$window_large_body_y"
        width: "$window_large_body_width-221"
        height: "$window_large_body_height"
