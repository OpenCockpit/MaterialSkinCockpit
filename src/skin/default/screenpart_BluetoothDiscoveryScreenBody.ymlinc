- widget:
    itemHeight: "$list_item_height"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,13*$list_item_height"
    source: "deviceList"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (80, 0), size = (1000, 40), font=1, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 0), # index 0 is Name
                                                                                                MultiContentEntryPixmapAlphaTest(pos = (10, 10), size = (50, 50), png = 1), # index 1 is bt_icon
                        ],
                        "fonts": [parseFont("md_headline_medium"), parseFont("md_body_medium") , parseFont("md_body_small"), parseFont("md_label_medium")],
                        "itemHeight": 70
                    }
