- widget:
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height_icon"
    position: "0,0"
    render: "Listbox"
    size: "$width,eval(($height-25)/$list_item_height_icon*$list_item_height_icon)"
    source: "deviceList"
    children:
      - xmlinc:
          file: "screenpart_RowIconText.ymlinc"
          row_icon: "1"
          row_text: "0"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "deviceList"
