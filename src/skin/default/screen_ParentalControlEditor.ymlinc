screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "ParentalControlEditor"
  position: "fill"
  title: "Parental control services Editor"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        enableWrapAround: "1"
        itemHeight: "45"
        name: "servicelist"
        position: "22,81"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,$window_medium_list_height"
        transparent: "1"
