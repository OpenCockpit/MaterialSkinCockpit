screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "ServiceInfo"
  position: "fill"
  children:
    - xmlinc:
        file: "screen_ServiceInfoSimple.ymlinc"
        position: "0,0"
    - widget:
        font: "md_title_large"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "290,846"
        render: "Label"
        size: "1153,37"
        source: "session.CurrentService"
        transparent: "1"
        valign: "top"
        zPosition: "1"
        children:
          - convert:
              type: "ServiceInfo"
              text: "HasHBBTV"
