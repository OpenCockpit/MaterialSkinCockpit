- widget:
    DayNameFont: "md_body_large"
    EventNameFont: "md_title_large"
    ServiceNameFont: "md_title_large"
    iconMargin: "20"
    itemCornerRadius: "$radius_item"
    itemHeight: "90"
    name: "entries"
    position: "0,0"
    rowHeight: "42"
    rowSplit1: "50"
    rowSplit2: "45"
    scrollbarMode: "showNever"
    size: "$width,720"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "30,$height-25"
    size: "1630,25"
    connection: "entries"
