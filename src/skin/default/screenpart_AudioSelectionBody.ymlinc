- widget:
    backgroundColor: "md_surface"
    enableWrapAround: "1"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "30,0"
    scrollbarMode: "showNever"
    scrollbarSliderBorderColor: "md_surface_container_lowest"
    scrollbarSliderBorderWidth: "0"
    scrollbarSliderForegroundColor: "md_on_surface_variant"
    scrollbarWidth: "5"
    size: "$width-30,4*$list_item_height"
    transparent: "1"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "30,190"
    size: "$width-30,25"
    connection: "config"
- eLabel:
    backgroundColor: "md_surface_container_highest"
    position: "0,226"
    size: "$width,2"
    zPosition: "-5"
- widget:
    enableWrapAround: "1"
    itemCornerRadius: "$radius_item"
    position: "0,261"
    render: "Listbox"
    scrollbarMode: "showNever"
    scrollbarSliderBorderColor: "md_surface_container_lowest"
    scrollbarSliderBorderWidth: "0"
    scrollbarSliderForegroundColor: "md_on_surface_variant"
    scrollbarWidth: "5"
    size: "$width,7*$list_item_height"
    source: "streams"
    transparent: "1"
    zPosition: "3"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {"templates":
                                                                                                        {"default": ( 45, [
                                                                                                            MultiContentEntryText(pos = (25, 2), size = (60, 40), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2), # key,
                            MultiContentEntryText(pos = (90, 2), size = (310, 40), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = 3), # description,
                            MultiContentEntryText(pos = (420, 2), size = (400, 40), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 4), # language,
                            MultiContentEntryPixmapAlphaBlend(pos = (840, 6), size = (32, 32), png = 6), # selection,
                        ], True, "showNever"),
                                                                                                        "notselected": (45, [
                                                                                                            MultiContentEntryText(pos = (25, 2), size = (60, 40), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2), # key,
                            MultiContentEntryText(pos = (90, 2), size = (310, 40), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = 3), # description,
                            MultiContentEntryText(pos = (420, 2), size = (400, 40), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 4), # language,
                            MultiContentEntryPixmapAlphaBlend(pos = (840, 6), size = (32, 32), png = 6), # selection,
                                                                                                        ], False, "showNever"),
                                                                                                        "subs": (45, [
                                                                                                            MultiContentEntryText(pos = (25, 2), size = (60, 40), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2), # key,
                            MultiContentEntryText(pos = (90, 2), size = (310, 40), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = 3), # description,
                            MultiContentEntryText(pos = (420, 2), size = (400, 40), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 4), # language,
                            MultiContentEntryPixmapAlphaBlend(pos = (840, 6), size = (32, 32), png = 6), # selection,
                                                                                                        ], True, "showNever"),
                                                                                                        "subs_notselected": (45, [
                                                                                                            MultiContentEntryText(pos = (25, 2), size = (60, 40), font = 0, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER, text = 2), # key,
                            MultiContentEntryText(pos = (90, 2), size = (310, 40), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = 3), # description,
                            MultiContentEntryText(pos = (420, 2), size = (400, 40), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 4), # language,
                            MultiContentEntryPixmapAlphaBlend(pos = (840, 6), size = (32, 32), png = 6), # selection,
                                                                                                        ], False, "showNever")
                                                                                                        },
                        "fonts": [parseFont("md_body_medium"), parseFont("md_body_medium")],
                        "itemHeight": 45
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "30,601"
    size: "$width-30,25"
    connection: "streams"
- widget:
    alphatest: "on"
    backgroundColor: "md_key_red"
    position: "20,5"
    render: "FixedLabel"
    size: "4,35"
    source: "key_red"
    zPosition: "2"
    children:
      - convert:
          type: "ConditionalShowHide"
