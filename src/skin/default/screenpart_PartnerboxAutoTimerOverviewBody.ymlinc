- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "entries"
    position: "0,35"
    scrollbarMode: "showOnDemand"
    size: "$width,12*$list_item_height"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "entries"
