# The language of a wizard: the red key switches to the next language (WizardLanguage.red), and `languagetext` names the
# active one. The wizards have no other elements for it (an earlier "back / next language" design, with the widgets
# backtext and nexttext, is not in enigma2 any more: a widget the screen does not have is a SkinError).
screen:
  name: "WizardPictureLang"
  children:
    - ePixmap:
        alphatest: "blend"
        pixmap: "buttons/key_red.png"
        position: "0,$height-85"
        size: "40,20"
        transparent: "1"
        zPosition: "0"
    - widget:
        font: "md_title_large"
        name: "languagetext"
        position: "50,$height-100"
        size: "350,50"
