screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "NetworkMountsMenu"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menulist"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showNever"
        sidesMargin: "20"
        size: "1670,13*45"
        zPosition: "10"
    - widget:
        font: "md_body_medium"
        foregroundColor: "md_primary"
        halign: "center"
        position: "$window_large_margin,809"
        render: "Label"
        size: "$window_large_inner_width,35"
        source: "introduction"
        valign: "center"
        zPosition: "10"
