screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "EPGImportConfig"
  position: "fill"
  title: "EPG Import Configuration"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "config"
        position: "396,210"
        scrollbarMode: "showNever"
        size: "1130,500"
        valign: "center"
    - widget:
        backgroundColor: "md_surface"
        connection: "config"
        pagerBackground: "md_surface"
        pagerForeground: "md_on_surface"
        position: "396,730"
        render: "Pager"
        size: "1130,25"
        transparent: "1"
    - widget:
        font: "md_body_large"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "description"
        position: "396,653"
        size: "0,0"
        valign: "top"
    - widget:
        font: "md_body_large"
        name: "statusbar"
        position: "396,856"
        size: "1110,34"
    - widget:
        font: "md_body_large"
        name: "status"
        position: "396,770"
        size: "1110,90"
