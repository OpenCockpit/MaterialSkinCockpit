screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "HddSetup"
  position: "fill"
  title: "Hard Drive Setup"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        foregroundColor: "md_on_surface"
        position: "396,200"
        render: "Listbox"
        size: "990,836"
        source: "menu"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryPixmapAlphaTest(pos = (8, 0), size = (72, 72), png = 0),
                                MultiContentEntryText(pos = (98, 8), size = (1193, 60), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_TOP, text = 1),
                                MultiContentEntryText(pos = (1410, 8), size = (360, 60), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_TOP, text = 2),
                            ],
                            "fonts": [parseFont("md_headline_medium")],
                            "itemHeight": 75
                        }
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        halign: "center"
        name: "lab1"
        position: "530,294"
        size: "900,60"
        transparent: "1"
        zPosition: "2"
