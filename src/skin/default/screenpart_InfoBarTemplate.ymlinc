screen:
  name: "InfoBarTemplate"
  children:
    - eLabel:
        backgroundColor: "md_surface_container_high"
        cornerRadius: "$radius_infobar"
        position: "0,0"
        size: "1839,184"
        zPosition: "-11"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_infobar_inner"
        position: "332,2"
        size: "1505,180"
        zPosition: "-10"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "342,53"
        size: "1485,2"
        zPosition: "-9"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "1592,68"
        size: "2,100"
        zPosition: "-9"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_surface_overlay_soft"
        position: "52,29"
        render: "Picon"
        size: "227,130"
        source: "session.CurrentService"
        transparent: "1"
        zPosition: "1"
        children:
          - convert:
              type: "ServiceName"
              text: "Reference"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        foregroundColor: "md_on_surface"
        halign: "left"
        noWrap: "1"
        position: "352,2"
        render: "Label"
        size: "1200,51"
        source: "session.CurrentService"
        valign: "center"
        zPosition: "100"
        children:
          - convert:
              nostrip: "1"
              type: "ServiceName"
              text: "  •  ,NUMBER,NAME,ORBPOS,PROVIDER"
    - widget:
        addon: "ServiceInfoBar"
        alignment: "right"
        autoresizeMode: "condensed"
        backgroundColor: "md_surface"
        connection: "session"
        elements: "gamma,videoRes,separator,crypt,currentCrypto,separator,txt,dolby,audiotrack,subtitletrack,subservices,stream,hbbtv,separator,catchup,separator,servicetype,separator,record"
        font: "md_title_small_emphasized"
        foregroundColor: "md_success"
        permanent: "videoRes,crypt,currentCrypto"
        pixmaps: "IS_HDR:icons/hdr_on.png,IS_HDR10:icons/hdr10_on.png,IS_HLG:icons/hlg_on.png,IS_HD:icons/HD_s_n.png,IS_4K:icons/4K_s_n.png,IS_SD:icons/SD_s_n.png,txt:icons/ico_txt_on.png,dolby:icons/dd_s.png,crypt:icons/crypt.png,IS_CRYPT:icons/crypt.png,IS_CRYPT_CSA:icons/cryptscsa.png,audiotrack:icons/ml_s_alt2.png,subtitletrack:icons/subs_s.png,hbbtv:icons/hbbtv_s.png,subservices:icons/ico_subs_on.png,stream:icons/streaming.png,record:icons/rec2.png,catchup:icons/ico_catchup.png,sat:icons/satdish.png,cable:icons/ico_dvb-c.png,terestrial:icons/ico_dvb-t.png,iptv:icons/ico_stream.png"
        pixmapsDisabled: "crypt:icons/crypt_off.png"
        position: "1162,15"
        separatorLineColor: "md_outline_variant"
        separatorLineThickness: "1"
        size: "658,26"
        spacing: "20"
        transparent: "1"
        zPosition: "110"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_secondary"
        halign: "left"
        noWrap: "1"
        position: "352,73"
        render: "Label"
        size: "80,36"
        source: "session.Event_Now"
        transparent: "1"
        zPosition: "3"
        children:
          - convert:
              type: "EventTime"
              text: "StartTime"
          - convert:
              type: "ClockToText"
              text: "Default"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "md_display_medium_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1552,54"
        render: "Label"
        size: "320,70"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        zPosition: "20"
        children:
          - convert:
              type: "COCServicePosition"
              text: "EndTime,ShowNoSeconds"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1552,130"
        render: "Label"
        size: "320,45"
        source: "global.CurrentTime"
        transparent: "1"
        valign: "center"
        zPosition: "20"
        children:
          - convert:
              type: "ClockToText"
              text: "Format: %d %B %Y"
    - eLabel:
        backgroundColor: "md_surface_container"
        position: "352,117"
        size: "1220,4"
        transparent: "0"
        zPosition: "4"
    - widget:
        cornerRadius: "$radius_bar_thick"
        foregroundColor: "md_primary"
        position: "352,115"
        render: "Progress"
        size: "1220,8"
        source: "session.Event_Now"
        transparent: "1"
        zPosition: "5"
        children:
          - convert:
              type: "EventTime"
              text: "Progress"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_body_large"
        foregroundColor: "md_primary"
        halign: "left"
        position: "462,68"
        render: "Label"
        size: "980,38"
        source: "session.Event_Now"
        transparent: "1"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_title_medium_emphasized"
        halign: "left"
        noWrap: "1"
        position: "432,73"
        render: "FixedLabel"
        size: "20,36"
        source: "session.Event_Now"
        text: "•"
        transparent: "1"
        children:
          - convert:
              type: "EventName"
              text: "Name"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_secondary"
        halign: "right"
        position: "1324,73"
        render: "Label"
        size: "250,36"
        source: "session.Event_Now"
        transparent: "1"
        children:
          - convert:
              type: "EventTime"
              text: "Remaining"
          - convert:
              type: "RemainingToText"
              text: "InMinutes"
    - widget:
        backgroundColor: "md_shadow"
        font: "md_title_medium_emphasized"
        halign: "left"
        noWrap: "1"
        position: "352,136"
        render: "Label"
        size: "80,36"
        source: "session.Event_Next"
        transparent: "1"
        children:
          - convert:
              type: "EventTime"
              text: "StartTime"
          - convert:
              type: "ClockToText"
              text: "Default"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_title_medium_emphasized"
        halign: "left"
        noWrap: "1"
        position: "432,136"
        render: "FixedLabel"
        size: "20,36"
        source: "session.Event_Next"
        text: "•"
        transparent: "1"
        children:
          - convert:
              type: "EventName"
              text: "Name"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_body_large"
        halign: "left"
        noWrap: "1"
        position: "462,131"
        render: "Label"
        size: "980,38"
        source: "session.Event_Next"
        transparent: "1"
        zPosition: "2"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_title_medium_emphasized"
        halign: "right"
        position: "1324,136"
        render: "Label"
        size: "250,36"
        source: "session.Event_Next"
        transparent: "1"
        children:
          - convert:
              type: "EventTime"
              text: "Duration"
          - convert:
              type: "ClockToText"
              text: "InMinutes"
