screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "SecondInfoBar"
  position: "fill"
  title: "Second InfoBar"
  children:
    - xmlinc:
        file: "screenpart_SecondInfoBar.ymlinc"
        position: "96,54"
    - widget:
        backgroundColor: "md_surface"
        borderColor: "md_shadow"
        borderWidth: "1"
        font: "md_label_medium"
        position: "433,899"
        render: "FixedLabel"
        size: "75,26"
        source: "session.FrontendStatus"
        text: "SNR"
        zPosition: "2"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNR"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface"
        borderColor: "md_outline"
        borderWidth: "1"
        cornerRadius: "$radius_bar"
        foregroundColor: "md_on_surface_variant"
        position: "430,927"
        render: "Progress"
        size: "300,6"
        source: "session.FrontendStatus"
        zPosition: "1"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNR"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "md_surface"
        borderColor: "md_shadow"
        borderWidth: "1"
        font: "md_label_medium"
