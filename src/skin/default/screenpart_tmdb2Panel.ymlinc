- widget:
    conditional: "data"
    font: "md_label_medium"
    name: "data"
    position: "0,0"
    size: "0,0"
- widget:
    conditional: "list"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "list"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "830,15*$list_item_height"
    transparent: "1"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,677"
    size: "830,25"
    connection: "list"
