screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "EPGSearchSetup"
  position: "fill"
  title: "EPGSearch Setup"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        backgroundColor: "md_surface"
        font: "$list_font"
        position: "30,570"
        render: "Label"
        size: "0,0"
        source: "help"
        transparent: "1"
