- widget:
    conditional: "list"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "list"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,13*$list_item_height"
- widget:
    conditional: "lab1"
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    name: "lab1"
    position: "20,$height-185"
    size: "$width-40,100"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- widget:
    conditional: "backupstatus"
    font: "md_body_medium"
    foregroundColor: "md_warning"
    halign: "center"
    name: "backupstatus"
    position: "20,$height-75"
    size: "$width-40,40"
    valign: "center"
    zPosition: "5"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "20,$height-25"
    size: "$width-40,25"
    connection: "list"
