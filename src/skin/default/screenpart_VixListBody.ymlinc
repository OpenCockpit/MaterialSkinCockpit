- widget:
    conditional: "list"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "list"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,eval(($height-137)/$list_item_height*$list_item_height)"
- widget:
    conditional: "lab1"
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    name: "lab1"
    position: "0,$height-137"
    size: "$width,72"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- widget:
    conditional: "backupstatus"
    font: "md_body_medium"
    foregroundColor: "md_warning"
    halign: "center"
    name: "backupstatus"
    position: "0,$height-65"
    size: "$width,40"
    valign: "center"
    zPosition: "5"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
