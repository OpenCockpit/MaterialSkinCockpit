- widget:
    backgroundColor: "md_transparent"
    name: "Video"
    position: "740,17"
    size: "1044,566"
    zPosition: "1"
- widget:
    font: "md_title_large"
    halign: "center"
    position: "740,609"
    render: "Label"
    size: "1044,75"
    source: "session.CurrentService"
    valign: "center"
    children:
      - convert:
          type: "ServiceName"
          text: "Name"
- widget:
    font: "md_body_large"
    halign: "center"
    position: "740,686"
    render: "Label"
    size: "1044,42"
    source: "session.CurrentService"
    valign: "center"
    zPosition: "1"
    children:
      - convert:
          type: "ServicePosition"
          text: "Position,Detailed"
- widget:
    font: "md_body_large"
    halign: "center"
    name: "SeekState"
    position: "740,729"
    size: "1044,38"
    valign: "center"
    zPosition: "1"
- widget:
    enableWrapAround: "1"
    itemCornerRadius: "$radius_item"
    position: "74,17"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "430,750"
    source: "cutlist"
    zPosition: "1"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(size=(188,30), text = 1, backcolor = MultiContentTemplateColor(3)),
                            MultiContentEntryText(pos=(198,0), size=(75,30), text = 2, flags = RT_HALIGN_RIGHT, backcolor = MultiContentTemplateColor(3))
                        ],
                        "fonts": [parseFont("md_body_small")],
                        "itemHeight": 30
                    }
- widget:
    backgroundColor: "md_on_surface_variant"
    foregroundColor: "md_shadow"
    name: "Timeline"
    pointer: "skin_default/position_arrow.png:3,5"
    position: "74,824"
    size: "1712,30"
