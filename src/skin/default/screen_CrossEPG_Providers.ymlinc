screen:
  flags: "wfNoBorder"
  name: "CrossEPG_Providers"
  position: "fill"
  title: "CrossEPG Providers"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_medium_width,$window_medium_height"
        window_inset_x: "$window_medium_body_x"
    - xmlinc:
        file: "screenpart_CrossEPG_ProvidersBody.ymlinc"
        position: "$window_medium_body_x,$window_medium_body_y"
        size: "$window_medium_body_width,$window_medium_body_height"
