screen:
  flags: "wfNoBorder"
  name: "CrossEPG_Providers"
  position: "fill"
  title: "CrossEPG Providers"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        position: "$window_medium_content_x,$window_medium_content_y"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1130,10*60"
        source: "list"
        transparent: "0"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (18, 0), size = (660, 60), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 0),
                                MultiContentEntryPixmapAlphaTest(pos = (1060, 10), size = (60, 60), png = 1),
                            ],
                            "fonts": [parseFont("md_body_large")],
                            "itemHeight": 60
                        }
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
