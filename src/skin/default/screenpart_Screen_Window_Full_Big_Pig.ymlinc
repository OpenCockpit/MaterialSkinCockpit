screen:
  name: "Screen_Window_Full_Big_Pig"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full.ymlinc"
        position: "0,0"
    - widget:
        backgroundColor: "md_surface_overlay_strong"
        cornerRadius: "$radius_video"
        position: "1450,95"
        render: "Pig"
        size: "435,248"
        source: "session.VideoPicture"
        widgetBorderColor: "md_surface_container_high"
        widgetBorderWidth: "2"
        zPosition: "10"
