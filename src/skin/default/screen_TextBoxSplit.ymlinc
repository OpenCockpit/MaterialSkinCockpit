screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "TextBoxSplit"
  position: "fill"
  title: "Message"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        colposition: "0"
        dividechar: ":"
        font: "mono_font"
        halign: "block"
        name: "text"
        position: "25,84"
        scrollbarMode: "showNever"
        size: "1674,754"
        split: "1"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "text"
        position: "25,850"
        size: "1696,25"
        transparent: "1"
