screen:
  backgroundColor: "md_transparent"
  name: "SelectSatsEntryScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        name: "list"
        position: "35,87"
        scrollbarMode: "showNever"
        size: "1110,540"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "hint"
        position: "35,662"
        size: "1110,35"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
