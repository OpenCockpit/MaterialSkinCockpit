screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MovieTagEditor"
  position: "fill"
  title: "Edit tags"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showNever"
        size: "1670,13*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        position: "$window_large_margin,861"
        size: "$window_large_inner_width,25"
        transparent: "1"
