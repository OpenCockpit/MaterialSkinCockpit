screen:
  backgroundColor: "md_transparent"
  cornerRadius: "$radius_popup"
  flags: "wfNoBorder"
  name: "Volume"
  position: "710,65"
  size: "474,50"
  title: "Volume"
  zPosition: "1"
  children:
    - ePixmap:
        alphatest: "blend"
        pixmap: "menu/audio_icon.svg"
        position: "8,6"
        size: "42,38"
        zPosition: "-9"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_panel"
        position: "0,0"
        size: "474,50"
        widgetBorderColor: "md_surface_container_high"
        widgetBorderWidth: "2"
        zPosition: "-11"
    - eLabel:
        backgroundColor: "md_surface_container"
        cornerRadius: "$radius_bar_thin"
        position: "67,24"
        size: "343,4"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_bar_thin"
        foregroundColor: "md_tertiary"
        name: "Volume"
        orientation: "orLeftToRight"
        position: "67,24"
        size: "343,4"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface"
        font: "$title_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        position: "423,4"
        render: "VolumeText"
        size: "60,40"
        source: "global.CurrentTime"
        transparent: "1"
        valign: "center"
        zPosition: "20"
