screen:
  flags: "wfNoBorder"
  name: "CrossEPG_Ordering"
  position: "fill"
  title: "Cross EPG - Providers start order"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        name: "list"
        position: "$window_medium_content_x,$window_medium_content_y"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,660"
        transparent: "1"
