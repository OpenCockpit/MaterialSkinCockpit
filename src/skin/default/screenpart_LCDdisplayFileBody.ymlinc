- widget:
    enableWrapAround: "1"
    font: "md_body_small"
    foregroundColor: "md_on_surface_variant"
    itemCornerRadius: "$radius_item"
    itemHeight: "35"
    name: "LCDfile"
    position: "14,20"
    scrollbarMode: "showNever"
    scrollbarSliderBorderColor: "md_primary"
    scrollbarSliderBorderWidth: "1"
    scrollbarSliderForegroundColor: "md_primary"
    scrollbarWidth: "5"
    size: "$width-14,560"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "14,$height-25"
    size: "$width-14,25"
    connection: "LCDfile"
- widget:
    font: "md_body_small"
    foregroundColor: "md_secondary"
    halign: "center"
    position: "14,$height-70"
    render: "Label"
    size: "$width-14,45"
    source: "File"
    valign: "center"
