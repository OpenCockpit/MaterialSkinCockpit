- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "menulist"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,eval(($height-72)/$list_item_height*$list_item_height)"
    textOffset: "10,0"
    valign: "center"
    zPosition: "10"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    position: "0,$height-72"
    render: "Label"
    size: "$width,72"
    source: "introduction"
    valign: "center"
    zPosition: "10"
