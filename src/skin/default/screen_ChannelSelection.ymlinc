screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "ChannelSelection"
  position: "fill"
  title: "Channel Selection"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full_Big_Pig.ymlinc"
        position: "0,0"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1198,100"
        size: "1,870"
        zPosition: "-5"
    - widget:
        additionalInfoFont: "$hint_font"
        backgroundColor: "md_surface"
        backgroundColorMarked: "md_surface_container_low"
        backgroundColorMarkedSelected: "md_success_container"
        colorEventProgressbar: "md_on_surface_variant"
        colorEventProgressbarBorder: "md_outline"
        colorEventProgressbarBorderSelected: "md_outline"
        colorEventProgressbarSelected: "md_primary"
        colorServiceDescription: "md_on_surface"
        colorServiceDescriptionSelected: "md_primary"
        enableWrapAround: "1"
        foregroundColorEventRemaining: "md_secondary"
        foregroundColorEventRemainingSelected: "md_secondary"
        foregroundColorServiceNotAvail: "md_outline"
        forgroundColorEventProgressbarBorder: "md_surface"
        itemCornerRadius: "$radius_item"
        itemHeight: "52"
        itemHeightTwoLine: "84"
        markerLine: "1"
        markerLineColor: "md_outline_variant"
        markerTextAlignment: "center"
        name: "list"
        nonplayableMargins: "0"
        piconMargin: "2"
        position: "23,95"
        progressBarWidth: "60"
        progressPercentWidth: "80"
        progressbarHeight: "10"
        scrollbarSliderBorderColor: "md_on_surface"
        scrollbarSliderBorderWidth: "1"
        scrollbarSliderForegroundColor: "md_on_surface_variant"
        scrollbarWidth: "3"
        serviceEventSeparator: " • "
        serviceInfoFont: "$label_font"
        serviceNameFont: "$list_font"
        serviceNumberFont: "$list_font"
        serviceRemainingInfoFont: "$hint_font"
        sidesMargin: "20"
        size: "1152,840"
        textSeparator: "  •  "
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        maxPages: "15"
        position: "15,950"
        size: "1160,25"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "$text_font"
        halign: "left"
        options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
        position: "1230,480"
        render: "COCRunningText"
        size: "645,310"
        source: "ServiceEvent"
        transparent: "1"
        valign: "top"
        children:
          - convert:
              type: "EventName"
              text: "FullDescription"
    - widget:
        backgroundColor: "md_outline_variant"
        position: "1226,820"
        render: "FixedLabel"
        size: "645,1"
        source: "ServiceEvent"
        text: ""
        children:
          - convert:
              type: "EventName"
              text: "Name"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        NumberOfItems: "4"
        backgroundColor: "md_surface"
        font: "$text_font"
        foregroundColor: "md_on_surface"
        noLabel: "1"
        noWrap: "1"
        position: "1230,840"
        render: "NextEpgInfo"
        size: "645,160"
        source: "ServiceEvent"
        timeColor: "md_on_surface"
        transparent: "1"
        valign: "bottom"
    - widget:
        alphatest: "blend"
        position: "1230,140"
        render: "Picon"
        size: "200,120"
        source: "ServiceEvent"
        zPosition: "12"
        children:
          - convert:
              type: "ServiceName"
              text: "Reference"
    - widget:
        backgroundColor: "md_surface"
        font: "$header_font"
        foregroundColor: "md_primary"
        halign: "center"
        noWrap: "1"
        position: "1230,245"
        render: "Label"
        size: "200,80"
        source: "ServiceEvent"
        transparent: "1"
        valign: "bottom"
        zPosition: "14"
        children:
          - convert:
              nostrip: "1"
              type: "ServiceName"
              text: "  •  ,ORBPOS,TUNERSYSTEM"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "$list_large_font"
        foregroundColor: "md_primary"
        halign: "left"
        noWrap: "1"
        position: "1230,425"
        render: "Label"
        size: "645,40"
        source: "ServiceEvent"
        transparent: "1"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "$info_font"
        position: "1235,380"
        render: "Label"
        size: "160,30"
        source: "ServiceEvent"
        transparent: "1"
        children:
          - convert:
              nostrip: "1"
              type: "EventName"
              text: "  •  ,TIMERANGE"
    - widget:
        backgroundColor: "md_surface"
        borderColor: "md_outline"
        borderWidth: "1"
        cornerRadius: "$radius_bar"
        foregroundColor: "md_on_surface_variant"
        position: "1373,394"
        render: "Progress"
        size: "400,6"
        source: "ServiceEvent"
        zPosition: "6"
        children:
          - convert:
              type: "EventTime"
              text: "Progress"
    - widget:
        backgroundColor: "md_surface"
        font: "$info_font"
        halign: "right"
        position: "1795,380"
        render: "Label"
        size: "85,30"
        source: "ServiceEvent"
        transparent: "1"
        zPosition: "2"
        children:
          - convert:
              type: "EventTime"
              text: "Remaining"
          - convert:
              type: "RemainingToText"
              text: "InMinutes"
