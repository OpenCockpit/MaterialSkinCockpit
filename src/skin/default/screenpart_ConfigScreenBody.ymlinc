- widget:
    conditional: "config"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    separatorLineColor: "md_outline_variant"
    size: "$width,eval(($height-131)/$list_item_height*$list_item_height)"
    valign: "center"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "config"
- widget:
    conditional: "list"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "list"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,eval(($height-131)/$list_item_height*$list_item_height)"
    valign: "center"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    name: "description"
    objectTypes: "description,Button,Label"
    position: "0,$height-131"
    size: "$width,72"
    valign: "center"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    objectTypes: "description,StaticText"
    position: "0,$height-131"
    render: "Label"
    size: "$width,72"
    source: "description"
    valign: "center"
- widget:
    conditional: "introduction"
    name: "introduction"
    position: "0,0"
    size: "0,0"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    name: "footnote"
    objectTypes: "footnote,Button,Label"
    position: "0,$height-59"
    size: "$width,34"
    transparent: "1"
    valign: "center"
    zPosition: "5"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "center"
    objectTypes: "footnote,StaticText"
    position: "0,$height-59"
    render: "Label"
    size: "$width,34"
    source: "footnote"
    transparent: "1"
    valign: "center"
    zPosition: "1000"
