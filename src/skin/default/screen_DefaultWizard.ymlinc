screen:
  flags: "wfNoBorder"
  name: "DefaultWizard"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_WizardPictureLangTemplate.ymlinc"
        position: "0,0"
        size: "1590,895"
    - xmlinc:
        file: "screenpart_RemoteControlTemplate.ymlinc"
        position: "1436,150"
    - widget:
        font: "md_title_large"
        name: "text"
        position: "10,100"
        size: "1416,400"
        valign: "center"
    - widget:
        position: "10,500"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1416,295"
        source: "list"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (0, 0), size = (1035, 42), flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 0)
                            ],
                            "fonts": [parseFont("md_title_large")],
                            "itemHeight": 42
                        }
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        name: "config"
        position: "10,500"
        scrollbarMode: "showOnDemand"
        size: "1416,295"
        transparent: "1"
        zPosition: "1"
