- xmlinc:
    file: "screenpart_Pig.ymlinc"
    position: "$width-435,5"
    size: "435,248"
- eLabel:
    backgroundColor: "md_outline_variant"
    position: "1180,10"
    size: "1,870"
    zPosition: "-5"
- widget:
    conditional: "waitingtext"
    font: "md_title_large"
    halign: "center"
    name: "waitingtext"
    position: "0,5"
    size: "1160,860"
    valign: "center"
    zPosition: "1"
- widget:
    columnsCompactDescription: "280,240,200"
    columnsOriginal: "270,300"
    compactColumn: "400"
    dateWidth: "260"
    dirShift: "10"
    font: "md_body_large"
    fontSizesCompact: "36,28"
    fontSizesMinimal: "34,30"
    fontSizesOriginal: "36,26,24"
    iconsWidth: "33"
    itemCornerRadius: "$radius_item"
    itemHeight: "55"
    itemHeights: "107,78,50"
    name: "list"
    partIconeShiftCompact: "8"
    partIconeShiftMinimal: "12"
    partIconeShiftOriginal: "12"
    pbarHeight: "20"
    pbarLargeWidth: "72"
    pbarShift: "17"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "1160,825"
    spaceIconeText: "6"
    spaceLeft: "25"
    spaceRight: "25"
    transparent: "1"
    trashShift: "10"
    treeDescription: "250"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "list"
    maxPages: "15"
    position: "0,$height-25"
    size: "1160,25"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_body_large"
    halign: "left"
    options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
    position: "1215,475"
    render: "COCRunningText"
    size: "645,280"
    source: "Service"
    transparent: "1"
    valign: "top"
    children:
      - convert:
          type: "EventName"
          text: "ExtendedDescription"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_medium"
    foregroundColor: "md_primary"
    halign: "left"
    position: "1215,405"
    render: "Label"
    size: "645,40"
    source: "Service"
    valign: "center"
    children:
      - convert:
          nostrip: "1"
          type: "MovieInfo"
          text: "  •  ,TIMECREATED,DURATION,FILESIZE"
- widget:
    backgroundColor: "md_surface"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_on_surface"
    halign: "left"
    position: "1215,305"
    render: "Label"
    size: "610,40"
    source: "Service"
    valign: "center"
    children:
      - convert:
          type: "MovieInfo"
          text: "RecordServiceName"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    foregroundColor: "md_primary"
    halign: "left"
    position: "1215,354"
    render: "Label"
    size: "610,43"
    source: "Service"
    transparent: "1"
    valign: "center"
    children:
      - convert:
          type: "EventName"
          text: "Name"
- widget:
    alphatest: "blend"
    position: "1210,70"
    render: "Picon"
    size: "200,120"
    source: "Service"
    zPosition: "12"
    children:
      - convert:
          type: "ServiceName"
          text: "Reference"
- eLabel:
    backgroundColor: "md_outline_variant"
    position: "1215,810"
    size: "645,2"
    text: ""
- ePixmap:
    alphatest: "blend"
    pixmap: "icons/hddfree.png"
    position: "1215,840"
    scale: "1"
    size: "32,32"
    zPosition: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    halign: "left"
    name: "freeDiskSpace"
    position: "1270,838"
    size: "555,38"
