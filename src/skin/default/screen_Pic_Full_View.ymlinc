screen:
  backgroundColor: "md_surface"
  flags: "wfNoBorder"
  name: "Pic_Full_View"
  position: "fill"
  title: "Picture"
  children:
    - widget:
        alphatest: "blend"
        name: "pic"
        position: "fill"
        zPosition: "1"
    - eLabel:
        backgroundColor: "md_shadow"
        position: "22,22"
        size: "45,37"
        transparent: "1"
        zPosition: "2"
    - widget:
        alphatest: "blend"
        name: "point"
        pixmap: "icons/record.png"
        position: "25,25"
        size: "31,31"
        zPosition: "3"
    - widget:
        alphatest: "blend"
        name: "play_icon"
        pixmap: "icons/ico_mp_play.png"
        position: "25,25"
        size: "24,24"
        zPosition: "3"
    - widget:
        backgroundColor: "md_shadow"
        borderWidth: "2"
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        halign: "left"
        noWrap: "1"
        position: "90,20"
        render: "Label"
        size: "900,38"
        source: "file"
        transparent: "1"
        zPosition: "3"
