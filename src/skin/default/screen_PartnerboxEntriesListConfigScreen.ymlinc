screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PartnerboxEntriesListConfigScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "name"
        position: "684,50"
        size: "150,38"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "ip"
        position: "864,50"
        size: "225,38"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "port"
        position: "1089,50"
        size: "150,38"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "type"
        position: "1299,50"
        size: "300,38"
        transparent: "1"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "entrylist"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showNever"
        size: "1670,13*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "entrylist"
        position: "$window_large_margin,861"
        size: "$window_large_inner_width,25"
        transparent: "1"
