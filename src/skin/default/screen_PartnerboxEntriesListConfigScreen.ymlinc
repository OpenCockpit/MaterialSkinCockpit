screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PartnerboxEntriesListConfigScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_1_1.ymlinc"
        position: "96,54"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "name"
        position: "780,105"
        size: "150,36"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "ip"
        position: "960,105"
        size: "225,36"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "port"
        position: "1185,105"
        size: "150,36"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "type"
        position: "1395,105"
        size: "300,36"
        transparent: "1"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "entrylist"
        position: "125,150"
        scrollbarMode: "showNever"
        size: "1670,13*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "entrylist"
        position: "145,915"
        size: "1630,25"
        transparent: "1"
