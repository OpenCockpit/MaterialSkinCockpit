screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PartnerboxEntriesListConfigScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_large_width,$window_large_height"
        window_inset_x: "$window_large_body_x"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "name"
        position: "684,50"
        size: "150,38"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "ip"
        position: "864,50"
        size: "225,38"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "port"
        position: "1089,50"
        size: "150,38"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "md_body_large"
        halign: "left"
        name: "type"
        position: "1299,50"
        size: "300,38"
        transparent: "1"
    - xmlinc:
        file: "screenpart_PartnerboxEntriesListConfigScreenBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y"
        size: "$window_large_body_width,$window_large_body_height"
