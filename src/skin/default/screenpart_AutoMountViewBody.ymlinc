- widget:
    font: "md_body_small"
    halign: "left"
    position: "221,0"
    render: "Label"
    size: "300,75"
    source: "legend1"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- widget:
    font: "md_body_small"
    halign: "center"
    position: "571,0"
    render: "Label"
    size: "525,75"
    source: "legend2"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- widget:
    font: "md_body_small"
    halign: "right"
    position: "1131,0"
    render: "Label"
    size: "300,75"
    source: "legend3"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- widget:
    itemCornerRadius: "$radius_item"
    position: "271,100"
    render: "Listbox"
    size: "1110,8*75"
    source: "config"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryPixmapAlphaTest(pos = ($list_indent, 15), size = ($list_icon_large, $list_icon_large), png = 0), # index 0 is the isMounted pixmap
                                                                                                    MultiContentEntryText(pos = (eval($list_indent+128), 15), size = (285, 37), font=0, flags = RT_HALIGN_LEFT, text = 1), # index 1 is the sharename
                                                                                                    MultiContentEntryText(pos = (eval($list_indent+413), 5), size = (345, 30), font=1, flags = RT_HALIGN_LEFT, text = 2), # index 2 is the IPdescription
                                                                                                    MultiContentEntryText(pos = (eval($list_indent+413), 35), size = (720, 30), font=1, flags = RT_HALIGN_LEFT, text = 3), # index 3 is the DIRdescription
                                                                                                    MultiContentEntryPixmapAlphaTest(pos = (eval($list_indent+928), 25), size = ($list_icon_large, $list_icon_large), png = 4), # index 4 is the activepng pixmap
                                                                                                    MultiContentEntryPixmapAlphaTest(pos = (eval($list_indent+973), 15), size = ($list_icon_large, $list_icon_large), png = 5), # index 4 is the mounttype pixmap
                        ],
                        "fonts": [parseFont("md_title_large"), parseFont("md_body_small")],
                        "itemHeight": 75
                    }
- xmlinc:
    file: "screenpart_InfoStrip.ymlinc"
    position: "$width-1110,$height-38"
    size: "1110,38"
    strip_font: "md_body_medium"
    strip_source: "introduction"
