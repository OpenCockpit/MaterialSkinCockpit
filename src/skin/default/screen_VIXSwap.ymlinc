screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "VIXSwap"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        alphatest: "blend"
        name: "autostart_off"
        pixmap: "icons/lock_off.png"
        position: "396,210"
        size: "48,48"
        zPosition: "1"
    - widget:
        alphatest: "blend"
        name: "autostart_on"
        pixmap: "icons/lock_on.png"
        position: "396,210"
        size: "48,48"
        zPosition: "2"
    - widget:
        font: "$list_font"
        name: "lab1"
        position: "475,210"
        size: "950,75"
    - widget:
        font: "$list_font"
        name: "lab2"
        position: "396,350"
        size: "225,45"
        valign: "center"
    - widget:
        font: "$list_font"
        name: "labplace"
        position: "620,349"
        size: "330,45"
        valign: "center"
    - widget:
        font: "$list_font"
        name: "lab3"
        position: "396,394"
        size: "225,45"
        valign: "center"
    - widget:
        font: "$list_font"
        name: "labsize"
        position: "620,394"
        size: "330,45"
        valign: "center"
    - widget:
        font: "$list_font"
        name: "lab4"
        position: "396,439"
        size: "225,45"
        valign: "center"
    - widget:
        backgroundColor: "md_key_red"
        font: "$list_font"
        halign: "center"
        name: "inactive"
        position: "620,439"
        size: "150,45"
        valign: "center"
    - widget:
        backgroundColor: "md_key_green"
        font: "$list_font"
        halign: "center"
        name: "active"
        position: "620,439"
        size: "150,45"
        valign: "center"
        zPosition: "1"
