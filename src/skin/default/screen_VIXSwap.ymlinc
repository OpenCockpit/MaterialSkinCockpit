screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "VIXSwap"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        alphatest: "blend"
        name: "autostart_off"
        pixmap: "icons/lock_off.png"
        position: "$window_medium_content_x,$window_medium_content_y"
        size: "48,48"
        zPosition: "1"
    - widget:
        alphatest: "blend"
        name: "autostart_on"
        pixmap: "icons/lock_on.png"
        position: "$window_medium_content_x,$window_medium_content_y"
        size: "48,48"
        zPosition: "2"
    - widget:
        font: "md_body_large"
        name: "lab1"
        position: "105,92"
        size: "950,75"
    - widget:
        font: "md_body_large"
        name: "lab2"
        position: "26,232"
        size: "225,45"
        valign: "center"
    - widget:
        font: "md_body_large"
        name: "labplace"
        position: "250,231"
        size: "330,45"
        valign: "center"
    - widget:
        font: "md_body_large"
        name: "lab3"
        position: "26,276"
        size: "225,45"
        valign: "center"
    - widget:
        font: "md_body_large"
        name: "labsize"
        position: "250,276"
        size: "330,45"
        valign: "center"
    - widget:
        font: "md_body_large"
        name: "lab4"
        position: "26,321"
        size: "225,45"
        valign: "center"
    - widget:
        backgroundColor: "md_key_red"
        font: "md_body_large"
        halign: "center"
        name: "inactive"
        position: "250,321"
        size: "150,45"
        valign: "center"
    - widget:
        backgroundColor: "md_key_green"
        font: "md_body_large"
        halign: "center"
        name: "active"
        position: "250,321"
        size: "150,45"
        valign: "center"
        zPosition: "1"
