- widget:
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,660"
    source: "list"
    transparent: "0"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryPixmapAlphaTest(pos = (18, 12), size = (48, 48), png = 0),
                            MultiContentEntryText(pos = (87, 11), size = (1060, 49), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_TOP, text = 1),
                        ],
                        "fonts": [parseFont("md_body_large")],
                        "itemHeight": 60
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
