screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "VIXSoftcamManager"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        font: "$list_large_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "lab2"
        position: "396,210"
        size: "255,45"
        zPosition: "2"
    - widget:
        font: "$list_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "activecam"
        noWrap: "1"
        position: "673,210"
        size: "360,225"
        zPosition: "2"
    - widget:
        font: "$list_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "lab1"
        position: "396,481"
        size: "255,40"
        zPosition: "2"
    - widget:
        enableWrapAround: "1"
        font: "SelectionList;30"
        foregroundColor: "md_on_surface"
        itemCornerRadius: "$radius_item"
        name: "list"
        position: "673,481"
        scrollbarMode: "showNever"
        size: "450,9*40"
        valign: "center"
    - applet:
        type: "onLayoutFinish"
        text: "self[\"list\"].instance.setItemHeight(40)"
