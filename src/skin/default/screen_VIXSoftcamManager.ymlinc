screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "VIXSoftcamManager"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_title_large"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "lab2"
        position: "$window_medium_content_x,$window_medium_content_y"
        size: "255,45"
        zPosition: "2"
    - widget:
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "activecam"
        noWrap: "1"
        position: "303,92"
        size: "360,225"
        zPosition: "2"
    - widget:
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "lab1"
        position: "26,363"
        size: "255,40"
        zPosition: "2"
    - widget:
        enableWrapAround: "1"
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        itemCornerRadius: "$radius_item"
        name: "list"
        position: "303,363"
        scrollbarMode: "showNever"
        size: "450,9*40"
        valign: "center"
    - applet:
        type: "onLayoutFinish"
        text: "self[\"list\"].instance.setItemHeight(40)"
