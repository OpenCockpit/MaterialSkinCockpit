- widget:
    font: "md_body_medium"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,14*$list_item_height"
- widget:
    backgroundColor: "md_surface"
    name: "pager"
    pagerBackground: "md_surface"
    pagerForeground: "md_on_surface"
    position: "0,$height-25"
    size: "$width,25"
    transparent: "1"
