screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "SoftcamSetup"
  position: "fill"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemHeight: "45"
        name: "config"
        position: "19,85"
        size: "$window_small_content_width,150"
    - widget:
        font: "mono_font"
        name: "info"
        position: "23,247"
        size: "885,464"
