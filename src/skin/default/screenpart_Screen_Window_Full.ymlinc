screen:
  name: "Screen_Window_Full"
  children:
    - eLabel:
        backgroundColor: "md_surface_container_high"
        cornerRadius: "$radius_window"
        position: "0,0"
        size: "1912,1071"
        zPosition: "-11"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_window_inner"
        position: "2,72"
        size: "1908,927"
        zPosition: "-10"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "24,0"
        size: "1864,2"
        zPosition: "-7"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "0,24"
        size: "2,982"
        zPosition: "-7"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "1910,24"
        size: "2,982"
        zPosition: "-7"
    - widget:
        addon: "ScreenHeader"
        backgroundColor: "md_surface_container_high"
        connection: "Image,Title,ScreenPath"
        pathFont: "$path_font"
        pathForegroundColor: "md_primary"
        position: "20,3"
        size: "1700,66"
        titleFont: "$title_font"
        titleForegroundColor: "md_primary"
        titleSingleFont: "$title_single_font"
        transparent: "1"
    - widget:
        backgroundColor: "md_shadow"
        font: "$emphasis_font"
        foregroundColor: "md_on_surface"
        halign: "right"
        position: "1750,0"
        render: "Label"
        size: "120,70"
        source: "global.CurrentTime"
        transparent: "1"
        valign: "center"
        zPosition: "20"
        children:
          - convert:
              type: "ClockToText"
              text: "Default"
    - xmlinc:
        file: "screenpart_ButtonsBarTemplate.ymlinc"
        position: "20,1020"
        size: "1790,62"
    - xmlinc:
        file: "screenpart_BrandLogoTemplate.ymlinc"
        position: "1815,1020"
        size: "74,34"
