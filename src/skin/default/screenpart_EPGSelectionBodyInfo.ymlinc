- param: {name: "width"}
- param: {name: "height"}
- xmlinc:
    file: "screenpart_Pig.ymlinc"
    position: "$width-435,0"
    size: "435,248"
- widget:
    font: "md_title_large"
    foregroundColor: "md_primary"
    position: "1,270"
    render: "Label"
    size: "720,43"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          type: "EventName"
          text: "Name"
- widget:
    font: "md_body_large"
    halign: "block"
    options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
    position: "0,330"
    render: "COCRunningText"
    size: "720,500"
    source: "Event"
    transparent: "1"
    valign: "top"
    children:
      - convert:
          type: "EventName"
          text: "FullDescription"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_secondary"
    position: "3,$height-38"
    render: "Label"
    size: "330,38"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          type: "EventTime"
          text: "StartTime"
      - convert:
          type: "ClockToText"
          text: "ShortDate"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_secondary"
    halign: "right"
    position: "194,$height-38"
    render: "Label"
    size: "120,38"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          type: "EventTime"
          text: "StartTime"
      - convert:
          type: "ClockToText"
          text: "Format:%H:%M"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_secondary"
    halign: "left"
    position: "316,$height-38"
    render: "Label"
    size: "120,38"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          type: "EventTime"
          text: "EndTime"
      - convert:
          type: "ClockToText"
          text: "Format:- %H:%M"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_secondary"
    halign: "left"
    position: "500,$height-38"
    render: "Label"
    size: "165,38"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          type: "EventTime"
          text: "Duration"
      - convert:
          type: "ClockToText"
          text: "InMinutes"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_secondary"
    halign: "right"
    position: "567,$height-38"
    render: "Label"
    size: "160,38"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          type: "EventTime"
          text: "Duration"
      - convert:
          type: "ClockToText"
          text: "AsLengthHours"
- widget:
    position: "0,45"
    render: "Picon"
    size: "200,120"
    source: "Service"
    zPosition: "12"
    children:
      - convert:
          type: "ServiceName"
          text: "Reference"
