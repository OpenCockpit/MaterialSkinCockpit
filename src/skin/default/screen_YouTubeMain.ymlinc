screen:
  name: "YouTubeMain"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_medium_width,$window_medium_height"
        window_inset_x: "$window_medium_body_x"
    - xmlinc:
        file: "screenpart_YouTubeMainBody.ymlinc"
        position: "$window_medium_body_x,$window_medium_body_y+15"
        width: "$window_medium_body_width"
        height: "$window_medium_body_height-15"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "text"
        position: "$window_medium_body_x,$window_medium_body_y+15"
        size: "$window_medium_body_width,$window_medium_body_height-15"
        valign: "center"
        zPosition: "1"
    - widget:
        name: "thumbnail"
        position: "$window_medium_body_x+$list_indent,$window_medium_body_y+15"
        size: "150,108"
