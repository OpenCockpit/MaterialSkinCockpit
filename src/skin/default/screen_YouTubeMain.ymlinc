screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "YouTubeMain"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_medium_width,$window_medium_height"
        window_inset_x: "$window_medium_body_x"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "text"
        position: "630,12"
        size: "400,50"
        zPosition: "1"
    - xmlinc:
        file: "screenpart_YouTubeMainBody.ymlinc"
        position: "$window_medium_body_x,$window_medium_body_y"
        size: "$window_medium_body_width,$window_medium_body_height"
    - widget:
        name: "thumbnail"
        origin: "screen"
        position: "0,3"
        size: "150,108"
