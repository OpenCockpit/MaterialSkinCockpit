screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "YouTubeMain"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "text"
        position: "1000,130"
        size: "400,50"
        zPosition: "1"
    - widget:
        itemCornerRadius: "$radius_item"
        position: "396,225"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1130,648"
        source: "list"
        transparent: "0"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryPixmapAlphaTest(pos=(0,0), flags=BT_SCALE, size=(150,108), png=2), # Thumbnail
                                                                                                        MultiContentEntryText(pos=(165,1), size=(862,78), font=0, flags=RT_HALIGN_LEFT|RT_VALIGN_CENTER|RT_WRAP, text=3), # Title
                                                                                                        MultiContentEntryText(pos=(180,75), size=(300,33), font=1, flags=RT_HALIGN_LEFT, text=4), # Views
                                                                                                        MultiContentEntryText(pos=(540,75), size=(300,33), font=1, flags=RT_HALIGN_LEFT, text=5), # Duration
                            ],
                            "fonts": [parseFont("md_body_large"), parseFont("md_body_small")],
                            "itemHeight": 108
                        }
    - widget:
        name: "thumbnail"
        position: "0,0"
        size: "150,108"
