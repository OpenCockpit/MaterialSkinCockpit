- widget:
    backgroundColor: "md_surface"
    foregroundColor: "md_on_surface"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,750"
    source: "menu"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (120, 0), size = (15, 45), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = 1), #arrow
                                                                                                        MultiContentEntryText(pos = (145, 0), size = (350, 30), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 2, color = "md_on_surface", color_sel = "md_inverse_on_surface"), #service name
                                                                                                        MultiContentEntryText(pos = (425, 0), size = (450, 30), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 3, color = "md_on_surface", color_sel = "md_inverse_on_surface"), #event name
                                                                                                        MultiContentEntryText(pos = (145, 30), size = (350, 30), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 7, color = "md_on_surface", color_sel = "md_inverse_on_surface"), #orbital position
                                                                                                        MultiContentEntryText(pos = (425, 30), size = (450, 30), font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 5, color = "md_on_surface", color_sel = "md_inverse_on_surface"), #duration
                                                                                                        MultiContentEntryText(pos = (10, 70), size = (1650, 90), font = 4, flags = RT_HALIGN_LEFT|RT_WRAP, text = 4, color = "md_on_surface", color_sel = "md_inverse_on_surface"), #epg
                                                                                                        MultiContentEntryPixmapAlphaBlend(pos=(0,5), size=(110,60), png=6, flags = BT_SCALE) #picon must be last otherwise won't work
                        ],
                        "fonts": [parseFont("md_body_small"), parseFont("md_label_medium"), parseFont("md_label_medium"), parseFont("md_label_medium"), parseFont("md_body_small")],
                        "itemHeight": 150
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "271,$height-25"
    size: "1130,25"
    connection: "menu"
