screen:
  name: "VixListTemplate"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        conditional: "list"
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showNever"
        size: "1670,13*45"
    - widget:
        conditional: "lab1"
        font: "md_body_medium"
        foregroundColor: "md_warning"
        halign: "center"
        name: "lab1"
        position: "$window_large_margin,701"
        size: "$window_large_inner_width,100"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        conditional: "backupstatus"
        font: "md_body_medium"
        foregroundColor: "md_warning"
        halign: "center"
        name: "backupstatus"
        position: "$window_large_margin,811"
        size: "$window_large_inner_width,40"
        valign: "center"
        zPosition: "5"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "list"
        connection: "list"
        position: "$window_large_margin,861"
        size: "$window_large_inner_width,25"
        transparent: "1"
