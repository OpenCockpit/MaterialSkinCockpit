screen:
  name: "VixListTemplate"
  children:
    - xmlinc:
        file: "screenpart_Screen_1_1.ymlinc"
        position: "0,0"
    - widget:
        conditional: "list"
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "29,96"
        scrollbarMode: "showNever"
        size: "1670,13*45"
    - widget:
        conditional: "lab1"
        font: "md_body_medium"
        foregroundColor: "md_warning"
        halign: "center"
        name: "lab1"
        position: "49,701"
        size: "1630,100"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        conditional: "backupstatus"
        font: "md_body_medium"
        foregroundColor: "md_warning"
        halign: "center"
        name: "backupstatus"
        position: "49,811"
        size: "1630,40"
        valign: "center"
        zPosition: "5"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "list"
        connection: "list"
        position: "49,861"
        size: "1630,25"
        transparent: "1"
