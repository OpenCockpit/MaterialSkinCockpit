- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "$text_font"
    itemHeight: "38"
    name: "list"
    position: "0,0"
    size: "1110,7*38"
    transparent: "1"
- eLabel:
    backgroundColor: "md_surface_overlay_soft"
