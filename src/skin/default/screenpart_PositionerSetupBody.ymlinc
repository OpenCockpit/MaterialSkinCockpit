- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_medium"
    itemHeight: "$list_item_height_compact"
    name: "list"
    position: "0,0"
    size: "1110,7*$list_item_height_compact"
    transparent: "1"
- eLabel:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    position: "0,295"
    size: "330,37"
    text: "Frequency:"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    name: "frequency_value"
    position: "330,295"
    size: "150,37"
    transparent: "1"
- eLabel:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    position: "0,342"
    size: "330,37"
    text: "Polarisation:"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    name: "polarisation"
    position: "330,342"
    size: "150,37"
    transparent: "1"
- eLabel:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    position: "0,388"
    size: "330,37"
    text: "Symbolrate:"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    name: "symbolrate_value"
    position: "330,388"
    size: "150,37"
    transparent: "1"
- eLabel:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    position: "0,435"
    size: "330,37"
    text: "FEC:"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    name: "fec_value"
    position: "330,435"
    size: "150,37"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    foregroundColor: "md_on_surface"
    halign: "center"
    name: "snr_db"
    position: "330,505"
    size: "300,37"
    transparent: "1"
- eLabel:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    position: "0,545"
    size: "120,37"
    text: "SNR:"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    borderWidth: "1"
    name: "snr_bar"
    position: "330,548"
    size: "300,26"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    name: "snr_percentage"
    position: "645,545"
    size: "120,37"
    transparent: "1"
- eLabel:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    position: "0,590"
    size: "120,37"
    text: "BER:"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    borderWidth: "1"
    name: "ber_bar"
    position: "330,593"
    size: "300,26"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    name: "ber_value"
    position: "645,590"
    size: "120,37"
    transparent: "1"
- eLabel:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    position: "0,$height-37"
    size: "120,37"
    text: "Lock:"
    transparent: "1"
- widget:
    backgroundColor: "md_surface_overlay_soft"
    font: "md_body_large"
    name: "lock_state"
    position: "330,$height-37"
    size: "300,37"
    transparent: "1"
- widget:
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "center"
    name: "status_bar"
    position: "$width-425,$height-37"
    size: "425,37"
