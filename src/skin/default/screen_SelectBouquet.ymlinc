screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "SelectBouquet"
  position: "fill"
  title: "Choose bouquet"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        font: "md_title_large"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menu"
        position: "21,86"
        scrollbarMode: "showOnDemand"
        size: "$window_small_content_width,630"
