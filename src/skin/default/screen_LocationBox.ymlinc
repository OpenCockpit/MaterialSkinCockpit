screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "LocationBox"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_1_1.ymlinc"
        position: "96,54"
    - widget:
        font: "md_title_large"
        name: "text"
        position: "125,150"
        size: "1670,37"
    - widget:
        font: "md_title_large"
        name: "target"
        position: "125,195"
        size: "1670,37"
        valign: "center"
    - widget:
        name: "filelist"
        position: "125,190"
        scrollbarMode: "showOnDemand"
        selectionDisabled: "1"
        size: "1670,310"
        zPosition: "1"
    - widget:
        font: "md_title_large"
        name: "textbook"
        position: "125,562"
        size: "1670,37"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        name: "booklist"
        position: "132,607"
        scrollbarMode: "showOnDemand"
        size: "1656,38*8"
        zPosition: "2"
