screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "LocationBox"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        font: "md_title_large"
        name: "text"
        position: "$window_large_content_x,$window_large_content_y"
        size: "1670,41"
    - widget:
        font: "md_title_large"
        name: "target"
        position: "29,139"
        size: "1670,41"
        valign: "center"
    - widget:
        name: "filelist"
        position: "29,136"
        scrollbarMode: "showOnDemand"
        selectionDisabled: "1"
        size: "1670,310"
        zPosition: "1"
    - widget:
        font: "md_title_large"
        name: "textbook"
        position: "29,508"
        size: "1670,41"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        name: "booklist"
        position: "36,553"
        scrollbarMode: "showOnDemand"
        size: "1656,38*8"
        zPosition: "2"
