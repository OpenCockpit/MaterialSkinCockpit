screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "EventViewContextMenu"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menu"
        position: "17,79"
        scrollbarMode: "showNever"
        size: "$window_small_content_width,635"
        textOffset: "15,7"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "menu"
        position: "17,713"
        size: "$window_small_content_width,25"
        transparent: "1"
