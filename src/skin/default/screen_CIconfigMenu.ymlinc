screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CIconfigMenu"
  position: "fill"
  title: "CI Assignment"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small"
        position: "473,198"
        render: "Label"
        size: "990,45"
        source: "CAidList_desc"
        transparent: "1"
    - eLabel:
        backgroundColor: "md_shadow"
        position: "473,252"
        size: "990,3"
    - eLabel:
        backgroundColor: "md_on_surface_variant"
        position: "473,251"
        size: "990,3"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        position: "474,267"
        render: "Label"
        size: "990,112"
        source: "CAidList"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small"
        position: "475,391"
        render: "Label"
        size: "990,45"
        source: "ServiceList_desc"
        transparent: "1"
    - eLabel:
        backgroundColor: "md_shadow"
        position: "473,459"
        size: "990,3"
    - eLabel:
        backgroundColor: "md_on_surface_variant"
        position: "473,459"
        size: "990,3"
    - widget:
        backgroundColor: "md_surface"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "ServiceList"
        position: "522,476"
        scrollbarMode: "showOnDemand"
        size: "900,400"
        transparent: "1"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        position: "473,473"
        render: "Label"
        size: "990,400"
        source: "ServiceList_info"
        transparent: "1"
        zPosition: "2"
