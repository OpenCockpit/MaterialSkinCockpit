screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CIconfigMenu"
  position: "fill"
  title: "CI Assignment"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        position: "103,80"
        render: "Label"
        size: "990,45"
        source: "CAidList_desc"
        transparent: "1"
    - eLabel:
        backgroundColor: "md_shadow"
        position: "103,134"
        size: "990,3"
    - eLabel:
        backgroundColor: "md_on_surface_variant"
        position: "103,133"
        size: "990,3"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        position: "104,149"
        render: "Label"
        size: "990,112"
        source: "CAidList"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        position: "105,273"
        render: "Label"
        size: "990,45"
        source: "ServiceList_desc"
        transparent: "1"
    - eLabel:
        backgroundColor: "md_shadow"
        position: "103,341"
        size: "990,3"
    - eLabel:
        backgroundColor: "md_on_surface_variant"
        position: "103,341"
        size: "990,3"
    - widget:
        backgroundColor: "md_surface"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "ServiceList"
        position: "152,358"
        scrollbarMode: "showOnDemand"
        size: "900,400"
        transparent: "1"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        position: "103,355"
        render: "Label"
        size: "990,369"
        source: "ServiceList_info"
        transparent: "1"
        zPosition: "2"
