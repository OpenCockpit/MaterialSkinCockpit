screen:
  name: "BlindscanState"
  position: "fill"
  title: "Blind scan"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_BlindscanStateBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y+580"
        width: "$window_large_body_width"
        height: "$window_large_body_height-580"
