screen:
  backgroundColor: "md_transparent"
  name: "BlindscanState"
  position: "fill"
  title: "Blind scan"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_primary"
        halign: "center"
        name: "progress"
        position: "$window_large_margin,811"
        size: "$window_large_inner_width,32"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_on_surface"
        halign: "center"
        name: "post_action"
        position: "$window_large_margin,676"
        size: "1620,150"
        valign: "center"
