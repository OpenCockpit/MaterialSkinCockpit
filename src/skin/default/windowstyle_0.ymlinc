windowstyle:
  id: "0"
  type: "skinned"
  children:
    - title:
        font: "md_headline_small_emphasized"
        offset: "25,10"
    - color:
        color: "md_surface"
        name: "Background"
    - color:
        color: "md_on_surface"
        name: "LabelForeground"
    - color:
        color: "md_surface"
        name: "ListboxBackground"
    - color:
        color: "md_on_surface"
        name: "ListboxForeground"
    - color:
        color: "md_surface_container_high"
        name: "ListboxSelectedBackground"
    - color:
        color: "md_primary"
        name: "ListboxSelectedForeground"
    - color:
        color: "md_secondary_container"
        name: "ListboxMarkedBackground"
    - color:
        color: "md_on_secondary_container"
        name: "ListboxMarkedForeground"
    - color:
        color: "md_primary_container"
        name: "ListboxMarkedAndSelectedBackground"
    - color:
        color: "md_on_primary_container"
        name: "ListboxMarkedAndSelectedForeground"
    - color:
        color: "md_primary"
        name: "WindowTitleForeground"
    - color:
        color: "md_surface"
        name: "WindowTitleBackground"
    - borderset:
        name: "bsWindow"
        children:
          - pixmap:
              filename: "window/top_left_corner.png"
              pos: "bpTopLeft"
          - pixmap:
              filename: "window/top_edge.png"
              pos: "bpTop"
          - pixmap:
              filename: "window/top_right_corner.png"
              pos: "bpTopRight"
          - pixmap:
              filename: "window/left_edge.png"
              pos: "bpLeft"
          - pixmap:
              filename: "window/right_edge.png"
              pos: "bpRight"
          - pixmap:
              filename: "window/bottom_left_corner.png"
              pos: "bpBottomLeft"
          - pixmap:
              filename: "window/bottom_edge.png"
              pos: "bpBottom"
          - pixmap:
              filename: "window/bottom_right_corner.png"
              pos: "bpBottomRight"
