screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "NimSelection"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        itemCornerRadius: "$radius_item"
        position: "386,203"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1145,641"
        source: "nimlist"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                		{
                			"template": [
                				MultiContentEntryText(pos = (15, 3), size = (1005, 37), flags = RT_HALIGN_LEFT, text = 1), # index 1 is the nim name,
                				MultiContentEntryText(pos = (75, 41), size = (945, 84), font = 1, flags = RT_HALIGN_LEFT, text = 2), # index 2 is a description of the nim settings,
                			],
                			"fonts": [parseFont("md_title_large"), parseFont("md_label_large")],
                			"itemHeight": 128
                		}
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "nimlist"
        position: "396,849"
        size: "1130,25"
        transparent: "1"
