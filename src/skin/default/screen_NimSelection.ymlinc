screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "NimSelection"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        itemCornerRadius: "$radius_item"
        position: "16,85"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1145,641"
        source: "nimlist"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (15, 3), size = (1005, 37), flags = RT_HALIGN_LEFT, text = 1), # index 1 is the nim name,
                                MultiContentEntryText(pos = (75, 41), size = (945, 84), font = 1, flags = RT_HALIGN_LEFT, text = 2), # index 2 is a description of the nim settings,
                            ],
                            "fonts": [parseFont("md_title_large"), parseFont("md_body_small")],
                            "itemHeight": 128
                        }
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "nimlist"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
