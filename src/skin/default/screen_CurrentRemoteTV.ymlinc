screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CurrentRemoteTV"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "text"
        position: "$window_large_content_x,$window_large_content_y"
        size: "1670,630"
        valign: "center"
        zPosition: "1"
