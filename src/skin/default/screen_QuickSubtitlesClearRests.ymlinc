screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "QuickSubtitlesClearRests"
  position: "fill"
  resolution: "1920,1080"
  title: "Subtitle settings"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "20,30"
        dialog_height: "eval(4*$list_item_height+$window_dialog_trim_y)"
        dialog_width: "eval(710+$window_dialog_trim_x)"
        size: "$dialog_width,$dialog_height"
        window_inset_x: "$window_dialog_body_x"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "$list_item_height"
        name: "config"
        position: "$window_dialog_body_x,$window_dialog_body_y"
        size: "$dialog_width-$window_dialog_trim_x,4*$list_item_height"
        transparent: "1"
        zPosition: "1"
