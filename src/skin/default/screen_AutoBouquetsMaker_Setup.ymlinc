screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoBouquetsMaker_Setup"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        font: "md_body_medium"
        itemHeight: "45"
        name: "config"
        position: "396,210"
        scrollbarMode: "showNever"
        size: "1130,10*45"
        valign: "center"
    - widget:
        font: "md_body_medium"
        halign: "center"
        name: "pleasewait"
        position: "396,210"
        size: "1130,10*45"
        transparent: "0"
        valign: "center"
        zPosition: "5"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "config"
        position: "396,849"
        size: "1130,25"
        transparent: "1"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "description"
        position: "396,700"
        size: "1130,150"
        valign: "top"
