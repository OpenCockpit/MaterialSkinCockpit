screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoBouquetsMaker_Setup"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemHeight: "45"
        name: "config"
        position: "$window_medium_content_x,$window_medium_content_y"
        scrollbarMode: "showNever"
        size: "1130,10*45"
        valign: "center"
    - widget:
        font: "md_body_medium"
        halign: "center"
        name: "pleasewait"
        position: "$window_medium_content_x,$window_medium_content_y"
        size: "1130,10*45"
        transparent: "0"
        valign: "center"
        zPosition: "5"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "config"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
    - widget:
        font: "md_body_large"
        halign: "center"
        name: "description"
        position: "26,582"
        size: "$window_medium_content_width,140"
        valign: "top"
