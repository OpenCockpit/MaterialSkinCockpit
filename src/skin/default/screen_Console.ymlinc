screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "Console"
  position: "fill"
  title: "Command execution"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "mono_font"
        foregroundColor: "md_on_surface"
        itemHeight: "38"
        name: "text"
        position: "24,86"
        scrollbarMode: "showOnDemand"
        size: "$window_medium_content_width,667"
        transparent: "1"
