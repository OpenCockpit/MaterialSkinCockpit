screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PartnerboxAutoTimerOverview"
  position: "fill"
  title: "AutoTimer Overview"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        name: "entries"
        position: "26,127"
        scrollbarMode: "showOnDemand"
        size: "$window_medium_content_width,600"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "entries"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
