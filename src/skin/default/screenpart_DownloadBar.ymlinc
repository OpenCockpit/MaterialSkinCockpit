screen:
  name: "DownloadBar"
  children:
    - widget:
        backgroundColor: "md_surface_overlay"
        font: "md_title_large"
        name: "action"
        position: "0,0"
        size: "650,45"
    - widget:
        backgroundColor: "md_surface_overlay"
        font: "md_title_large"
        halign: "center"
        name: "status"
        position: "690,0"
        size: "650,45"
    - widget:
        alphatest: "blend"
        conditional: "Frontend"
        pixmap: "icons/lock_on.png"
        position: "1383,0"
        render: "Pixmap"
        size: "38,36"
        source: "Frontend"
        children:
          - convert:
              type: "FrontendInfo"
              text: "LOCK"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        conditional: "Frontend"
        pixmap: "icons/lock_off.png"
        position: "1383,0"
        render: "Pixmap"
        size: "38,36"
        source: "Frontend"
        children:
          - convert:
              type: "FrontendInfo"
              text: "LOCK"
          - convert:
              type: "ConditionalShowHide"
              text: "Invert"
    - widget:
        backgroundColor: "md_surface_overlay"
        conditional: "tuner_text"
        font: "md_title_large"
        halign: "center"
        name: "tuner_text"
        position: "1423,0"
        size: "35,45"
    - widget:
        backgroundColor: "md_surface_overlay"
        conditional: "Frontend"
        font: "md_title_large"
        halign: "left"
        position: "1460,0"
        render: "Label"
        size: "130,45"
        source: "Frontend"
        children:
          - convert:
              type: "FrontendInfo"
              text: "SNRdB"
    - widget:
        backgroundColor: "md_surface_overlay"
        font: "md_title_large"
        halign: "right"
        position: "1610,0"
        render: "Label"
        size: "130,45"
        source: "progress_text"
        children:
          - convert:
              type: "ProgressToText"
              text: "InText"
    - widget:
        backgroundColor: "md_surface_overlay"
        font: "md_title_large"
        halign: "left"
        position: "1770,0"
        render: "Label"
        size: "110,45"
        source: "progress_text"
        children:
          - convert:
              type: "ProgressToText"
              text: "InPercent"
