- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,eval(($height-25)/$list_item_height*$list_item_height)"
    source: "menuList"
    transparent: "1"
    zPosition: "3"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {"templates":
                                                                                                {"default": (45, [
                                                                                                    MultiContentEntryText(pos=(10,0), size=(eval($width-20),45), font=0, flags=RT_HALIGN_LEFT|RT_VALIGN_CENTER|RT_WRAP, text=0)
                        ], True, "showNever"),
                                                                                                },
                        "fonts": [parseFont("md_body_medium")],
                        "itemHeight": 45
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "menuList"
