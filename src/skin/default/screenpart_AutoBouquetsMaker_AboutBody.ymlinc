- widget:
    backgroundColor: "md_surface"
    font: "md_body_medium"
    name: "about"
    position: "0,0"
    size: "$width,$height"
- widget:
    alphatest: "blend"
    backgroundColor: "md_surface"
    conditional: "oealogo"
    name: "oealogo"
    position: "$width-176,$height-142"
    size: "176,142"
    transparent: "1"
