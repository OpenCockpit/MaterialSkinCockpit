screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "TimerSanityConflict"
  position: "fill"
  title: "Timer sanity error"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        itemHeight: "75"
        name: "timer1"
        position: "396,210"
        rowSplit: "40"
        satPosLeft: "250"
        scrollbarMode: "showNever"
        setEventNameFont: "md_title_large"
        setFont: "md_body_small"
        setServiceNameFont: "md_body_large"
        size: "1110,150"
    - widget:
        itemHeight: "75"
        name: "timer2"
        position: "396,400"
        rowSplit: "40"
        satPosLeft: "250"
        scrollbarMode: "showNever"
        setEventNameFont: "md_title_large"
        setFont: "md_body_small"
        setServiceNameFont: "md_body_large"
        size: "1110,150"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        name: "list"
        position: "396,590"
        scrollbarMode: "showOnDemand"
        size: "1110,152"
        valign: "center"
