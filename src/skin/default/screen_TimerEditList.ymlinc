screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "TimerEditList"
  position: "fill"
  title: "Timer Overview"
  children:
    - xmlinc:
        file: "screenpart_Screen_1_1.ymlinc"
        position: "96,54"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1240,140"
        size: "1,805"
        zPosition: "-5"
    - widget:
        iconMargin: "30"
        itemCornerRadius: "$radius_item"
        itemHeight: "90"
        name: "timerlist"
        position: "120,145"
        rowSplit: "45"
        satPosLeft: "250"
        scrollbarMode: "showNever"
        setEventNameFont: "md_title_large"
        setFont: "md_body_medium"
        setServiceNameFont: "md_body_medium"
        sidesMargin: "20"
        size: "1100,8*90"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "timerlist"
        position: "135,915"
        size: "1100,25"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "md_body_large"
        halign: "block"
        name: "description"
        position: "1255,160"
        size: "530,780"
        transparent: "1"
        valign: "center"
