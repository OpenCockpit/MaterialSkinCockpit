screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "TimerEditList"
  position: "fill"
  title: "Timer Overview"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1144,86"
        size: "1,805"
        zPosition: "-5"
    - widget:
        iconMargin: "30"
        itemCornerRadius: "$radius_item"
        itemHeight: "90"
        name: "timerlist"
        position: "24,91"
        rowSplit: "45"
        satPosLeft: "250"
        scrollbarMode: "showNever"
        setEventNameFont: "md_title_large"
        setFont: "md_body_medium"
        setServiceNameFont: "md_body_medium"
        sidesMargin: "20"
        size: "1100,8*90"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "timerlist"
        position: "39,861"
        size: "1100,25"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface_container_low"
        font: "md_body_large"
        halign: "block"
        name: "description"
        position: "1159,106"
        size: "530,770"
        transparent: "1"
        valign: "center"
