screen:
  name: "IpkgInstaller"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_IpkgInstallerBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y+715"
        width: "$window_large_body_width"
        height: "$window_large_body_height-715"
