- widget:
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    position: "0,0"
    render: "Listbox"
    size: "$width,13*$list_item_height"
    source: "deviceList"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (eval($list_indent+70), 0), size = (1000, 40), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 0), # index 0 is Name
                                                                                                MultiContentEntryText(pos = (eval($list_indent+70), 40), size = (250, 20), font=1, flags = RT_HALIGN_LEFT|RT_VALIGN_TOP, text = 1), # index 1 is type
                                                                                                MultiContentEntryText(pos = (eval($list_indent+340), 40), size = (400, 20), font=1, flags = RT_HALIGN_LEFT|RT_VALIGN_TOP, text = 2), # index 2 is status
                                                                                                MultiContentEntryPixmapAlphaTest(pos = ($list_indent, 10), size = ($list_icon_medium, $list_icon_medium), png = 3), # index 3 is bt_icon
                        ],
                        "fonts": [parseFont("md_body_medium") , parseFont("md_body_small")],
                        "itemHeight": 70
                    }

- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "deviceList"
