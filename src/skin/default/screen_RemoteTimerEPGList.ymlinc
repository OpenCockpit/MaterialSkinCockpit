screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "RemoteTimerEPGList"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_medium"
        halign: "center"
        name: "text"
        position: "$window_large_margin,676"
        size: "1620,132"
        valign: "center"
    - widget:
        name: "epglist"
        pposition: "135,160"
        scrollbarMode: "showNever"
        size: "1650,6*90"
        zPosition: "2"
