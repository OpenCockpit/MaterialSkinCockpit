screen:
  flags: "wfNoBorder"
  name: "LCDdisplayConfig"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "975,95"
        size: "1,876"
        zPosition: "-5"
    - widget:
        enableWrapAround: "1"
        font: "md_body_small"
        foregroundColor: "md_on_surface_variant"
        itemCornerRadius: "$radius_item"
        itemHeight: "35"
        name: "config"
        position: "25,93"
        scrollbarMode: "showNever"
        size: "928,807"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_primary"
        halign: "center"
        noWrap: "1"
        position: "25,913"
        render: "Label"
        size: "928,35"
        source: "introduction"
        zPosition: "2"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "config"
        maxPages: "12"
        position: "25,953"
        size: "928,25"
        zPosition: "3"
    - widget:
        alphatest: "on"
        name: "LCD1"
        position: "987,95"
        size: "922,540"
        transparent: "1"
        zPosition: "3"
    - widget:
        alphatest: "on"
        name: "LCD2"
        position: "982,655"
        scale: "1"
        size: "461,248"
        transparent: "1"
        zPosition: "3"
    - widget:
        alphatest: "on"
        name: "LCD3"
        position: "1445,655"
        scale: "1"
        size: "461,248"
        transparent: "1"
        zPosition: "3"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_secondary"
        halign: "center"
        position: "1218,365"
        render: "Label"
        size: "461,35"
        source: "LCD1text"
        zPosition: "2"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_secondary"
        halign: "center"
        position: "982,780"
        render: "Label"
        size: "461,35"
        source: "LCD2text"
        zPosition: "2"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_secondary"
        halign: "center"
        position: "1445,780"
        render: "Label"
        size: "461,35"
        source: "LCD3text"
        zPosition: "2"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_surface_container_highest"
        halign: "left"
        position: "997,952"
        render: "Label"
        size: "460,34"
        source: "Version"
        zPosition: "2"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_surface_container_highest"
        halign: "right"
        position: "1625,952"
        render: "Label"
        size: "260,34"
        source: "About"
        zPosition: "2"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_error"
        halign: "center"
        position: "1461,952"
        render: "Label"
        size: "160,34"
        source: "LibUSB"
        zPosition: "2"
