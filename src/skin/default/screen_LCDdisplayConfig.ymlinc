screen:
  flags: "wfNoBorder"
  name: "LCDdisplayConfig"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full.ymlinc"
        position: "5,5"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "980,100"
        size: "1,876"
        zPosition: "-5"
    - widget:
        enableWrapAround: "1"
        font: "$label_font"
        foregroundColor: "md_on_surface_variant"
        itemCornerRadius: "$radius_item"
        itemHeight: "35"
        name: "config"
        position: "30,98"
        scrollbarMode: "showNever"
        size: "928,807"
    - widget:
        font: "$hint_font"
        foregroundColor: "md_primary"
        halign: "center"
        noWrap: "1"
        position: "30,918"
        render: "Label"
        size: "928,35"
        source: "introduction"
        zPosition: "2"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "config"
        maxPages: "12"
        position: "30,958"
        size: "928,25"
        zPosition: "3"
    - widget:
        alphatest: "on"
        name: "LCD1"
        position: "992,100"
        size: "922,540"
        transparent: "1"
        zPosition: "3"
    - widget:
        alphatest: "on"
        name: "LCD2"
        position: "987,660"
        scale: "1"
        size: "461,248"
        transparent: "1"
        zPosition: "3"
    - widget:
        alphatest: "on"
        name: "LCD3"
        position: "1450,660"
        scale: "1"
        size: "461,248"
        transparent: "1"
        zPosition: "3"
    - widget:
        font: "$label_font"
        foregroundColor: "md_secondary"
        halign: "center"
        position: "1223,370"
        render: "Label"
        size: "461,35"
        source: "LCD1text"
        zPosition: "2"
    - widget:
        font: "$label_font"
        foregroundColor: "md_secondary"
        halign: "center"
        position: "987,785"
        render: "Label"
        size: "461,35"
        source: "LCD2text"
        zPosition: "2"
    - widget:
        font: "$label_font"
        foregroundColor: "md_secondary"
        halign: "center"
        position: "1450,785"
        render: "Label"
        size: "461,35"
        source: "LCD3text"
        zPosition: "2"
    - widget:
        font: "$hint_font"
        foregroundColor: "md_surface_container_highest"
        halign: "left"
        position: "1002,958"
        render: "Label"
        size: "460,30"
        source: "Version"
        zPosition: "2"
    - widget:
        font: "$hint_font"
        foregroundColor: "md_surface_container_highest"
        halign: "right"
        position: "1630,958"
        render: "Label"
        size: "260,30"
        source: "About"
        zPosition: "2"
    - widget:
        font: "$hint_font"
        foregroundColor: "md_error"
        halign: "center"
        position: "1466,958"
        render: "Label"
        size: "160,30"
        source: "LibUSB"
        zPosition: "2"
