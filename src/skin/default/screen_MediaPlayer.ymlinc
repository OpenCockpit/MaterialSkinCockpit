screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MediaPlayer"
  position: "fill"
  title: "MediaPlayer"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - xmlinc:
        file: "screenpart_MediaPlayerBody.ymlinc"
        position: "$window_full_body_x,$window_full_body_y"
        size: "$window_full_body_width,$window_full_body_height"
    - ePixmap:
        alphatest: "blend"
        backgroundColor: "md_surface"
        pixmap: "dvr/mpslider.png"
        position: "75,1026"
        size: "900,24"
        zPosition: "13"
    - widget:
        name: "PositionGauge"
        pointer: "dvr/pointer.png:20,5"
        position: "107,1027"
        size: "836,21"
        transparent: "0"
        zPosition: "12"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "right"
        position: "205,1019"
        render: "Label"
        size: "150,38"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServicePosition"
              text: "Position"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "left"
        position: "995,1019"
        render: "Label"
        size: "150,38"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServicePosition"
              text: "Remaining"
    - widget:
        alphatest: "blend"
        name: "repeat"
        position: "1480,1017"
        size: "105,45"
        zPosition: "10"
