screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MediaPlayer"
  position: "fill"
  title: "MediaPlayer"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full.ymlinc"
        position: "5,5"
    - eLabel:
        backgroundColor: "md_on_surface_variant"
        font: "md_title_large"
        foregroundColor: "md_shadow"
        halign: "center"
        position: "30,93"
        size: "922,39"
        text: "F i l e l i s t"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface"
        name: "filelist"
        position: "30,135"
        scrollbarMode: "showNever"
        size: "922,610"
    - eLabel:
        backgroundColor: "md_on_surface_variant"
        font: "md_title_large"
        foregroundColor: "md_shadow"
        halign: "center"
        position: "967,93"
        size: "922,39"
        text: "P l a y l i s t"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface"
        name: "playlist"
        position: "967,135"
        scrollbarMode: "showNever"
        selectionDisabled: "1"
        size: "922,610"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_medium"
        halign: "center"
        name: "title"
        position: "200,765"
        size: "1520,60"
        transparent: "1"
        valign: "top"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "190,817"
        size: "1540,3"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "titletext"
        position: "200,832"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "currenttext"
        position: "350,832"
        size: "1200,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "artisttext"
        position: "200,877"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        name: "artist"
        position: "350,877"
        size: "1020,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "albumtext"
        position: "200,922"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        name: "album"
        position: "350,922"
        size: "1020,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "yeartext"
        position: "200,967"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        name: "year"
        position: "350,967"
        size: "375,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "genretext"
        position: "825,967"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "genre"
        position: "975,967"
        size: "517,37"
        transparent: "1"
        valign: "top"
    - widget:
        alphatest: "blend"
        name: "coverArt"
        pixmap: "no_coverArt.png"
        position: "30,817"
        size: "116,116"
        transparent: "1"
    - ePixmap:
        alphatest: "blend"
        backgroundColor: "md_surface"
        pixmap: "dvr/mpslider.png"
        position: "80,1031"
        size: "900,24"
        zPosition: "13"
    - widget:
        name: "PositionGauge"
        pointer: "dvr/pointer.png:20,5"
        position: "112,1032"
        size: "836,21"
        transparent: "0"
        zPosition: "12"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "right"
        position: "210,1025"
        render: "Label"
        size: "150,35"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServicePosition"
              text: "Position"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "left"
        position: "1000,1025"
        render: "Label"
        size: "150,35"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServicePosition"
              text: "Remaining"
    - widget:
        alphatest: "blend"
        name: "repeat"
        position: "1485,1022"
        size: "105,45"
        zPosition: "10"
