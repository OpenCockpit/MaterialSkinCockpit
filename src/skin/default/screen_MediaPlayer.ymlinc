screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MediaPlayer"
  position: "fill"
  title: "MediaPlayer"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - eLabel:
        backgroundColor: "md_on_surface_variant"
        font: "md_title_large"
        foregroundColor: "md_shadow"
        halign: "center"
        position: "25,86"
        size: "922,43"
        text: "F i l e l i s t"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface"
        name: "filelist"
        position: "25,130"
        scrollbarMode: "showNever"
        size: "922,610"
    - eLabel:
        backgroundColor: "md_on_surface_variant"
        font: "md_title_large"
        foregroundColor: "md_shadow"
        halign: "center"
        position: "962,86"
        size: "922,43"
        text: "P l a y l i s t"
        zPosition: "5"
    - widget:
        backgroundColor: "md_surface"
        name: "playlist"
        position: "962,130"
        scrollbarMode: "showNever"
        selectionDisabled: "1"
        size: "922,610"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_medium"
        halign: "center"
        name: "title"
        position: "195,760"
        size: "1520,60"
        transparent: "1"
        valign: "top"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "185,812"
        size: "1540,3"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "titletext"
        position: "195,827"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "currenttext"
        position: "345,827"
        size: "1200,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "artisttext"
        position: "195,872"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        name: "artist"
        position: "345,872"
        size: "1020,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "albumtext"
        position: "195,917"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        name: "album"
        position: "345,917"
        size: "1020,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "yeartext"
        position: "195,962"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        name: "year"
        position: "345,962"
        size: "375,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "genretext"
        position: "820,962"
        size: "150,37"
        transparent: "1"
        valign: "top"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_surface_container_highest"
        name: "genre"
        position: "970,962"
        size: "517,37"
        transparent: "1"
        valign: "top"
    - widget:
        alphatest: "blend"
        name: "coverArt"
        pixmap: "no_coverArt.png"
        position: "25,812"
        size: "116,116"
        transparent: "1"
    - ePixmap:
        alphatest: "blend"
        backgroundColor: "md_surface"
        pixmap: "dvr/mpslider.png"
        position: "75,1026"
        size: "900,24"
        zPosition: "13"
    - widget:
        name: "PositionGauge"
        pointer: "dvr/pointer.png:20,5"
        position: "107,1027"
        size: "836,21"
        transparent: "0"
        zPosition: "12"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "right"
        position: "205,1019"
        render: "Label"
        size: "150,38"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServicePosition"
              text: "Position"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        halign: "left"
        position: "995,1019"
        render: "Label"
        size: "150,38"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServicePosition"
              text: "Remaining"
    - widget:
        alphatest: "blend"
        name: "repeat"
        position: "1480,1017"
        size: "105,45"
        zPosition: "10"
