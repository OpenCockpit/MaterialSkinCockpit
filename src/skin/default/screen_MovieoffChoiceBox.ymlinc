screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MovieoffChoiceBox"
  position: "fill"
  title: "Sorting"
  children:
    - xmlinc:
        file: "screen_ChoiceBox.ymlinc"
        position: "0,0"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/ask.png"
        position: "1838,108"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/movielist.png"
        position: "1838,146"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/quit.png"
        position: "1838,184"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/pause.png"
        position: "1838,222"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/playlist.png"
        position: "1838,260"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/playlistquit.png"
        position: "1838,298"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/loop.png"
        position: "1838,336"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/rep.png"
        position: "1838,374"
        size: "52,30"
        transparent: "1"
        zPosition: "2"
