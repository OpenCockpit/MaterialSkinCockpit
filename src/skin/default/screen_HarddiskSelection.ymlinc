screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "HarddiskSelection"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemHeight: "45"
        name: "hddlist"
        position: "$window_medium_content_x,$window_medium_content_y"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,$window_medium_list_height"
        textOffset: "20,5"
