# The config list takes the left half of the body, the previews of the display(s) the right one (rw = $width/2-20, from
# x = $width/2+20): LCD1 as wide as the pane, in the aspect of the display (922:540), LCD2 and LCD3 side by side below it,
# 400 wide each (aspect 461:248, 215 high). The texts of the previews are centered on them.
- eLabel:
    backgroundColor: "md_outline_variant"
    position: "eval($width/2+10),2"
    size: "1,$height-33"
    zPosition: "-5"
- widget:
    enableWrapAround: "1"
    font: "md_body_medium"
    foregroundColor: "md_on_surface_variant"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "eval($width/2),eval(($height-104)/$list_item_height*$list_item_height)"
- widget:
    font: "md_body_small"
    foregroundColor: "md_primary"
    halign: "center"
    noWrap: "1"
    position: "0,$height-89"
    render: "Label"
    size: "eval($width/2),35"
    source: "introduction"
    zPosition: "2"
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "config"
    maxPages: "12"
    position: "0,$height-49"
    size: "eval($width/2),25"
    zPosition: "3"
- widget:
    alphatest: "on"
    name: "LCD1"
    position: "eval($width/2+20),2"
    size: "eval($width/2-20),eval(($width/2-20)*540/922)"
    transparent: "1"
    zPosition: "3"
- widget:
    alphatest: "on"
    name: "LCD2"
    position: "eval($width/2+20),eval(22+($width/2-20)*540/922)"
    scale: "1"
    size: "400,215"
    transparent: "1"
    zPosition: "3"
- widget:
    alphatest: "on"
    name: "LCD3"
    position: "$width-400,eval(22+($width/2-20)*540/922)"
    scale: "1"
    size: "400,215"
    transparent: "1"
    zPosition: "3"
- widget:
    font: "md_body_small"
    foregroundColor: "md_secondary"
    halign: "center"
    position: "eval($width/2+20+($width/2-20-461)/2),eval(2+(($width/2-20)*540/922-35)/2)"
    render: "Label"
    size: "461,35"
    source: "LCD1text"
    zPosition: "2"
- widget:
    font: "md_body_small"
    foregroundColor: "md_secondary"
    halign: "center"
    position: "eval($width/2+20),eval(131+($width/2-20)*540/922)"
    render: "Label"
    size: "400,35"
    source: "LCD2text"
    zPosition: "2"
- widget:
    font: "md_body_small"
    foregroundColor: "md_secondary"
    halign: "center"
    position: "$width-400,eval(131+($width/2-20)*540/922)"
    render: "Label"
    size: "400,35"
    source: "LCD3text"
    zPosition: "2"
- widget:
    font: "md_body_small"
    foregroundColor: "md_surface_container_highest"
    halign: "left"
    position: "eval($width/2+20),$height-34"
    render: "Label"
    size: "eval($width/2-20-428),34"
    source: "Version"
    zPosition: "2"
- widget:
    font: "md_body_small"
    foregroundColor: "md_surface_container_highest"
    halign: "right"
    position: "$width-260,$height-34"
    render: "Label"
    size: "260,34"
    source: "About"
    zPosition: "2"
- widget:
    font: "md_body_small"
    foregroundColor: "md_error"
    halign: "center"
    position: "$width-424,$height-34"
    render: "Label"
    size: "160,34"
    source: "LibUSB"
    zPosition: "2"
