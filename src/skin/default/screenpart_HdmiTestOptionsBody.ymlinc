- widget:
    backgroundColor: "md_surface"
    enableWrapAround: "1"
    font: "md_body_large"
    foregroundColor: "md_on_surface"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,10*$list_item_height"
    transparent: "1"
