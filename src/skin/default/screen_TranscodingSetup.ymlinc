screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "TranscodingSetup"
  position: "fill"
  title: "Transcoding Setup"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemHeight: "45"
        name: "config"
        position: "$window_medium_content_x,$window_medium_content_y"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,$window_medium_list_height"
    - widget:
        backgroundColor: "md_surface"
        name: "pager"
        pagerBackground: "md_surface"
        pagerForeground: "md_on_surface"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
