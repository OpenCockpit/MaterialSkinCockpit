screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "InputDeviceSelection"
  position: "fill"
  title: "Select input device"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        itemCornerRadius: "$radius_item"
        position: "389,195"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1145,649"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                		{
                			"template": [
                				MultiContentEntryPixmapAlphaTest(pos = (15, 29), size = (48, 48), png = 2), # index 3 is the interface pixmap
                																					MultiContentEntryText(pos = (120, 9), size = (990, 81), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER|RT_WRAP, text = 1), # index 1 is the interfacename
                			],
                			"fonts": [parseFont("md_title_large"), parseFont("md_label_large")],
                			"itemHeight": 105
                		}
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "md_body_large"
        halign: "center"
        position: "390,847"
        render: "Label"
        shadowColor: "md_shadow"
        shadowOffset: "-2,-2"
        size: "1145,40"
        source: "introduction"
        transparent: "1"
        zPosition: "1"
