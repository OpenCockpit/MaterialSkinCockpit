screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "EPGSearchHistory"
  position: "fill"
  title: "EPGSearch - History"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        position: "0,0"
        render: "Label"
        size: "0,0"
        source: "help"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        position: "$window_medium_content_x,$window_medium_content_y"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,$window_medium_list_height"
        source: "history"
        transparent: "1"
        children:
          - convert:
              type: "StringList"
