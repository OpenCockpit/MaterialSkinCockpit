screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "EPGSearchHistory"
  position: "fill"
  title: "EPGSearch - History"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        backgroundColor: "md_surface"
        font: "$list_font"
        position: "30,570"
        render: "Label"
        size: "0,0"
        source: "help"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "$text_font"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        position: "396,210"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1130,635"
        source: "history"
        transparent: "1"
        children:
          - convert:
              type: "StringList"
