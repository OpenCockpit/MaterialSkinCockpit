screen:
  flags: "wfNoBorder"
  name: "VideoWizard"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_WizardPictureLangTemplate.ymlinc"
        position: "192,86"
        size: "1590,895"
    - xmlinc:
        file: "screenpart_RemoteControlTemplate.ymlinc"
        position: "1628,236"
    - widget:
        font: "md_title_large"
        name: "text"
        position: "202,186"
        size: "1416,400"
        valign: "center"
    - widget:
        alphatest: "on"
        name: "portpic"
        position: "202,586"
        size: "150,150"
        transparent: "1"
        zPosition: "10"
    - widget:
        font: "md_title_large"
        itemCornerRadius: "$radius_item"
        position: "352,586"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1266,295"
        source: "list"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos = (0, 0), size = (1035, 42), flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = 0)
                            ],
                            "fonts": [parseFont("md_title_large")],
                            "itemHeight": 42
                        }
