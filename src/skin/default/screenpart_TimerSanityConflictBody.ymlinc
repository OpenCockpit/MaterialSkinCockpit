- widget:
    itemHeight: "75"
    name: "timer1"
    position: "0,0"
    rowSplit: "40"
    satPosLeft: "250"
    scrollbarMode: "showNever"
    setEventNameFont: "md_title_large"
    setFont: "md_body_small"
    setServiceNameFont: "md_body_large"
    size: "$width,150"
- widget:
    itemHeight: "75"
    name: "timer2"
    position: "0,190"
    rowSplit: "40"
    satPosLeft: "250"
    scrollbarMode: "showNever"
    setEventNameFont: "md_title_large"
    setFont: "md_body_small"
    setServiceNameFont: "md_body_large"
    size: "$width,150"
- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height_compact"
    name: "list"
    position: "0,380"
    scrollbarMode: "showOnDemand"
    size: "$width,4*$list_item_height_compact"
    valign: "center"
