screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "StreamingClientsInfo"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menu"
        position: "$window_medium_content_x,$window_medium_content_y"
        scrollbarMode: "showNever"
        size: "$window_medium_content_width,$window_medium_list_height"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "menu"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
    - widget:
        font: "md_body_medium"
        halign: "center"
        name: "info"
        position: "38,95"
        size: "1110,38"
        transparent: "1"
        zPosition: "2"
