screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "StreamingClientsInfo"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        font: "$text_font"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "menu"
        position: "396,210"
        scrollbarMode: "showNever"
        size: "1130,635"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "menu"
        position: "396,849"
        size: "1130,25"
        transparent: "1"
    - widget:
        font: "$text_font"
        halign: "center"
        name: "info"
        position: "408,213"
        size: "1110,38"
        transparent: "1"
        zPosition: "2"
