screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "PluginDownloadBrowser"
  position: "fill"
  title: "Downloadable plugins"
  children:
    - xmlinc:
        file: "screenpart_Window_Wide.ymlinc"
        position: "252,111"
    - widget:
        itemCornerRadius: "$radius_item"
        name: "list"
        position: "30,99"
        scrollbarMode: "showNever"
        size: "1356,610"
    - widget:
        font: "md_title_large"
        halign: "center"
        name: "text"
        position: "147,114"
        size: "1110,130"
        transparent: "1"
        valign: "center"
        zPosition: "-1"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        position: "144,724"
        size: "1130,25"
        transparent: "1"
