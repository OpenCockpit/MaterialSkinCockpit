screen:
  backgroundColor: "md_transparent"
  name: "MMIDialog"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        font: "md_title_large"
        name: "title"
        position: "396,212"
        size: "900,36"
    - widget:
        font: "md_title_large"
        name: "subtitle"
        position: "396,248"
        size: "900,36"
    - widget:
        font: "md_title_large"
        itemCornerRadius: "$radius_item"
        itemHeight: "35"
        name: "entries"
        position: "396,294"
        scrollbarMode: "showOnDemand"
        size: "1130,510"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "entries"
        position: "396,849"
        size: "1130,25"
        transparent: "1"
    - widget:
        font: "md_title_large"
        name: "bottom"
        position: "397,797"
        size: "900,36"
