screen:
  backgroundColor: "md_transparent"
  name: "MMIDialog"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        font: "md_title_large"
        name: "title"
        position: "26,93"
        size: "900,43"
    - widget:
        font: "md_title_large"
        name: "subtitle"
        position: "26,129"
        size: "900,43"
    - widget:
        font: "md_title_large"
        itemCornerRadius: "$radius_item"
        itemHeight: "35"
        name: "entries"
        position: "26,176"
        scrollbarMode: "showOnDemand"
        size: "$window_medium_content_width,510"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "entries"
        position: "$window_medium_content_x,$window_medium_pager_y"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
    - widget:
        font: "md_title_large"
        name: "bottom"
        position: "27,678"
        size: "900,43"
