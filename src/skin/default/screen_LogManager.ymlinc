screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "LogManager"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "center"
    - widget:
        enableWrapAround: "1"
        font: "md_body_large"
        name: "list"
        position: "$window_medium_content_x,$window_medium_content_y"
        scrollbarMode: "showNever"
        size: "1130,16*38"
        transparent: "0"
    - applet:
        type: "onLayoutFinish"
        text: "self[\"list\"].instance.setItemHeight(38)"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        position: "26,547"
        size: "$window_medium_content_width,$window_medium_pager_height"
        transparent: "1"
