screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoTimerPreview"
  position: "fill"
  title: "Preview AutoTimer"
  children:
    - widget:
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        itemCornerRadius: "$radius_item"
        position: "780,105"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1110,896"
        source: "timerlist"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                        {
                            "template": [
                                MultiContentEntryText(pos=(10,5), size=(1100,38), text = 3, font = 0, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER),
                                MultiContentEntryText(pos=(10,43), size=(1100,32), text = 0, font = 1, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER),
                                MultiContentEntryText(pos=(10,75), size=(545,32), text = 4, font = 1, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER),
                                MultiContentEntryText(pos=(555,75), size=(545,32), text = 2, font = 1, flags = RT_HALIGN_RIGHT|RT_VALIGN_CENTER),
                            ],
                            "fonts": [parseFont("md_title_large"), parseFont("md_body_medium")],
                            "itemHeight": 112
                        }
