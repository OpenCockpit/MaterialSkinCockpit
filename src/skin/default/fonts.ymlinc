- fonts:
    children:
      - font:
          filename: "OpenSans-Regular.ttf"
          name: "Regular"
          scale: "89"
      - font:
          filename: "Roboto-Bold.ttf"
          name: "Bold"
          scale: "71"
      - font:
          filename: "fonts/Bignoodletitling.ttf"
          name: "CAID"
          scale: "100"
      - font:
          filename: "tuxtxt.ttf"
          name: "Console"
          scale: "100"
      - font:
          filename: "andale.ttf"
          name: "Fixed"
          scale: "100"
      - alias:
          font: "Regular"
          name: "md_label_medium"
          size: "20"
      - alias:
          font: "Regular"
          name: "md_body_small"
          size: "26"
      - alias:
          font: "Regular"
          name: "md_body_medium"
          size: "28"
      - alias:
          font: "Regular"
          name: "md_body_large"
          size: "30"
      - alias:
          font: "Regular"
          name: "md_title_large"
          size: "34"
      - alias:
          font: "Regular"
          name: "md_headline_medium"
          size: "40"
      - alias:
          font: "Regular"
          name: "md_display_small"
          size: "50"
      - alias:
          font: "Regular"
          name: "md_display_large"
          size: "108"
      - alias:
          font: "Bold"
          name: "md_label_small_emphasized"
          size: "18"
      - alias:
          font: "Bold"
          name: "md_title_small_emphasized"
          size: "28"
      - alias:
          font: "Bold"
          name: "md_title_medium_emphasized"
          size: "30"
      - alias:
          font: "Bold"
          name: "md_headline_small_emphasized"
          size: "36"
      - alias:
          font: "Bold"
          name: "md_headline_large_emphasized"
          size: "42"
      - alias:
          font: "Bold"
          name: "md_display_medium_emphasized"
          size: "60"
      - alias:
          font: "Fixed"
          name: "mono_font"
          size: "26"
      - alias:
          font: "Console"
          name: "console_font"
          size: "27"
      - alias:
          font: "CAID"
          name: "caid_font"
          size: "36"

# the files shared with the plugins (Common) use $md_... for the fonts: here the name of the alias
- global:
    name: "md_label_medium"
    value: "md_label_medium"
- global:
    name: "md_body_small"
    value: "md_body_small"
- global:
    name: "md_body_medium"
    value: "md_body_medium"
- global:
    name: "md_body_large"
    value: "md_body_large"
- global:
    name: "md_title_large"
    value: "md_title_large"
- global:
    name: "md_headline_medium"
    value: "md_headline_medium"
- global:
    name: "md_display_small"
    value: "md_display_small"
- global:
    name: "md_display_large"
    value: "md_display_large"
- global:
    name: "md_label_small_emphasized"
    value: "md_label_small_emphasized"
- global:
    name: "md_title_small_emphasized"
    value: "md_title_small_emphasized"
- global:
    name: "md_title_medium_emphasized"
    value: "md_title_medium_emphasized"
- global:
    name: "md_headline_small_emphasized"
    value: "md_headline_small_emphasized"
- global:
    name: "md_headline_large_emphasized"
    value: "md_headline_large_emphasized"
- global:
    name: "md_display_medium_emphasized"
    value: "md_display_medium_emphasized"
