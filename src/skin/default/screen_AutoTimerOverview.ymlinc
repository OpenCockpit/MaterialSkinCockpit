screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoTimerOverview"
  position: "fill"
  title: "AutoTimer Overview"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        DayNameFont: "md_body_large"
        EventNameFont: "md_title_large"
        ServiceNameFont: "md_title_large"
        iconMargin: "20"
        itemCornerRadius: "$radius_item"
        itemHeight: "90"
        name: "entries"
        position: "19,106"
        rowHeight: "42"
        rowSplit1: "50"
        rowSplit2: "45"
        scrollbarMode: "showNever"
        size: "1690,8*90"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "entries"
        position: "$window_large_margin,861"
        size: "$window_large_inner_width,25"
        transparent: "1"
