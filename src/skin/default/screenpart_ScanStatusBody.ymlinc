- param: {name: "width"}
- param: {name: "height"}
- widget:
    font: "md_body_large"
    name: "scan_state"
    position: "0,37"
    size: "810,70"
    transparent: "1"
    valign: "top"
    zPosition: "2"
- widget:
    borderColor: "md_outline"
    borderWidth: "2"
    cornerRadius: "$radius_bar"
    name: "scan_progress"
    pixmap: "progress_big.png"
    position: "0,0"
    size: "810,22"
