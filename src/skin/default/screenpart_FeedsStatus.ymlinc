screen:
  flags: "wfNoBorder"
  name: "FeedsStatus"
  position: "fill"
  children:
    - widget:
        conditional: "feedStatusMSG"
        font: "md_body_medium"
        foregroundColor: "md_primary"
        halign: "center"
        name: "feedStatusMSG"
        position: "0,235"
        size: "690,300"
        zPosition: "1000"
    - widget:
        alphatest: "on"
        name: "tl_off"
        pixmap: "icons/aoff.png"
        position: "141,0"
        size: "36,97"
    - widget:
        alphatest: "on"
        name: "tl_red"
        pixmap: "icons/ared.png"
        position: "141,0"
        size: "36,97"
    - widget:
        alphatest: "on"
        name: "tl_yellow"
        pixmap: "icons/ayellow.png"
        position: "141,0"
        size: "36,97"
    - widget:
        alphatest: "on"
        name: "tl_green"
        pixmap: "icons/agreen.png"
        position: "141,0"
        size: "36,97"
