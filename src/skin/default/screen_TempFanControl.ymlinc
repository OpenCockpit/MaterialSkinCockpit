screen:
  flags: "wfNoBorder"
  name: "TempFanControl"
  position: "fill"
  title: "Fan Control"
  children:
    - ePixmap:
        alphatest: "on"
        pixmap: "buttons/key_red.png"
        position: "192,1039"
        size: "40,20"
    - ePixmap:
        alphatest: "on"
        pixmap: "buttons/key_green.png"
        position: "628,1039"
        size: "40,20"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "$list_large_font"
        foregroundColor: "md_on_surface_variant"
        halign: "left"
        position: "242,1030"
        render: "Label"
        size: "370,38"
        source: "red"
        transparent: "1"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface_container_highest"
        font: "$list_large_font"
        foregroundColor: "md_on_surface_variant"
        halign: "left"
        position: "678,1030"
        render: "Label"
        size: "370,38"
        source: "green"
        transparent: "1"
        zPosition: "2"
    - widget:
        font: "$text_font"
        itemCornerRadius: "$radius_item"
        itemHeight: "38"
        name: "config"
        position: "780,105"
        scrollbarMode: "showOnDemand"
        size: "1110,180"
    - widget:
        backgroundColor: "md_surface_overlay_soft"
        font: "$list_font"
        halign: "left"
        position: "795,315"
        render: "Label"
        size: "135,60"
        source: "SensorTempText0"
        transparent: "1"
        valign: "top"
        zPosition: "1"
    - widget:
        font: "$text_font"
        halign: "right"
        position: "930,315"
        render: "Label"
        size: "150,30"
        source: "SensorTemp0"
        zPosition: "1"
        children:
          - convert:
              type: "SensorToText"
