screen:
  name: "QuickSubtitlesConfigMenu"
  position: "fill"
  resolution: "1920,1080"
  title: "Subtitle settings"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "20,30"
        dialog_height: "eval(9*$list_item_height+44+$window_dialog_trim_y)"
        dialog_width: "eval(910+$window_dialog_trim_x)"
        size: "$dialog_width,$dialog_height"
        window_inset_x: "$window_dialog_body_x"
    - widget:
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "$list_item_height"
        name: "config"
        position: "$window_dialog_body_x,$window_dialog_body_y"
        size: "$dialog_width-$window_dialog_trim_x,9*$list_item_height"
        transparent: "1"
        zPosition: "1"
    - widget:
        font: "md_body_small"
        foregroundColor: "md_tertiary"
        halign: "left"
        name: "videofps"
        position: "$window_dialog_body_x,eval($window_dialog_body_y+9*$list_item_height+10)"
        size: "$dialog_width-$window_dialog_trim_x,34"
        transparent: "1"
        valign: "center"
        zPosition: "1"
