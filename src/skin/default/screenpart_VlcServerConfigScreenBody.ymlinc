- eLabel:
    backgroundColor: "md_surface"
    font: "md_headline_medium"
    halign: "center"
    position: "$width-615,0"
    size: "615,50"
    text: "Edit VLC Server"
    transparent: "1"
- widget:
    enableWrapAround: "1"
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "config"
    position: "0,1"
    scrollbarMode: "showNever"
    size: "1095,16*$list_item_height"
    transparent: "1"
- ePixmap:
    alphatest: "blend"
    pixmap: "MaterialSkinCockpit/icons/db.png"
    position: "$width-600,661"
    size: "600,99"
    transparent: "1"
    zPosition: "2"
