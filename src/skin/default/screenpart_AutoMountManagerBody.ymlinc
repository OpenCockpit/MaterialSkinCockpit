- widget:
    itemCornerRadius: "$radius_item"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showOnDemand"
    size: "$width,eval(($height-48)/90*90)"
    source: "config"
    transparent: "1"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (20, 7), size = (eval($width-40), 42), font=0, flags = RT_HALIGN_LEFT, text = 0), # index 2 is the Menu Titel
                                                                                                        MultiContentEntryText(pos = (20, 52), size = (eval($width-40), 30), font=1, flags = RT_HALIGN_LEFT, text = 2), # index 3 is the Description
                        ],
                        "fonts": [parseFont("md_title_large"), parseFont("md_body_small")],
                        "itemHeight": 90
                    }
- widget:
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "center"
    position: "0,$height-38"
    render: "Label"
    size: "$width,38"
    source: "introduction"
    transparent: "1"
    valign: "center"
    zPosition: "10"
