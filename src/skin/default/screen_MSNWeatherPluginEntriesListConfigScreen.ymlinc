screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MSNWeatherPluginEntriesListConfigScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small_emphasized"
        halign: "left"
        position: "$window_large_margin,96"
        render: "Label"
        size: "400,50"
        source: "city"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small_emphasized"
        halign: "left"
        position: "804,96"
        render: "Label"
        size: "130,50"
        source: "degreetype"
    - widget:
        conditional: "entrylist"
        font: "md_body_medium"
        itemHeight: "45"
        name: "entrylist"
        position: "29,146"
        scrollbarMode: "showNever"
        size: "1670,12*45"
        valign: "center"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "entrylist"
        connection: "entrylist"
        position: "$window_large_margin,861"
        size: "$window_large_inner_width,25"
        transparent: "1"
