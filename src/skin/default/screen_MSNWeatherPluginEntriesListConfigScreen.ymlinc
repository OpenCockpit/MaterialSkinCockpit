screen:
  name: "MSNWeatherPluginEntriesListConfigScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreen.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_MSNWeatherPluginEntriesListConfigScreenBody.ymlinc"
        position: "$window_large_body_x,$window_large_body_y"
        width: "$window_large_body_width"
        height: "$window_large_body_height"
