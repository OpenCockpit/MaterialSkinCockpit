- widget:
    position: "8,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "1640,225"
    source: "search_info"
    transparent: "1"
    zPosition: "3"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                {"templates":
                                                                    {"default": (33, [
                                                                        MultiContentEntryText(pos = (0, 0),   size = (620, 33),  font = 0, color = "md_primary", flags = RT_HALIGN_LEFT,  text = 0), # langname,
                        MultiContentEntryText(pos = (307, 0),   size = (920, 33),  font = 0, flags = RT_HALIGN_LEFT,  text = 1)
                    ], False, "showNever"),
                                                                    },
                    "fonts": [parseFont("md_body_small")],
                    "itemHeight": 33,
                }
- widget:
