    position: "0,300"
    size: "1655,390"
    valign: "center"
    zPosition: "4"
- widget:
    font: "md_body_medium"
    foregroundColor: "md_error"
    halign: "center"
    name: "errormessage"
    position: "0,300"
    size: "1655,390"
    valign: "center"
    zPosition: "5"
- widget:
    itemCornerRadius: "$radius_item"
    position: "0,300"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "1655,440"
    source: "subtitles"
    transparent: "1"
    zPosition: "3"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                {"templates":
                                                                    {"default": (40, [
                                                                        MultiContentEntryPixmapAlphaBlend(pos = (10, 4),   size = (36, 36), png=0), # key,
                        MultiContentEntryText(pos = (55, 2),   size = (150, 37),  font = 0, flags = RT_HALIGN_LEFT,  text = 1), # language,
                        MultiContentEntryText(pos = (220, 2),  size = (1022, 37),  font = 0, flags = RT_HALIGN_LEFT,  text = 2), # filename,
                        MultiContentEntryText(pos = (1270, 2), size = (302, 37), font = 0, flags = RT_HALIGN_LEFT,  text = 3), # site,
                        MultiContentEntryPixmapAlphaBlend(pos = (1607, 8),   size = (36, 36), png=4), # syncPng,
                    ], True, "showNever"),
                                                                    },
                    "fonts": [parseFont("md_body_small"), parseFont("md_label_medium")],
                    "itemHeight": 40
                }
- widget:
    addon: "Pager"
    backgroundColor: "md_surface"
    connection: "subtitles"
    position: "0,750"
    size: "1655,25"
    transparent: "1"
