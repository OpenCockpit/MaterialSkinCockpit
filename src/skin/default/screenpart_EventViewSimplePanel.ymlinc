- xmlinc:
    file: "screenpart_WindowBase.ymlinc"
    position: "0,0"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "left"
    position: "30,93"
    render: "Label"
    size: "$width-260,70"
    source: "Service"
    valign: "top"
    children:
      - convert:
          type: "MovieInfo"
          text: "Name"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    foregroundColor: "md_tertiary"
    halign: "right"
    position: "$width-240,93"
    render: "Label"
    size: "200,80"
    source: "Event"
    valign: "top"
    zPosition: "1"
    children:
      - convert:
          type: "EventName"
          text: "Rating"
- widget:
    backgroundColor: "md_surface"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_on_surface"
    halign: "left"
    position: "30,140"
    render: "Label"
    size: "$width-620,50"
    source: "Service"
    transparent: "1"
    children:
      - convert:
          type: "MovieInfo"
          text: "RecordServiceName"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_small_emphasized"
    halign: "left"
    position: "30,$height-140"
    render: "Label"
    size: "340,40"
    source: "Event"
    transparent: "1"
    children:
      - convert:
          type: "EventTime"
          text: "Times"
      - convert:
          type: "ClockToText"
          text: "LongFullDate,Default"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_small_emphasized"
    foregroundColor: "md_secondary"
    halign: "left"
    name: "duration"
    position: "370,$height-140"
    size: "340,40"
    transparent: "1"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    foregroundColor: "md_tertiary"
    halign: "left"
    position: "714,$height-145"
    render: "Label"
    size: "670,45"
    source: "Event"
    zPosition: "1"
    children:
      - convert:
          type: "EventName"
          text: "Genre"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    halign: "block"
    name: "FullDescription"
    position: "30,212"
    scrollbarMode: "showNever"
    size: "$width-50,$height-536"
- widget:
    addon: "Pager"
    connection: "FullDescription"
    position: "30,212+$height-511"
    size: "$width-50,25"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_on_surface"
    halign: "right"
    position: "$width-438,2"
    render: "Label"
    size: "420,64"
    source: "global.CurrentTime"
    transparent: "1"
    valign: "center"
    zPosition: "20"
    children:
      - convert:
          type: "ClockToText"
          text: "Default"
- widget:
    backgroundColor: "md_surface_container_low"
    font: "md_headline_small_emphasized"
    foregroundColor: "md_primary"
    halign: "left"
    position: "22,2"
    render: "Label"
    size: "$width-420,64"
    source: "Title"
    transparent: "1"
    valign: "center"
- widget:
    alphatest: "blend"
    backgroundColor: "md_surface"
    position: "$width-304,$height-270"
    render: "Picon"
    size: "227,130"
    source: "Service"
    transparent: "1"
    zPosition: "1"
    children:
      - convert:
          type: "MovieInfo"
          text: "RecordServiceRef"
