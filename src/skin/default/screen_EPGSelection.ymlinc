screen:
  flags: "wfNoBorder"
  name: "EPGSelection"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Window_Full_Big_Pig.ymlinc"
        position: "5,5"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "1135,105"
        size: "1,870"
        zPosition: "-5"
    - widget:
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "26,91"
        scrollbarMode: "showNever"
        setColGap: "40"
        setColWidths: "120,220"
        setEventItemFont: "md_title_large"
        setIconDistance: "10"
        sidesMargin: "25"
        size: "1095,890"
        transparent: "1"
    - widget:
        font: "md_title_large"
        foregroundColor: "md_primary"
        position: "1160,382"
        render: "Label"
        size: "720,36"
        source: "Event"
        transparent: "1"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - widget:
        font: "md_body_large"
        halign: "block"
        options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
        position: "1159,467"
        render: "COCRunningText"
        size: "720,470"
        source: "Event"
        transparent: "1"
        valign: "top"
        children:
          - convert:
              type: "EventName"
              text: "FullDescription"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_secondary"
        position: "1162,957"
        render: "Label"
        size: "330,34"
        source: "Event"
        transparent: "1"
        children:
          - convert:
              type: "EventTime"
              text: "StartTime"
          - convert:
              type: "ClockToText"
              text: "ShortDate"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_secondary"
        halign: "right"
        position: "1353,957"
        render: "Label"
        size: "120,34"
        source: "Event"
        transparent: "1"
        children:
          - convert:
              type: "EventTime"
              text: "StartTime"
          - convert:
              type: "ClockToText"
              text: "Format:%H:%M"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_secondary"
        halign: "left"
        position: "1475,957"
        render: "Label"
        size: "120,34"
        source: "Event"
        transparent: "1"
        children:
          - convert:
              type: "EventTime"
              text: "EndTime"
          - convert:
              type: "ClockToText"
              text: "Format:- %H:%M"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_secondary"
        halign: "left"
        position: "1659,957"
        render: "Label"
        size: "165,34"
        source: "Event"
        transparent: "1"
        children:
          - convert:
              type: "EventTime"
              text: "Duration"
          - convert:
              type: "ClockToText"
              text: "InMinutes"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        foregroundColor: "md_secondary"
        halign: "right"
        position: "1726,957"
        render: "Label"
        size: "160,34"
        source: "Event"
        transparent: "1"
        children:
          - convert:
              type: "EventTime"
              text: "Duration"
          - convert:
              type: "ClockToText"
              text: "AsLengthHours"
    - widget:
        alphatest: "blend"
        position: "1190,155"
        render: "Picon"
        size: "200,120"
        source: "Service"
        zPosition: "12"
        children:
          - convert:
              type: "ServiceName"
              text: "Reference"
