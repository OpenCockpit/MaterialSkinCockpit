- widget:
    itemCornerRadius: "$radius_item"
    itemHeight: "54"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width,594"
    source: "list"
    children:
      - convert:
          type: "TemplatedMultiContent"
          text: |
                    {
                        "template": [
                            MultiContentEntryText(pos = (5, 2), size = (829, 28), font=0, flags = RT_HALIGN_LEFT, text = 0), # index 0 is the name
                                                                                                    MultiContentEntryText(pos = (5, 28), size = (829, 20), font=1, flags = RT_HALIGN_LEFT, text = 2), # index 2 is the description
                                                                                                    MultiContentEntryPixmapAlphaBlend(pos = (840, 3), size = (48, 48), png = 4, flags=BT_SCALE), # index 4 is the status pixmap
                        ],
                        "fonts": [parseFont("md_body_small"), parseFont("md_label_medium")],
                        "itemHeight": 54
                    }
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
