screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "TimeshiftState"
  position: "163,804"
  size: "1600,58"
  zPosition: "0"
  children:
    - eLabel:
        backgroundColor: "md_surface_container_high"
        cornerRadius: "$radius_infobar;top"
        position: "5,2"
        size: "1590,56"
        zPosition: "-11"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_infobar_inner;top"
        position: "7,4"
        size: "1586,54"
        zPosition: "-10"
    - widget:
        alphatest: "blend"
        name: "statusicon"
        pixmaps: "icons/pvr/play.svg,icons/pvr/pause.svg,icons/pvr/stop.svg,icons/pvr/ff.svg,icons/pvr/rew.svg,icons/pvr/slow.svg"
        position: "15,15"
        size: "40,35"
        zPosition: "3"
    - widget:
        backgroundColor: "md_surface"
        font: "$event_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "speed"
        position: "70,12"
        size: "35,40"
        valign: "center"
    - widget:
        pointer: "dvr/position_pointer1100.png:1100,4"
        position: "265,22"
        render: "PositionGauge"
        size: "1100,18"
        source: "session.CurrentService"
        transparent: "1"
        zPosition: "4"
        children:
          - convert:
              type: "ServicePosition"
              text: "Gauge"
    - widget:
        backgroundColor: "md_surface"
        borderColor: "md_outline_variant"
        borderWidth: "2"
        font: "$list_large_font"
        foregroundColor: "md_on_surface"
        halign: "left"
        position: "120,5"
        render: "Label"
        size: "135,50"
        source: "session.CurrentService"
        valign: "center"
        zPosition: "4"
        children:
          - convert:
              type: "ServicePosition"
              text: "Position,ShowHours"
    - widget:
        backgroundColor: "md_surface"
        borderColor: "md_outline_variant"
        borderWidth: "2"
        font: "$list_large_font"
        foregroundColor: "md_on_surface"
        halign: "right"
        position: "1395,5"
        render: "Label"
        size: "175,50"
        source: "session.CurrentService"
        valign: "center"
        zPosition: "4"
        children:
          - convert:
              type: "ServicePosition"
              text: "Remaining,Plus,ShowHours"
