# The channel selection as a carousel (needs the python list of the plugin, python_servicelist, see PyServiceList.py):
# the genres above the services: "All" and the markers of the bouquet (PyGenreBar), a row of chips (not a carousel: a carousel keeps the selected one in its first
# slot and scrolls the ones before it out of view, "All" would be gone) that stays where it is, "All" first, and scrolls an item at a time when there are more
# genres than fit. The selected one is the genre that the services show: the services of its section only, all of them for "All". The keys for the next and the previous marker
# move in it (it has no focus: left and right move in the services). The background of a selected cell is the one of the body, so that only the chip is seen, with its own rounded corners.
- widget:
    backgroundColor: "md_surface"
    backgroundColorSelected: "md_surface"
    enableWrapAround: "0"
    itemCornerRadius: "$radius_item"
    listOrientation: "horizontal"
    name: "genrelist"
    position: "42,30"
    scrollType: "item"
    scrollbarMode: "showNever"
    size: "1800,40"
    template: |
          {
              'fonts': [parseFont('md_label_medium')],
              'itemHeight': 40,
              'itemWidth': 150,
              'template': [
                  MultiContentEntryRectangle(pos = (3, 3), size = (144, 34), backgroundColor = 'md_surface_container_high', backgroundColorSelected = 'md_inverse_surface', cornerRadius = 17),
                  MultiContentEntryText(pos = (10, 3), size = (130, 34), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER, text = ROW_DIRECTORY_NAME, color = 'md_on_surface', color_sel = 'md_inverse_on_surface'),
              ]
          }
- widget:
    backgroundColor: "md_surface"
    backgroundColorSelected: "md_surface"
    backgroundColorMarked: "md_surface_container_low"
    backgroundColorMarkedSelected: "md_success"
    colorEventProgressbar: "md_on_surface_variant"
    colorEventProgressbarBorder: "md_outline"
    colorEventProgressbarBorderSelected: "md_inverse_primary"
    colorEventProgressbarSelected: "md_inverse_primary"
    colorServiceDescription: "md_on_surface"
    colorServiceDescriptionSelected: "md_inverse_on_surface"
    enableWrapAround: "1"
    foregroundColorEventRemaining: "md_secondary"
    foregroundColorEventRemainingSelected: "md_inverse_primary"
    foregroundColorMarkedSelected: "md_inverse_on_surface"
    foregroundColorServiceNotAvail: "md_outline"
    itemCornerRadius: "$radius_item"
    listOrientation: "horizontal"
    carousel: "1"
    carouselZoom: "130"
    name: "list"
    position: "30,245"
    scrollbarMode: "showNever"
    size: "1800,230"
    template: |
          {
              'fonts': [parseFont('md_label_large'), parseFont('md_label_medium'), parseFont('md_label_medium'), parseFont('md_label_small_emphasized')],
              'itemHeight': 230,
              'itemWidth': 200,
              'template': [
                  MultiContentEntryRectangle(pos = (15, 30), size = (170, 170), backgroundColor = 'md_surface_container', backgroundColorSelected = 'md_inverse_surface', cornerRadius = $radius_item),
                  MultiContentEntryRectangle(pos = (15, 30), size = (170, 170), backgroundColor = COLOR_BG, backgroundColorSelected = COLOR_BG_SELECTED, cornerRadius = $radius_item),
                  MultiContentEntryPixmapAlphaBlend(pos = (23, 46), size = (154, 56), flags = BT_SCALE|BT_KEEP_ASPECT_RATIO|BT_HALIGN_CENTER|BT_VALIGN_CENTER, png = ROW_PICON),
                  MultiContentEntryText(pos = (23, 108), size = (154, 26), font = 2, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = ROW_NAME, color = COLOR_FG, color_sel = COLOR_FG_SELECTED),
                  MultiContentEntryText(pos = (23, 138), size = (154, 24), font = 2, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = ROW_EVENT, color = COLOR_EVENT_FG, color_sel = COLOR_EVENT_FG_SELECTED),
                  MultiContentEntryProgress(pos = (23, 166), size = (154, 6), percent = PERCENT_PROGRESS, borderWidth = 1, foreColor = 'md_on_surface_variant', foreColorSelected = 'md_inverse_primary'),
                  MultiContentEntryText(pos = (23, 174), size = (154, 22), font = 1, flags = RT_HALIGN_LEFT|RT_VALIGN_CENTER, text = ROW_NEXT_EVENT, color = COLOR_REMAINING_FG, color_sel = COLOR_REMAINING_FG_SELECTED),
                  MultiContentEntryText(pos = (23, 30), size = (154, 170), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER|RT_WRAP, text = ROW_DIRECTORY_NAME, color = COLOR_FG, color_sel = COLOR_FG_SELECTED),
                  MultiContentEntryText(pos = (23, 30), size = (154, 170), font = 0, flags = RT_HALIGN_CENTER|RT_VALIGN_CENTER|RT_WRAP, text = ROW_MARKER_NAME, color = 'md_primary', color_sel = 'md_inverse_primary'),
              ]
          }
# the chevrons left and right of the services (in the 30 px beside the list, centred on the tiles: the list is at y 245 and 230 high, the centre is y 360: the middle between the genre list, which ends at y 70, and the selected event, which begins at y 649)
- eLabel:
    backgroundColor: "md_surface"
    font: "md_display_medium_emphasized"
    foregroundColor: "md_on_surface_variant"
    halign: "center"
    position: "0,310"
    size: "30,100"
    text: "‹"
    transparent: "1"
    valign: "center"
- eLabel:
    backgroundColor: "md_surface"
    font: "md_display_medium_emphasized"
    foregroundColor: "md_on_surface_variant"
    halign: "center"
    position: "1830,310"
    size: "30,100"
    text: "›"
    transparent: "1"
    valign: "center"
# The genres, the tiles and the event begin at x 45: the first tile is 15 into its cell (the list is at 30), a genre chip is 3 into its cell (the list is at 42)
# and the text of the event is at 43, the first letter has about 2 px of space before it.
# The title ends before the time (x 1400), the description ends where the time does (1852 = 1860 - 8): the body is $width wide.
# the description is a Label (wrapped, from the top of its box): the COCRunningText of it was drawn at the bottom of the screen, about 200 px under its box
# the selected service: event, time and description, at the bottom of the body (909 high): 649 + 43 + 7 + 200 = 899, 10 above its edge
- widget:
    backgroundColor: "md_surface"
    font: "md_title_large"
    foregroundColor: "md_primary"
    halign: "left"
    noWrap: "1"
    position: "43,649"
    render: "Label"
    size: "1347,43"
    source: "ServiceEvent"
    transparent: "1"
    children:
      - convert:
          type: "EventName"
          text: "Name"
- widget:
    backgroundColor: "md_surface"
    font: "md_title_medium_emphasized"
    halign: "right"
    position: "1380,649"
    render: "Label"
    size: "450,43"
    source: "ServiceEvent"
    transparent: "1"
    valign: "center"
    children:
      - convert:
          type: "EventName"
          text: "•,TIMERANGE"
- widget:
    backgroundColor: "md_surface"
    font: "md_body_medium"
    halign: "left"
    position: "43,699"
    render: "Label"
    size: "$width-51,200"
    source: "ServiceEvent"
    transparent: "1"
    valign: "top"
    children:
      - convert:
          type: "EventName"
          text: "FullDescription"
