screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "RemoteTimerBouquetList"
  position: "fill"
  children:
    - widget:
        halign: "center"
        name: "text"
        origin: "screen"
        position: "779,101"
        size: "1110,912"
        valign: "center"
        zPosition: "1"
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_small_width,$window_small_height"
        window_inset_x: "$window_small_body_x"
    - xmlinc:
        file: "screenpart_RemoteTimerBouquetListBody.ymlinc"
        position: "$window_small_body_x,$window_small_body_y"
        size: "$window_small_body_width,$window_small_body_height"
