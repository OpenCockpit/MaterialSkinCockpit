screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "SHOUTcastSetup"
  position: "fill"
  title: "SHOUTcast Setup"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        font: "md_body_small"
        itemCornerRadius: "$radius_item"
        itemHeight: "37"
        name: "config"
        position: "20,94"
        scrollbarMode: "showOnDemand"
        size: "$window_small_content_width,592"
        transparent: "1"
