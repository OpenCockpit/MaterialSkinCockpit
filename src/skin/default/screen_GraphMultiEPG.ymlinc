screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "GraphMultiEPG"
  position: "fill"
  title: "Electronic Program Guide"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - xmlinc:
        file: "screenpart_Pig.ymlinc"
        position: "1450,95"
        size: "435,248"
    - widget:
        alphatest: "blend"
        name: "timeline_now"
        pixmap: "window/timeline-now.png"
        position: "0,404"
        scale: "1"
        size: "28,516"
        zPosition: "2"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_panel"
        position: "20,368"
        size: "1866,607"
        widgetBorderColor: "md_outline_variant"
        widgetBorderWidth: "1"
        zPosition: "-2"
    - widget:
        backgroundColor: "md_surface"
        borderColor: "md_outline_variant"
        borderWidth: "1"
        foregroundColor: "md_on_surface"
        fullBorder: "0"
        name: "timeline_text"
        position: "22,370"
        size: "1862,31"
        zPosition: "2"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "20,403"
        size: "1866,1"
        zPosition: "10"
    - widget:
        EntryActiveBackgroundColor: "md_error_container"
        EntryActiveBackgroundColorSelected: "md_primary_container"
        EntryBackgroundColor: "md_surface"
        EntryBackgroundColorNow: "md_surface_container"
        EntryBackgroundColorNowSelected: "md_primary_container"
        EntryBackgroundColorSelected: "md_primary_container"
        EntryBorderColor: "md_outline_variant"
        EntryFont: "md_body_medium"
        EntryForegroundColor: "md_on_surface"
        EventBorderWidth: "1"
        EventNamePadding: "6"
        EventTextSidesMargin: "10"
        IconXPadding: "6"
        IconYPadding: "4"
        RecIconSize: "32"
        RecordBackgroundColor: "md_error_container"
        RecordBackgroundColorSelected: "md_error_container"
        ServiceBackgroundColor: "md_surface"
        ServiceBorderColor: "md_outline_variant"
        ServiceBorderWidth: "1"
        ServiceFont: "md_body_medium"
        ServiceForegroundColorNow: "md_primary"
        ServiceNameBackgroundColor: "md_surface"
        ServiceNameBackgroundColorSelected: "md_success_container"
        ServiceNameForegroundColor: "md_on_surface"
        ServiceNamePadding: "6"
        ZapBackgroundColor: "md_warning_container"
        ZapBackgroundColorSelected: "md_warning_container"
        backgroundColor: "md_surface"
        enableWrapAround: "1"
        itemHeight: "64"
        name: "list"
        position: "20,403"
        scrollbarMode: "showNever"
        scrollbarSliderBorderColor: "md_surface_container_lowest"
        scrollbarSliderBorderWidth: "0"
        scrollbarSliderForegroundColor: "md_on_surface_variant"
        scrollbarWidth: "3"
        size: "1865,518"
    - eLabel:
        backgroundColor: "md_outline_variant"
        position: "20,920"
        size: "1866,1"
        zPosition: "10"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        conditional: "list"
        connection: "list"
        maxPages: "20"
        position: "20,935"
        size: "1865,25"
        transparent: "1"
    - ePixmap:
        alphatest: "blend"
        pixmap: "icons/clock_22.png"
        position: "1055,107"
        size: "22,22"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_small"
        halign: "left"
        position: "1095,100"
        render: "Label"
        size: "310,34"
        source: "Event"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              nostrip: "1"
              type: "EventName"
              text: "  •  ,TIMERANGE,DURATION"
    - widget:
        alphatest: "blend"
        borderColor: "md_shadow"
        borderWidth: "1"
        cornerRadius: "$radius_rating"
        font: "md_title_small_emphasized"
        halign: "center"
        position: "33,931"
        render: "RatingIconLabel"
        size: "32,32"
        source: "Event"
        valign: "center"
        widgetBorderColor: "md_outline_variant"
        widgetBorderWidth: "1"
        zPosition: "1"
        children:
          - convert:
              type: "EventName"
              text: "RatingTextAndColor"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_small_emphasized"
        foregroundColor: "md_tertiary"
        halign: "right"
        position: "1365,930"
        render: "Label"
        size: "500,34"
        source: "Event"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "EventName"
              text: "Genre"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        foregroundColor: "md_primary"
        halign: "left"
        position: "25,90"
        render: "Label"
        size: "790,47"
        source: "Event"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - widget:
        backgroundColor: "md_surface"
        font: "md_body_large"
        options: "movetype=swimming,direction=top,startdelay=4000,pause=3000,steptime=50,pagelength=0,wrap,repeat=1"
        position: "25,158"
        render: "COCRunningText"
        size: "1385,175"
        source: "Event"
        transparent: "1"
        valign: "top"
        children:
          - convert:
              type: "EventName"
              text: "FullDescription"
