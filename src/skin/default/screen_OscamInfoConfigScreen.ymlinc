screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "OscamInfoConfigScreen"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_ConfigScreenTemplate.ymlinc"
        position: "0,0"
    - widget:
        font: "md_title_large"
        halign: "center"
        name: "status"
        position: "$window_large_margin,808"
        render: "Label"
        size: "$window_large_inner_width,43"
        valign: "center"
        zPosition: "20"
