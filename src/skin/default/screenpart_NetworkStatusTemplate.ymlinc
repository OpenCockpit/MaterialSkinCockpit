screen:
  name: "NetworkStatusTemplate"
  children:
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        halign: "left"
        position: "0,0"
        render: "Label"
        size: "180,36"
        source: "IFtext"
        transparent: "1"
        zPosition: "10"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        halign: "left"
        position: "180,0"
        render: "Label"
        size: "750,36"
        source: "IF"
        transparent: "1"
        zPosition: "10"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        halign: "left"
        position: "0,57"
        render: "Label"
        size: "180,36"
        source: "Statustext"
        transparent: "1"
        zPosition: "10"
    - widget:
        alphatest: "on"
        name: "statuspic"
        pixmaps: "icons/lock_on.png,icons/lock_off.png"
        position: "180,54"
        scale: "1"
        size: "37,36"
        transparent: "1"
        zPosition: "10"
