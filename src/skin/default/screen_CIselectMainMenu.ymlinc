screen:
  backgroundColor: "md_transparent"
  name: "CIselectMainMenu"
  position: "fill"
  title: "CI assignment"
  children:
    - xmlinc:
        file: "screenpart_Window_Small.ymlinc"
        position: "center"
    - widget:
        font: "md_title_large"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "CiList"
        position: "21,86"
        scrollbarMode: "showOnDemand"
        size: "$window_small_content_width,630"
