screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "AutoBouquetsMaker_Menu"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Screen_Menu1.ymlinc"
        position: "370,118"
    - widget:
        position: "396,210"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1130,11*60"
        source: "list"
        transparent: "0"
        children:
          - convert:
              type: "TemplatedMultiContent"
              text: |
                		{
                			"template": [
                				MultiContentEntryPixmapAlphaTest(pos = (18, 12), size = (48, 48), png = 0),
                				MultiContentEntryText(pos = (87, 11), size = (1060, 49), font=0, flags = RT_HALIGN_LEFT|RT_VALIGN_TOP, text = 1),
                			],
                			"fonts": [gFont("Regular", $list_font_size)],
                			"itemHeight": 60
                		}
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "list"
        position: "396,849"
        size: "1130,25"
        transparent: "1"
