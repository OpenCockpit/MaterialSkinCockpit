# The frame of a screen of the large size and its body: a screenfamily of screen_* files hands the body in as content=, the name
# of the part (without extension) that is placed in the body rectangle of the frame. A screen of its own, like
# screenpart_ConfigScreen: what the body places is relative to the frame it follows.
screen:
  name: "ScreenLarge"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_large_width,$window_large_height"
        window_inset_x: "$window_large_body_x"
    - xmlinc:
        file: "$content"
        position: "$window_large_body_x,$window_large_body_y"
        size: "$window_large_body_width,$window_large_body_height"
