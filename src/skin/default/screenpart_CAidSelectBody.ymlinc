- widget:
    font: "md_body_medium"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "list"
    position: "0,0"
    size: "$width,13*$list_item_height"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
- xmlinc:
    file: "screenpart_InfoStrip.ymlinc"
    position: "0,$height-65"
    size: "$width,40"
    strip_font: "md_body_medium"
    strip_source: "introduction"
