- widget:
    font: "md_title_large"
    itemCornerRadius: "$radius_item"
    itemHeight: "$list_item_height"
    name: "list"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "$width,13*$list_item_height"
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,$height-25"
    size: "$width,25"
    connection: "list"
- widget:
    backgroundColor: "md_surface"
    font: "md_label_medium"
    foregroundColor: "md_primary"
    halign: "center"
    position: "0,$height-65"
    render: "Label"
    size: "$width,40"
    source: "introduction"
    valign: "center"
    zPosition: "10"
