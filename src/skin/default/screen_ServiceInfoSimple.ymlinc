screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "ServiceInfoSimple"
  position: "fill"
  children:
    - xmlinc:
        file: "screenpart_Window_Large.ymlinc"
        position: "center"
    - widget:
        font: "md_body_medium"
        itemHeight: "38"
        name: "infolist"
        position: "$window_large_content_x,$window_large_content_y"
        scrollbarMode: "showOnDemand"
        selectionDisabled: "1"
        size: "1696,741"
    - widget:
        addon: "Pager"
        backgroundColor: "md_surface"
        connection: "infolist"
        position: "29,846"
        size: "1696,25"
        transparent: "1"
