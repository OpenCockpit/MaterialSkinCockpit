screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "CatchupPlayer"
  position: "fill"
  children:
    - eLabel:
        backgroundColor: "md_surface_container_high"
        cornerRadius: "$radius_window"
        position: "38,862"
        size: "1839,184"
        zPosition: "-11"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_window_inner"
        position: "370,864"
        size: "1505,180"
        zPosition: "-10"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "380,915"
        size: "1485,2"
        zPosition: "-9"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "1630,930"
        size: "2,100"
        zPosition: "-9"
    - widget:
        alphatest: "blend"
        name: "statusicon"
        pixmaps: "icons/pvr/play.svg,icons/pvr/pause.svg,icons/pvr/stop.svg,icons/pvr/ff.svg,icons/pvr/rew.svg,icons/pvr/slow.svg"
        position: "160,915"
        size: "90,90"
        zPosition: "3"
    - widget:
        font: "md_headline_large_emphasized"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "speed"
        position: "260,960"
        size: "90,45"
        transparent: "1"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_medium"
        noWrap: "1"
        position: "400,935"
        render: "Label"
        size: "1120,50"
        source: "session.CurrentService"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "ServiceName"
              text: "Name"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_small_emphasized"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "time_info"
        position: "405,864"
        size: "440,51"
        transparent: "1"
        valign: "center"
    - eLabel:
        backgroundColor: "md_surface_container"
        position: "400,1010"
        size: "1170,4"
        transparent: "0"
        zPosition: "1"
    - widget:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_bar_thick"
        foregroundColor: "md_on_surface_variant"
        position: "400,1005"
        render: "Progress"
        size: "1170,12"
        source: "progress"
        transparent: "1"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface"
        font: "md_display_medium_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1590,925"
        render: "Label"
        size: "320,60"
        source: "global.CurrentTime"
        transparent: "1"
        valign: "top"
        zPosition: "20"
        children:
          - convert:
              type: "ClockToText"
              text: "Default"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1590,990"
        render: "Label"
        size: "320,35"
        source: "global.CurrentTime"
        transparent: "1"
        valign: "top"
        zPosition: "20"
        children:
          - convert:
              type: "ClockToText"
              text: "Format: %d %B"
    - widget:
        alphatest: "blend"
        path: "icons/audioicon"
        position: "1605,860"
        render: "AudioIcon"
        size: "85,50"
        source: "session.CurrentService"
        zPosition: "10"
        children:
          - convert:
              type: "VAudioInfo"
              text: "AudioIcon"
    - widget:
        alphatest: "blend"
        pixmap: "icons/videoicon/mpeg2.png"
        position: "1700,869"
        render: "Pixmap"
        size: "80,40"
        source: "session.CurrentService"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "IsVideoMPEG2"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        pixmap: "icons/videoicon/h264.png"
        position: "1700,869"
        render: "Pixmap"
        size: "80,40"
        source: "session.CurrentService"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "IsVideoAVC"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        pixmap: "icons/videoicon/h265.png"
        position: "1700,869"
        render: "Pixmap"
        size: "80,40"
        source: "session.CurrentService"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "IsVideoHEVC"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        pixmap: "icons/videoicon/480.png"
        position: "1780,869"
        render: "Pixmap"
        size: "80,40"
        source: "session.CurrentService"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "Is480"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        pixmap: "icons/videoicon/576.png"
        position: "1780,869"
        render: "Pixmap"
        size: "80,40"
        source: "session.CurrentService"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "Is576"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        pixmap: "icons/videoicon/720.png"
        position: "1780,869"
        render: "Pixmap"
        size: "80,40"
        source: "session.CurrentService"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "Is720"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        pixmap: "icons/videoicon/1080.png"
        position: "1780,869"
        render: "Pixmap"
        size: "80,40"
        source: "session.CurrentService"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "Is1080"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        pixmap: "icons/videoicon/4k.png"
        position: "1780,869"
        render: "Pixmap"
        size: "80,40"
        source: "session.CurrentService"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "Is4K"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        pixmap: "icons/rec2.png"
        position: "1290,880"
        render: "Pixmap"
        size: "49,22"
        source: "session.RecordState"
        zPosition: "2"
        children:
          - convert:
              type: "ConditionalShowHide"
              text: "Blink,4000,1000"
