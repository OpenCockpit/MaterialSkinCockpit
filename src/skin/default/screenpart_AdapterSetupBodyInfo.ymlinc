# The current settings of the adapter (IP address, net mask, gateway, adapter and the DNS servers) and the instruction.
# Settings title
- widget:
    font: "md_title_medium"
    foregroundColor: "md_primary"
    halign: "center"
    position: "0,5"
    render: "Label"
    size: "$width,36"
    source: "introduction"

# The settings (IP address, net mask, gateway, adapter and the DNS servers) are 1150 wide: centered in the body
# IP address
- widget:
    font: "md_body_medium"
    foregroundColor: "md_on_surface_variant"
    halign: "left"
    position: "($width-1150)/2,55"
    render: "Label"
    size: "225,36"
    source: "IPtext"
    valign: "center"
    zPosition: "1"

# IP address value
- widget:
    font: "md_body_medium"
    position: "($width-1150)/2+237,55"
    render: "Label"
    size: "300,36"
    source: "IP"
    valign: "center"
    zPosition: "1"

# Net mask
- widget:
    font: "md_body_medium"
    foregroundColor: "md_on_surface_variant"
    halign: "left"
    position: "($width-1150)/2,91"
    render: "Label"
    size: "225,36"
    source: "Netmasktext"
    valign: "center"
    zPosition: "1"

# Net mask value
- widget:
    font: "md_body_medium"
    position: "($width-1150)/2+237,91"
    render: "Label"
    size: "300,36"
    source: "Mask"
    valign: "center"
    zPosition: "1"

# Gateway
- widget:
    font: "md_body_medium"
    foregroundColor: "md_on_surface_variant"
    halign: "left"
    position: "($width-1150)/2,127"
    render: "Label"
    size: "225,36"
    source: "Gatewaytext"
    valign: "center"
    zPosition: "1"

# Gateway value
- widget:
    font: "md_body_medium"
    position: "($width-1150)/2+237,127"
    render: "Label"
    size: "300,36"
    source: "Gateway"
    valign: "center"
    zPosition: "1"

# Adapter
- widget:
    font: "md_body_medium"
    foregroundColor: "md_on_surface_variant"
    halign: "left"
    position: "($width-1150)/2,163"
    render: "Label"
    size: "225,36"
    source: "Adaptertext"
    transparent: "1"
    zPosition: "10"

# Adapter value
- widget:
    font: "md_body_medium"
    halign: "left"
    position: "($width-1150)/2+237,163"
    render: "Label"
    size: "600,36"
    source: "Adapter"
    transparent: "1"
    zPosition: "10"

# DNS1
- widget:
    font: "md_body_medium"
    foregroundColor: "md_on_surface_variant"
    halign: "left"
    position: "($width-1150)/2+613,55"
    render: "Label"
    size: "225,36"
    source: "DNS1text"
    transparent: "1"
    valign: "center"
    zPosition: "1"

# DNS1 value
- widget:
    font: "md_body_medium"
    halign: "left"
    position: "($width-1150)/2+850,55"
    render: "Label"
    size: "300,36"
    source: "DNS1"
    transparent: "1"
    valign: "center"
    zPosition: "1"

# DNS2
- widget:
    font: "md_body_medium"
    foregroundColor: "md_on_surface_variant"
    halign: "left"
    position: "($width-1150)/2+613,91"
    render: "Label"
    size: "225,36"
    source: "DNS2text"
    transparent: "1"
    valign: "center"
    zPosition: "1"

# DNS2 value
- widget:
    font: "md_body_medium"
    halign: "left"
    position: "($width-1150)/2+850,91"
    render: "Label"
    size: "300,36"
    source: "DNS2"
    transparent: "1"
    valign: "center"
    zPosition: "1"

# Instruction
- widget:
    font: "md_body_large"
    foregroundColor: "md_primary"
    halign: "center"
    position: "0,$height-40"
    render: "Label"
    size: "$width,40"
    source: "introduction2"
    transparent: "1"
    valign: "center"
    zPosition: "10"
