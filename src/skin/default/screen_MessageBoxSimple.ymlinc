screen:
  backgroundColor: "md_transparent"
  flags: "wfNoBorder"
  name: "MessageBoxSimple"
  position: "$screen_center-480,$screen_center-8"
  size: "960,15"
  title: "Message"
  zPosition: "10"
  children:
    - widget:
        backgroundColor: "md_surface_container_high"
        font: "md_title_small_emphasized"
        foregroundColor: "md_primary"
        halign: "left"
        position: "15,3"
        render: "Label"
        size: "250,40"
        source: "Title"
        valign: "center"
        zPosition: "2"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_large"
        name: "text"
        position: "100,12"
        size: "780,0"
    - widget:
        alphatest: "blend"
        conditional: "icon"
        name: "icon"
        pixmaps: "icons/input_question.png,icons/input_info.png,icons/input_warning.png,icons/input_error.png,icons/input_message.png"
        position: "10,10"
        size: "80,80"
    - widget:
        alphatest: "blend"
        conditional: "ErrorPixmap"
        name: "ErrorPixmap"
        pixmap: "icons/input_error.png"
        position: "10,10"
        size: "80,80"
    - widget:
        alphatest: "blend"
        conditional: "QuestionPixmap"
        name: "QuestionPixmap"
        pixmap: "icons/input_question.png"
        position: "10,10"
        size: "80,80"
    - widget:
        alphatest: "blend"
        conditional: "InfoPixmap"
        name: "InfoPixmap"
        pixmap: "icons/input_info.png"
        position: "10,10"
        size: "80,80"
    - widget:
        alphatest: "blend"
        conditional: "WarningPixmap"
        name: "WarningPixmap"
        pixmap: "icons/input_warning.png"
        position: "10,10"
        size: "80,80"
    - widget:
        backgroundColor: "md_transparent"
        font: "md_body_medium"
        itemCornerRadius: "$radius_item"
        itemHeight: "45"
        name: "list"
        position: "150,150"
        size: "720,570"
        textOffset: "20, 2"
        transparent: "1"
        zPosition: "2"
    - widget:
        conditional: "autoresize"
        font: "md_body_medium"
        name: "autoresize"
        noWrap: "1"
        position: "0,0"
        size: "0,0"
    - applet:
        type: "onLayoutFinish"
        text: |
          from enigma import ePoint, eSize, getDesktop, gRGB, BT_ALPHABLEND
          from Components.Label import Label
          from Components.Pixmap import Pixmap
          from Tools.Directories import resolveFilename, SCOPE_CURRENT_SKIN
          from Tools.LoadPixmap import LoadPixmap
          from skin import parseRadius, parseColor
          if self.timerRunning:
              titleheight = 0
          else:
              titleheight = 0

          orgwidth = self.instance.size().width()
          orgheight = self.instance.size().height()
          orgpos = self.instance.position()
          textsize = self["text"].getSize()
          textsize = (textsize[0] + 76, textsize[1])
          wsizex = textsize[0] + 140
          if (75 + textsize[1]) > 180:
              wsizey = textsize[1] + 80 + 84
          else:
              wsizey = 180 + 96
          lenlist = len(self.list)*45
          if (lenlist > 380):
              lenlist = 380
          if (180 > wsizey):
              wsizey = 180

          wsizey += lenlist + 25

          if (420 > wsizex):
              wsizex = 420
          listwidth = self.getListWidth() + 20
          if (listwidth > 1280):
              listwidth = 1280
          if (listwidth > wsizex):
              wsizex = listwidth
          wsize = (wsizex, wsizey + titleheight)
          self.instance.resize(eSize(*wsize))
          self["text"].instance.move(ePoint(130, 75 + titleheight))
          self["text"].instance.resize(eSize(*textsize))
          if "ErrorPixmap" in self:
              self["ErrorPixmap"].instance.move(ePoint(30, 80 + titleheight))
              self["ErrorPixmap"].instance.resize(eSize(80,80))
          if "WarningPixmap" in self:
              self["WarningPixmap"].instance.move(ePoint(30, 80 + titleheight))
              self["WarningPixmap"].instance.resize(eSize(80,80))
          if "QuestionPixmap" in self:
              self["QuestionPixmap"].instance.move(ePoint(30, 80 + titleheight))
              self["QuestionPixmap"].instance.resize(eSize(80,80))
          if "InfoPixmap" in self:
              self["InfoPixmap"].instance.move(ePoint(30, 80 + titleheight))
              self["InfoPixmap"].instance.resize(eSize(80,80))
          if "icon" in self:
              self["icon"].instance.move(ePoint(30, 80 + titleheight))
              self["icon"].instance.resize(eSize(80,80))
          if self.type == self.TYPE_YESNO:
              listsize = (wsizex-20, lenlist)
              self["list"].instance.move(ePoint(10, wsizey - lenlist + titleheight - 94 - 3))
              self["list"].instance.resize(eSize(*listsize))
          newwidth = wsize[0]
          self.instance.move(ePoint(orgpos.x() + (orgwidth - newwidth) // 2, orgpos.y() + (orgheight - wsizey) // 2))

          radiusBLayer, edgeValueBLayer = parseRadius("$radius_window")
          radiusTLayer, edgeValueTLayer = parseRadius("$radius_window_inner")

          self["blayer"] = Label()
          self["blayer"].GUIcreate(self.instance)
          self["blayer"].instance.setCornerRadius(radiusBLayer, edgeValueBLayer)
          self["blayer"].instance.resize(eSize(wsizex,wsizey-20))
          self["blayer"].instance.setBackgroundColor(parseColor("md_surface_container_high"))
          self["blayer"].instance.move(ePoint(0,0))
          self["blayer"].setZPosition(-7)
          self["tlayer"] = Label()
          self["tlayer"].GUIcreate(self.instance)
          self["tlayer"].instance.setCornerRadius(radiusTLayer, edgeValueTLayer)
          self["tlayer"].instance.resize(eSize(wsizex-4,wsizey-20-64-45))
          self["tlayer"].instance.setBackgroundColor(parseColor("md_surface"))
          self["tlayer"].instance.move(ePoint(2,47))
          self["tlayer"].setZPosition(-6)
