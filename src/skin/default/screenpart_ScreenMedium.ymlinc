# The frame of a screen of the medium size and its body: a screenfamily of screen_* files hands the body in as content=, the name
# of the part (without extension) that is placed in the body rectangle of the frame. A screen of its own, like
# screenpart_ConfigScreen: what the body places is relative to the frame it follows.
screen:
  name: "ScreenMedium"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_medium_width,$window_medium_height"
        window_inset_x: "$window_medium_body_x"
    - xmlinc:
        file: "$content"
        position: "$window_medium_body_x,$window_medium_body_y"
        size: "$window_medium_body_width,$window_medium_body_height"
